\id PSA Psalterium Breviarii Romani
\usfm 3.1
\ide UTF-8
\h Psalterium Breviarii Romani
\toc2 Psalterium Breviarii Romani
\mt1 Psalterium Breviarii Romani
\c 1
\q1 \v 1 Beátus vir, qui non ábiit in consílio impiórum, † et in via peccatórum non stetit, * et in cáthedra pestiléntiæ non sedit:
\q1 \v 2 Sed in lege Dómini volúntas ejus, * et in lege ejus meditábitur die ac nocte.
\q1 \v 3 Et erit tamquam lignum, quod plantátum est secus decúrsus aquárum, * quod fructum suum dabit in témpore suo:
\q1 Et fólium ejus non défluet: * et ómnia quæcúmque fáciet, prosperabúntur.
\q1 \v 4 Non sic ímpii, non sic: * sed tamquam pulvis, quem próicit ventus a fácie terræ.
\q1 \v 5 Ídeo non resúrgent ímpii in judício: * neque peccatóres in concílio justórum.
\q1 \v 6 Quóniam novit Dóminus viam justórum: * et iter impiórum períbit.
\c 2
\q1 \v 1 Quare fremuérunt gentes: * et pópuli meditáti sunt inánia?
\q1 \v 2 Astitérunt reges terræ, et príncipes convenérunt in unum * advérsus Dóminum, et advérsus Christum ejus.
\q1 \v 3 Dirumpámus víncula eórum: * et proiciámus a nobis jugum ipsórum.
\q1 \v 4 Qui hábitat in cælis, irridébit eos: * et Dóminus subsannábit eos.
\q1 \v 5 Tunc loquétur ad eos in ira sua, * et in furóre suo conturbábit eos.
\q1 \v 6 Ego autem constitútus sum Rex ab eo super Sion montem sanctum ejus, * prǽdicans præcéptum ejus.
\q1 \v 7 Dóminus dixit ad me: * Fílius meus es tu, ego hódie génui te.
\q1 \v 8 Póstula a me, et dabo tibi gentes hereditátem tuam, * et possessiónem tuam términos terræ.
\q1 \v 9 Reges eos in virga férrea, * et tamquam vas fíguli confrínges eos.
\q1 \v 10 Et nunc, reges, intellégite: * erudímini, qui judicátis terram.
\q1 \v 11 Servíte Dómino in timóre: * et exsultáte ei cum tremóre.
\q1 \v 12 Apprehéndite disciplínam, nequándo irascátur Dóminus, * et pereátis de via justa.
\q1 \v 13 Cum exárserit in brevi ira ejus: * beáti omnes qui confídunt in eo.
\c 3
\q1 \v 2 Dómine, quid multiplicáti sunt qui tríbulant me? * multi insúrgunt advérsum me.
\q1 \v 3 Multi dicunt ánimæ meæ: * Non est salus ipsi in Deo ejus.
\q1 \v 4 Tu autem, Dómine, suscéptor meus es, * glória mea, et exáltans caput meum.
\q1 \v 5 Voce mea ad Dóminum clamávi: * et exaudívit me de monte sancto suo.
\q1 \v 6 Ego dormívi, et soporátus sum: * et exsurréxi, quia Dóminus suscépit me.
\q1 \v 7 Non timébo míllia pópuli circumdántis me: * exsúrge, Dómine, salvum me fac, Deus meus.
\q1 \v 8 Quóniam tu percussísti omnes adversántes mihi sine causa: * dentes peccatórum contrivísti.
\q1 \v 9 Dómini est salus: * et super pópulum tuum benedíctio tua.
\c 4
\q1 \v 2 Cum invocárem exaudívit me Deus justítiæ meæ: * in tribulatióne dilatásti mihi.
\q1 Miserére mei, * et exáudi oratiónem meam.
\q1 \v 3 Fílii hóminum, úsquequo gravi corde? * ut quid dilígitis vanitátem, et quǽritis mendácium?
\q1 \v 4 Et scitóte quóniam mirificávit Dóminus sanctum suum: * Dóminus exáudiet me cum clamávero ad eum.
\q1 \v 5 Irascímini, et nolíte peccáre: ‡ quæ dícitis in córdibus vestris, * in cubílibus vestris compungímini.
\q1 \v 6 Sacrificáte sacrifícium justítiæ, † et speráte in Dómino. * Multi dicunt: Quis osténdit nobis bona?
\q1 \v 7 Signátum est super nos lumen vultus tui, Dómine: * dedísti lætítiam in corde meo.
\q1 \v 8 A fructu fruménti, vini, et ólei sui * multiplicáti sunt.
\q1 \v 9 In pace in idípsum * dórmiam, et requiéscam;
\q1 \v 10 Quóniam tu, Dómine, singuláriter in spe * constituísti me.
\c 5
\q1 \v 2 Verba mea áuribus pércipe, Dómine, * intéllege clamórem meum.
\q1 \v 3 Inténde voci oratiónis meæ, * Rex meus et Deus meus.
\q1 \v 4 Quóniam ad te orábo: * Dómine, mane exáudies vocem meam.
\q1 \v 5 Mane astábo tibi et vidébo: * quóniam non Deus volens iniquitátem tu es.
\q1 \v 6 Neque habitábit juxta te malígnus: * neque permanébunt injústi ante óculos tuos.
\q1 \v 7 Odísti omnes, qui operántur iniquitátem: * perdes omnes, qui loquúntur mendácium.
\q1 Virum sánguinum et dolósum abominábitur Dóminus: * (8a) ego autem in multitúdine misericórdiæ tuæ.
\q1 \v 8 Introíbo in domum tuam: * adorábo ad templum sanctum tuum in timóre tuo.
\q1 \v 9 Dómine, deduc me in justítia tua: * propter inimícos meos dírige in conspéctu tuo viam meam.
\q1 \v 10 Quóniam non est in ore eórum véritas: * cor eórum vanum est.
\q1 \v 11 Sepúlcrum patens est guttur eórum, † linguis suis dolóse agébant, * júdica illos, Deus.
\q1 Décidant a cogitatiónibus suis, † secúndum multitúdinem impietátum eórum expélle eos, * quóniam irritavérunt te, Dómine.
\q1 \v 12 Et læténtur omnes, qui sperant in te, * in ætérnum exsultábunt: et habitábis in eis.
\q1 Et gloriabúntur in te omnes, qui díligunt nomen tuum, * (13a) quóniam tu benedíces justo.
\q1 \v 13 Dómine, ut scuto bonæ voluntátis tuæ * coronásti nos.
\c 6
\q1 \v 2 Dómine, ne in furóre tuo árguas me, * neque in ira tua corrípias me.
\q1 \v 3 Miserére mei, Dómine, quóniam infírmus sum: * sana me, Dómine, quóniam conturbáta sunt ossa mea.
\q1 \v 4 Et ánima mea turbáta est valde: * sed tu, Dómine, úsquequo?
\q1 \v 5 Convértere, Dómine, et éripe ánimam meam: * salvum me fac propter misericórdiam tuam.
\q1 \v 6 Quóniam non est in morte qui memor sit tui: * in inférno autem quis confitébitur tibi?
\q1 \v 7 Laborávi in gémitu meo, † lavábo per síngulas noctes lectum meum: * lácrimis meis stratum meum rigábo.
\q1 \v 8 Turbátus est a furóre óculus meus: * inveterávi inter omnes inimícos meos.
\q1 \v 9 Discédite a me, omnes, qui operámini iniquitátem: * quóniam exaudívit Dóminus vocem fletus mei.
\q1 \v 10 Exaudívit Dóminus deprecatiónem meam, * Dóminus oratiónem meam suscépit.
\q1 \v 11 Erubéscant, et conturbéntur veheménter omnes inimíci mei: * convertántur et erubéscant valde velóciter.
\c 7
\q1 \v 2 Dómine, Deus meus, in te sperávi: * salvum me fac ex ómnibus persequéntibus me, et líbera me.
\q1 \v 3 Nequándo rápiat ut leo ánimam meam, * dum non est qui rédimat, neque qui salvum fáciat.
\q1 \v 4 Dómine, Deus meus, si feci istud, * si est iníquitas in mánibus meis:
\q1 \v 5 Si réddidi retribuéntibus mihi mala, * décidam mérito ab inimícis meis inánis.
\q1 \v 6 Persequátur inimícus ánimam meam, † et comprehéndat, et concúlcet in terra vitam meam, * et glóriam meam in púlverem dedúcat.
\q1 \v 7 Exsúrge, Dómine, in ira tua: * et exaltáre in fínibus inimicórum meórum.
\q1 Et exsúrge, Dómine, Deus meus, in præcépto quod mandásti: * (8a) et synagóga populórum circúmdabit te.
\q1 \v 8 Et propter hanc in altum regrédere: * (9a) Dóminus júdicat pópulos.
\q1 \v 9 Júdica me, Dómine, secúndum justítiam meam, * et secúndum innocéntiam meam super me.
\q1 \v 10 Consumétur nequítia peccatórum, et díriges justum, * scrutans corda et renes, Deus.
\q1 \v 11 Justum adjutórium meum a Dómino, * qui salvos facit rectos corde.
\q1 \v 12 Deus judex justus, fortis, et pátiens: * numquid iráscitur per síngulos dies?
\q1 \v 13 Nisi convérsi fuéritis, gládium suum vibrábit: * arcum suum teténdit, et parávit illum.
\q1 \v 14 Et in eo parávit vasa mortis: * sagíttas suas ardéntibus effécit.
\q1 \v 15 Ecce, partúriit injustítiam: * concépit dolórem, et péperit iniquitátem.
\q1 \v 16 Lacum apéruit, et effódit eum: * et íncidit in fóveam quam fecit.
\q1 \v 17 Convertétur dolor ejus in caput ejus: * et in vérticem ipsíus iníquitas ejus descéndet.
\q1 \v 18 Confitébor Dómino secúndum justítiam ejus: * et psallam nómini Dómini altíssimi.
\c 8
\q1 \v 2 Dómine, Dóminus noster, * quam admirábile est nomen tuum in univérsa terra!
\q1 Quóniam eleváta est magnificéntia tua, * super cælos.
\q1 \v 3 Ex ore infántium et lacténtium perfecísti laudem propter inimícos tuos, * ut déstruas inimícum et ultórem.
\q1 \v 4 Quóniam vidébo cælos tuos, ópera digitórum tuórum: * lunam et stellas, quæ tu fundásti.
\q1 \v 5 Quid est homo quod memor es ejus? * aut fílius hóminis, quóniam vísitas eum?
\q1 \v 6 Minuísti eum paulo minus ab Ángelis, † glória et honóre coronásti eum: * (7) et constituísti eum super ópera mánuum tuárum.
\q1 \v 8 Ómnia subjecísti sub pédibus ejus, * oves et boves univérsas: ínsuper et pécora campi.
\q1 \v 9 Vólucres cæli, et pisces maris, * qui perámbulant sémitas maris.
\q1 \v 10 Dómine, Dóminus noster, * quam admirábile est nomen tuum in univérsa terra!
\c 9
\q1 \v 2 Confitébor tibi, Dómine, in toto corde meo: * narrábo ómnia mirabília tua.
\q1 \v 3 Lætábor et exsultábo in te: * psallam nómini tuo, Altíssime.
\q1 \v 4 In converténdo inimícum meum retrórsum: * infirmabúntur, et períbunt a fácie tua.
\q1 \v 5 Quóniam fecísti judícium meum et causam meam: * sedísti super thronum, qui júdicas justítiam.
\q1 \v 6 Increpásti gentes, et périit ímpius: * nomen eórum delésti in ætérnum, et in sǽculum sǽculi.
\q1 \v 7 Inimíci defecérunt frámeæ in finem: * et civitátes eórum destruxísti.
\q1 Périit memória eórum cum sónitu: * (8a) et Dóminus in ætérnum pérmanet.
\q1 \v 8 Parávit in judício thronum suum: * (9) et ipse judicábit orbem terræ in æquitáte, judicábit pópulos in justítia.
\q1 \v 10 Et factus est Dóminus refúgium páuperi: * adjútor in opportunitátibus, in tribulatióne.
\q1 \v 11 Et sperent in te qui novérunt nomen tuum: * quóniam non dereliquísti quæréntes te, Dómine.
\q1 \v 12 Psállite Dómino, qui hábitat in Sion: * annuntiáte inter gentes stúdia ejus:
\q1 \v 13 Quóniam requírens sánguinem eórum recordátus est: * non est oblítus clamórem páuperum.
\q1 \v 14 Miserére mei, Dómine: * vide humilitátem meam de inimícis meis.
\q1 \v 15 Qui exáltas me de portis mortis, * ut annúntiem omnes laudatiónes tuas in portis fíliæ Sion.
\q1 \v 16 Exsultábo in salutári tuo: * infíxæ sunt gentes in intéritu, quem fecérunt.
\q1 In láqueo isto, quem abscondérunt, * comprehénsus est pes eórum.
\q1 \v 17 Cognoscétur Dóminus judícia fáciens: * in opéribus mánuum suárum comprehénsus est peccátor.
\q1 \v 18 Convertántur peccatóres in inférnum, * omnes gentes quæ obliviscúntur Deum.
\q1 \v 19 Quóniam non in finem oblívio erit páuperis: * patiéntia páuperum non períbit in finem.
\q1 \v 20 Exsúrge, Dómine, non confortétur homo: * judicéntur gentes in conspéctu tuo.
\q1 \v 21 Constítue, Dómine, legislatórem super eos: * ut sciant gentes quóniam hómines sunt.
\q1 \v 22 Ut quid, Dómine, recessísti longe, * déspicis in opportunitátibus, in tribulatióne?
\q1 \v 23 Dum supérbit ímpius, incénditur pauper: * comprehendúntur in consíliis quibus cógitant.
\q1 \v 24 Quóniam laudátur peccátor in desidériis ánimæ suæ: * et iníquus benedícitur.
\q1 \v 25 Exacerbávit Dóminum peccátor, * secúndum multitúdinem iræ suæ non quæret.
\q1 \v 26 Non est Deus in conspéctu ejus: * inquinátæ sunt viæ illíus in omni témpore.
\q1 Auferúntur judícia tua a fácie ejus: * ómnium inimicórum suórum dominábitur.
\q1 \v 27 Dixit enim in corde suo: * Non movébor a generatióne in generatiónem sine malo.
\q1 \v 28 Cujus maledictióne os plenum est, et amaritúdine, et dolo: * sub lingua ejus labor et dolor.
\q1 \v 29 Sedet in insídiis cum divítibus in occúltis: * ut interfíciat innocéntem.
\q1 \v 30 Óculi ejus in páuperem respíciunt: * insidiátur in abscóndito, quasi leo in spelúnca sua.
\q1 Insidiátur ut rápiat páuperem: * rápere páuperem, dum áttrahit eum.
\q1 \v 31 In láqueo suo humiliábit eum: * inclinábit se, et cadet, cum dominátus fúerit páuperum.
\q1 \v 32 Dixit enim in corde suo: Oblítus est Deus, * avértit fáciem suam ne vídeat in finem.
\q1 \v 33 Exsúrge, Dómine Deus, exaltétur manus tua: * ne obliviscáris páuperum.
\q1 \v 34 Propter quid irritávit ímpius Deum? * dixit enim in corde suo: Non requíret.
\q1 \v 35 Vides quóniam tu labórem et dolórem consíderas: * ut tradas eos in manus tuas.
\q1 Tibi derelíctus est pauper: * órphano tu eris adjútor.
\q1 \v 36 Cóntere brácchium peccatóris et malígni: * quærétur peccátum illíus, et non inveniétur.
\q1 \v 37 Dóminus regnábit in ætérnum, et in sǽculum sǽculi: * períbitis, gentes, de terra illíus.
\q1 \v 38 Desidérium páuperum exaudívit Dóminus: * præparatiónem cordis eórum audívit auris tua.
\q1 \v 39 Judicáre pupíllo et húmili, * ut non appónat ultra magnificáre se homo super terram.
\c 10
\q1 \v 2 In Dómino confído: † quómodo dícitis ánimæ meæ: * Tránsmigra in montem sicut passer?
\q1 \v 3 Quóniam ecce peccatóres intendérunt arcum, † paravérunt sagíttas suas in pháretra, * ut sagíttent in obscúro rectos corde.
\q1 \v 4 Quóniam quæ perfecísti, destruxérunt: * justus autem quid fecit?
\q1 \v 5 Dóminus in templo sancto suo, * Dóminus in cælo sedes ejus.
\q1 Óculi ejus in páuperem respíciunt: * pálpebræ ejus intérrogant fílios hóminum.
\q1 \v 6 Dóminus intérrogat justum et ímpium: * qui autem díligit iniquitátem, odit ánimam suam.
\q1 \v 7 Pluet super peccatóres láqueos: * ignis, et sulphur, et spíritus procellárum pars cálicis eórum.
\q1 \v 8 Quóniam justus Dóminus, et justítias diléxit: * æquitátem vidit vultus ejus.
\c 11
\q1 \v 2 Salvum me fac, Dómine, quóniam defécit sanctus: * quóniam diminútæ sunt veritátes a fíliis hóminum.
\q1 \v 3 Vana locúti sunt unusquísque ad próximum suum: * lábia dolósa, in corde et corde locúti sunt.
\q1 \v 4 Dispérdat Dóminus univérsa lábia dolósa, * et linguam magníloquam.
\q1 \v 5 Qui dixérunt: Linguam nostram magnificábimus, † lábia nostra a nobis sunt, * quis noster Dóminus est?
\q1 \v 6 Propter misériam ínopum, et gémitum páuperum, * nunc exsúrgam, dicit Dóminus.
\q1 Ponam in salutári: * fiduciáliter agam in eo.
\q1 \v 7 Elóquia Dómini, elóquia casta: * argéntum igne examinátum, probátum terræ purgátum séptuplum.
\q1 \v 8 Tu, Dómine, servábis nos: et custódies nos * a generatióne hac in ætérnum.
\q1 \v 9 In circúitu ímpii ámbulant: * secúndum altitúdinem tuam multiplicásti fílios hóminum.
\c 12
\q1 \v 1 Úsquequo, Dómine, obliviscéris me in finem? * Úsquequo avértis fáciem tuam a me?
\q1 \v 2 Quámdiu ponam consília in ánima mea, * dolórem in corde meo per diem?
\q1 \v 3 Úsquequo exaltábitur inimícus meus super me? * (4a) réspice, et exáudi me, Dómine, Deus meus.
\q1 \v 4 Illúmina óculos meos ne umquam obdórmiam in morte: * (5a) nequándo dicat inimícus meus: Præválui advérsus eum.
\q1 \v 5 Qui tríbulant me, exsultábunt si motus fúero: * (6a) ego autem in misericórdia tua sperávi.
\q1 \v 6 Exsultábit cor meum in salutári tuo: † cantábo Dómino qui bona tríbuit mihi: * et psallam nómini Dómini altíssimi.
\c 13
\q1 \v 1 Dixit insípiens in corde suo: * non est Deus.
\q1 Corrúpti sunt, et abominábiles facti sunt in stúdiis suis: * non est qui fáciat bonum, non est usque ad unum.
\q1 \v 2 Dóminus de cælo prospéxit super fílios hóminum, * ut vídeat si est intéllegens, aut requírens Deum.
\q1 \v 3 Omnes declinavérunt, simul inútiles facti sunt: * non est qui fáciat bonum, non est usque ad unum.
\q1 Sepúlcrum patens est guttur eórum: † linguis suis dolóse agébant * venénum áspidum sub lábiis eórum.
\q1 Quorum os maledictióne et amaritúdine plenum est: * velóces pedes eórum ad effundéndum sánguinem.
\q1 Contrítio et infelícitas in viis eórum, † et viam pacis non cognovérunt: * non est timor Dei ante óculos eórum.
\q1 \v 4 Nonne cognóscent omnes qui operántur iniquitátem, * qui dévorant plebem meam sicut escam panis?
\q1 \v 5 Dóminum non invocavérunt, * illic trepidavérunt timóre, ubi non erat timor.
\q1 \v 6 Quóniam Dóminus in generatióne justa est, † consílium ínopis confudístis: * quóniam Dóminus spes ejus est.
\q1 \v 7 Quis dabit ex Sion salutáre Israël? * cum avérterit Dóminus captivitátem plebis suæ, exsultábit Jacob, et lætábitur Israël.
\c 14
\q1 \v 1 Dómine, quis habitábit in tabernáculo tuo? * aut quis requiéscet in monte sancto tuo?
\q1 \v 2 Qui ingréditur sine mácula, * et operátur justítiam:
\q1 \v 3 Qui lóquitur veritátem in corde suo, * qui non egit dolum in lingua sua:
\q1 Nec fecit próximo suo malum, * et oppróbrium non accépit advérsus próximos suos.
\q1 \v 4 Ad níhilum dedúctus est in conspéctu ejus malígnus: * timéntes autem Dóminum gloríficat:
\q1 Qui jurat próximo suo, et non décipit, * (5a) qui pecúniam suam non dedit ad usúram, et múnera super innocéntem non accépit.
\q1 \v 5 Qui facit hæc: * non movébitur in ætérnum.
\c 15
\q1 \v 1 Consérva me, Dómine, quóniam sperávi in te. ‡ (2) Dixi Dómino: Deus meus es tu, * quóniam bonórum meórum non eges.
\q1 \v 3 Sanctis, qui sunt in terra ejus, * mirificávit omnes voluntátes meas in eis.
\q1 \v 4 Multiplicátæ sunt infirmitátes eórum: * póstea acceleravérunt.
\q1 Non congregábo conventícula eórum de sanguínibus, * nec memor ero nóminum eórum per lábia mea.
\q1 \v 5 Dóminus pars hereditátis meæ, et cálicis mei: * tu es, qui restítues hereditátem meam mihi.
\q1 \v 6 Funes cecidérunt mihi in præcláris: * étenim heréditas mea præclára est mihi.
\q1 \v 7 Benedícam Dóminum, qui tríbuit mihi intelléctum: * ínsuper et usque ad noctem increpuérunt me renes mei.
\q1 \v 8 Providébam Dóminum in conspéctu meo semper: * quóniam a dextris est mihi, ne commóvear.
\q1 \v 9 Propter hoc lætátum est cor meum, et exsultávit lingua mea: * ínsuper et caro mea requiéscet in spe.
\q1 \v 10 Quóniam non derelínques ánimam meam in inférno: * nec dabis sanctum tuum vidére corruptiónem.
\q1 \v 11 Notas mihi fecísti vias vitæ, † adimplébis me lætítia cum vultu tuo: * delectatiónes in déxtera tua usque in finem.
\c 16
\q1 \v 1 Exáudi, Dómine, justítiam meam: * inténde deprecatiónem meam.
\q1 Áuribus pércipe oratiónem meam, * non in lábiis dolósis.
\q1 \v 2 De vultu tuo judícium meum pródeat: * óculi tui vídeant æquitátes.
\q1 \v 3 Probásti cor meum, et visitásti nocte: * igne me examinásti, et non est invénta in me iníquitas.
\q1 \v 4 Ut non loquátur os meum ópera hóminum: * propter verba labiórum tuórum ego custodívi vias duras.
\q1 \v 5 Pérfice gressus meos in sémitis tuis: * ut non moveántur vestígia mea.
\q1 \v 6 Ego clamávi, quóniam exaudísti me, Deus: * inclína aurem tuam mihi, et exáudi verba mea.
\q1 \v 7 Mirífica misericórdias tuas, * qui salvos facis sperántes in te.
\q1 \v 8 A resisténtibus déxteræ tuæ custódi me, * ut pupíllam óculi.
\q1 Sub umbra alárum tuárum prótege me: * (9a) a fácie impiórum qui me afflixérunt.
\q1 \v 9 Inimíci mei ánimam meam circumdedérunt, † (10) ádipem suum conclusérunt: * os eórum locútum est supérbiam.
\q1 \v 11 Proiciéntes me nunc circumdedérunt me: * óculos suos statuérunt declináre in terram.
\q1 \v 12 Suscepérunt me sicut leo parátus ad prædam: * et sicut cátulus leónis hábitans in ábditis.
\q1 \v 13 Exsúrge, Dómine, prǽveni eum, et supplánta eum: * éripe ánimam meam ab ímpio, frámeam tuam (14a) ab inimícis manus tuæ.
\q1 \v 14 Dómine, a paucis de terra dívide eos in vita eórum: * de abscónditis tuis adimplétus est venter eórum.
\q1 Saturáti sunt fíliis: * et dimisérunt relíquias suas párvulis suis.
\q1 \v 15 Ego autem in justítia apparébo conspéctui tuo: * satiábor cum apparúerit glória tua.
\c 17
\q1 \v 2 Díligam te, Dómine, fortitúdo mea: * (3a) Dóminus firmaméntum meum, et refúgium meum, et liberátor meus.
\q1 \v 3 Deus meus adjútor meus, * et sperábo in eum.
\q1 Protéctor meus, et cornu salútis meæ, * et suscéptor meus.
\q1 \v 4 Laudans invocábo Dóminum: * et ab inimícis meis salvus ero.
\q1 \v 5 Circumdedérunt me dolóres mortis: * et torréntes iniquitátis conturbavérunt me.
\q1 \v 6 Dolóres inférni circumdedérunt me: * præoccupavérunt me láquei mortis.
\q1 \v 7 In tribulatióne mea invocávi Dóminum, * et ad Deum meum clamávi.
\q1 Et exaudívit de templo sancto suo vocem meam: * et clamor meus in conspéctu ejus, introívit in aures ejus.
\q1 \v 8 Commóta est, et contrémuit terra: * fundaménta móntium conturbáta sunt, et commóta sunt, quóniam irátus est eis.
\q1 \v 9 Ascéndit fumus in ira ejus: † et ignis a fácie ejus exársit: * carbónes succénsi sunt ab eo.
\q1 \v 10 Inclinávit cælos, et descéndit: * et calígo sub pédibus ejus.
\q1 \v 11 Et ascéndit super Chérubim, et volávit: * volávit super pennas ventórum.
\q1 \v 12 Et pósuit ténebras latíbulum suum, † in circúitu ejus tabernáculum ejus: * tenebrósa aqua in núbibus áëris.
\q1 \v 13 Præ fulgóre in conspéctu ejus nubes transiérunt, * grando et carbónes ignis.
\q1 \v 14 Et intónuit de cælo Dóminus, † et Altíssimus dedit vocem suam: * grando et carbónes ignis.
\q1 \v 15 Et misit sagíttas suas, et dissipávit eos: * fúlgura multiplicávit, et conturbávit eos.
\q1 \v 16 Et apparuérunt fontes aquárum, * et reveláta sunt fundaménta orbis terrárum:
\q1 Ab increpatióne tua, Dómine, * ab inspiratióne spíritus iræ tuæ.
\q1 \v 17 Misit de summo, et accépit me: * et assúmpsit me de aquis multis.
\q1 \v 18 Erípuit me de inimícis meis fortíssimis, † et ab his qui odérunt me: * quóniam confortáti sunt super me.
\q1 \v 19 Prævenérunt me in die afflictiónis meæ: * et factus est Dóminus protéctor meus.
\q1 \v 20 Et edúxit me in latitúdinem: * salvum me fecit, quóniam vóluit me.
\q1 \v 21 Et retríbuet mihi Dóminus secúndum justítiam meam: * et secúndum puritátem mánuum meárum retríbuet mihi:
\q1 \v 22 Quia custodívi vias Dómini, * nec ímpie gessi a Deo meo.
\q1 \v 23 Quóniam ómnia judícia ejus in conspéctu meo: * et justítias ejus non répuli a me.
\q1 \v 24 Et ero immaculátus cum eo: * et observábo me ab iniquitáte mea.
\q1 \v 25 Et retríbuet mihi Dóminus secúndum justítiam meam: * et secúndum puritátem mánuum meárum in conspéctu oculórum ejus.
\q1 \v 26 Cum sancto sanctus eris, * et cum viro innocénte ínnocens eris:
\q1 \v 27 Et cum elécto eléctus eris: * et cum pervérso pervertéris.
\q1 \v 28 Quóniam tu pópulum húmilem salvum fácies: * et óculos superbórum humiliábis.
\q1 \v 29 Quóniam tu illúminas lucérnam meam, Dómine: * Deus meus, illúmina ténebras meas.
\q1 \v 30 Quóniam in te erípiar a tentatióne, * et in Deo meo transgrédiar murum.
\q1 \v 31 Deus meus, impollúta via ejus: † elóquia Dómini igne examináta: * protéctor est ómnium sperántium in se.
\q1 \v 32 Quóniam quis Deus præter Dóminum? * aut quis Deus præter Deum nostrum?
\q1 \v 33 Deus, qui præcínxit me virtúte: * et pósuit immaculátam viam meam.
\q1 \v 34 Qui perfécit pedes meos tamquam cervórum, * et super excélsa státuens me.
\q1 \v 35 Qui docet manus meas ad prǽlium: * et posuísti, ut arcum ǽreum, brácchia mea.
\q1 \v 36 Et dedísti mihi protectiónem salútis tuæ: * et déxtera tua suscépit me:
\q1 Et disciplína tua corréxit me in finem: * et disciplína tua ipsa me docébit.
\q1 \v 37 Dilatásti gressus meos subtus me: * et non sunt infirmáta vestígia mea:
\q1 \v 38 Pérsequar inimícos meos et comprehéndam illos: * et non convértar, donec defíciant.
\q1 \v 39 Confríngam illos, nec póterunt stare: * cadent subtus pedes meos.
\q1 \v 40 Et præcinxísti me virtúte ad bellum: * et supplantásti insurgéntes in me subtus me.
\q1 \v 41 Et inimícos meos dedísti mihi dorsum, * et odiéntes me disperdidísti.
\q1 \v 42 Clamavérunt, nec erat qui salvos fáceret ad Dóminum: * nec exaudívit eos.
\q1 \v 43 Et commínuam eos, ut púlverem ante fáciem venti: * ut lutum plateárum delébo eos.
\q1 \v 44 Erípies me de contradictiónibus pópuli: * constítues me in caput géntium.
\q1 \v 45 Pópulus quem non cognóvi servívit mihi: * in audítu auris obedívit mihi.
\q1 \v 46 Fílii aliéni mentíti sunt mihi, * fílii aliéni inveteráti sunt, et claudicavérunt a sémitis suis.
\q1 \v 47 Vivit Dóminus, et benedíctus Deus meus: * et exaltétur Deus salútis meæ.
\q1 \v 48 Deus, qui das vindíctas mihi, et subdis pópulos sub me: * liberátor meus de inimícis meis iracúndis.
\q1 \v 49 Et ab insurgéntibus in me exaltábis me: * a viro iníquo erípies me.
\q1 \v 50 Proptérea confitébor tibi in natiónibus, Dómine: * et nómini tuo psalmum dicam.
\q1 \v 51 Magníficans salútes Regis ejus, † et fáciens misericórdiam Christo suo David: * et sémini ejus usque in sǽculum.
\c 18
\q1 \v 2 Cæli enárrant glóriam Dei: * et ópera mánuum ejus annúntiat firmaméntum.
\q1 \v 3 Dies diéi erúctat verbum, * et nox nocti índicat sciéntiam.
\q1 \v 4 Non sunt loquélæ, neque sermónes, * quorum non audiántur voces eórum.
\q1 \v 5 In omnem terram exívit sonus eórum: * et in fines orbis terræ verba eórum.
\q1 \v 6 In sole pósuit tabernáculum suum: * et ipse tamquam sponsus procédens de thálamo suo:
\q1 Exsultávit ut gigas ad curréndam viam, * (7a) a summo cælo egréssio ejus:
\q1 \v 7 Et occúrsus ejus usque ad summum ejus: * nec est qui se abscóndat a calóre ejus.
\q1 \v 8 Lex Dómini immaculáta, convértens ánimas: * testimónium Dómini fidéle, sapiéntiam præstans párvulis.
\q1 \v 9 Justítiæ Dómini rectæ, lætificántes corda: * præcéptum Dómini lúcidum, illúminans óculos.
\q1 \v 10 Timor Dómini sanctus, pérmanens in sǽculum sǽculi: * judícia Dómini vera, justificáta in semetípsa.
\q1 \v 11 Desiderabília super aurum et lápidem pretiósum multum: * et dulcióra super mel et favum.
\q1 \v 12 Étenim servus tuus custódit ea, * in custodiéndis illis retribútio multa.
\q1 \v 13 Delícta quis intéllegit? † ab occúltis meis munda me: * (14a) et ab aliénis parce servo tuo.
\q1 \v 14 Si mei non fúerint domináti, tunc immaculátus ero: * et emundábor a delícto máximo.
\q1 \v 15 Et erunt ut compláceant elóquia oris mei: * et meditátio cordis mei in conspéctu tuo semper.
\q1 Dómine, adjútor meus, * et redémptor meus.
\c 19
\q1 \v 2 Exáudiat te Dóminus in die tribulatiónis: * prótegat te nomen Dei Jacob.
\q1 \v 3 Mittat tibi auxílium de sancto: * et de Sion tueátur te.
\q1 \v 4 Memor sit omnis sacrifícii tui: * et holocáustum tuum pingue fiat.
\q1 \v 5 Tríbuat tibi secúndum cor tuum: * et omne consílium tuum confírmet.
\q1 \v 6 Lætábimur in salutári tuo: * et in nómine Dei nostri magnificábimur.
\q1 \v 7 Ímpleat Dóminus omnes petitiónes tuas: * nunc cognóvi quóniam salvum fecit Dóminus Christum suum.
\q1 Exáudiet illum de cælo sancto suo: * in potentátibus salus déxteræ ejus.
\q1 \v 8 Hi in cúrribus, et hi in equis: * nos autem in nómine Dómini, Dei nostri invocábimus.
\q1 \v 9 Ipsi obligáti sunt, et cecidérunt: * nos autem surréximus et erécti sumus.
\q1 \v 10 Dómine, salvum fac regem: * et exáudi nos in die, qua invocavérimus te.
\c 20
\q1 \v 2 Dómine, in virtúte tua lætábitur rex: * et super salutáre tuum exsultábit veheménter.
\q1 \v 3 Desidérium cordis ejus tribuísti ei: * et voluntáte labiórum ejus non fraudásti eum.
\q1 \v 4 Quóniam prævenísti eum in benedictiónibus dulcédinis: * posuísti in cápite ejus corónam de lápide pretióso.
\q1 \v 5 Vitam pétiit a te: * et tribuísti ei longitúdinem diérum in sǽculum, et in sǽculum sǽculi.
\q1 \v 6 Magna est glória ejus in salutári tuo: * glóriam et magnum decórem impónes super eum.
\q1 \v 7 Quóniam dabis eum in benedictiónem in sǽculum sǽculi: * lætificábis eum in gáudio cum vultu tuo.
\q1 \v 8 Quóniam rex sperat in Dómino: * et in misericórdia Altíssimi non commovébitur.
\q1 \v 9 Inveniátur manus tua ómnibus inimícis tuis: * déxtera tua invéniat omnes, qui te odérunt.
\q1 \v 10 Pones eos ut clíbanum ignis in témpore vultus tui: * Dóminus in ira sua conturbábit eos, et devorábit eos ignis.
\q1 \v 11 Fructum eórum de terra perdes: * et semen eórum a fíliis hóminum.
\q1 \v 12 Quóniam declinavérunt in te mala: * cogitavérunt consília, quæ non potuérunt stabilíre.
\q1 \v 13 Quóniam pones eos dorsum: * in relíquiis tuis præparábis vultum eórum.
\q1 \v 14 Exaltáre, Dómine, in virtúte tua: * cantábimus et psallémus virtútes tuas.
\c 21
\q1 \v 2 Deus, Deus meus, réspice in me: quare me dereliquísti? * longe a salúte mea verba delictórum meórum.
\q1 \v 3 Deus meus, clamábo per diem, et non exáudies: * et nocte, et non ad insipiéntiam mihi.
\q1 \v 4 Tu autem in sancto hábitas, * laus Israël.
\q1 \v 5 In te speravérunt patres nostri: * speravérunt, et liberásti eos.
\q1 \v 6 Ad te clamavérunt, et salvi facti sunt: * in te speravérunt, et non sunt confúsi.
\q1 \v 7 Ego autem sum vermis, et non homo: * oppróbrium hóminum, et abjéctio plebis.
\q1 \v 8 Omnes vidéntes me, derisérunt me: * locúti sunt lábiis, et movérunt caput.
\q1 \v 9 Sperávit in Dómino, erípiat eum: * salvum fáciat eum, quóniam vult eum.
\q1 \v 10 Quóniam tu es, qui extraxísti me de ventre: * spes mea ab ubéribus matris meæ. In te projéctus sum ex útero:
\q1 \v 11 De ventre matris meæ Deus meus es tu, * ne discésseris a me:
\q1 \v 12 Quóniam tribulátio próxima est: * quóniam non est qui ádjuvet.
\q1 \v 13 Circumdedérunt me vítuli multi: * tauri pingues obsedérunt me.
\q1 \v 14 Aperuérunt super me os suum, * sicut leo rápiens et rúgiens.
\q1 \v 15 Sicut aqua effúsus sum: * et dispérsa sunt ómnia ossa mea.
\q1 Factum est cor meum tamquam cera liquéscens * in médio ventris mei.
\q1 \v 16 Áruit tamquam testa virtus mea, et lingua mea adhǽsit fáucibus meis: * et in púlverem mortis deduxísti me.
\q1 \v 17 Quóniam circumdedérunt me canes multi: * concílium malignántium obsédit me.
\q1 Fodérunt manus meas et pedes meos: * dinumeravérunt ómnia ossa mea.
\q1 \v 18 Ipsi vero consideravérunt et inspexérunt me: * divisérunt sibi vestiménta mea, et super vestem meam misérunt sortem.
\q1 \v 20 Tu autem, Dómine, ne elongáveris auxílium tuum a me: * ad defensiónem meam cónspice.
\q1 \v 21 Érue a frámea, Deus, ánimam meam: * et de manu canis únicam meam:
\q1 \v 22 Salva me ex ore leónis: * et a córnibus unicórnium humilitátem meam.
\q1 \v 23 Narrábo nomen tuum frátribus meis: * in médio ecclésiæ laudábo te.
\q1 \v 24 Qui timétis Dóminum, laudáte eum: * univérsum semen Jacob, glorificáte eum.
\q1 \v 25 Tímeat eum omne semen Israël: * quóniam non sprevit, neque despéxit deprecatiónem páuperis:
\q1 Nec avértit fáciem suam a me: * et cum clamárem ad eum, exaudívit me.
\q1 \v 26 Apud te laus mea in ecclésia magna: * vota mea reddam in conspéctu timéntium eum.
\q1 \v 27 Edent páuperes, et saturabúntur: et laudábunt Dóminum qui requírunt eum: * vivent corda eórum in sǽculum sǽculi.
\q1 \v 28 Reminiscéntur et converténtur ad Dóminum * univérsi fines terræ:
\q1 Et adorábunt in conspéctu ejus * univérsæ famíliæ géntium.
\q1 \v 29 Quóniam Dómini est regnum: * et ipse dominábitur géntium.
\q1 \v 30 Manducavérunt et adoravérunt omnes pingues terræ: * in conspéctu ejus cadent omnes qui descéndunt in terram.
\q1 \v 31 Et ánima mea illi vivet: * et semen meum sérviet ipsi.
\q1 \v 32 Annuntiábitur Dómino generátio ventúra: * et annuntiábunt cæli justítiam ejus pópulo qui nascétur, quem fecit Dóminus.
\c 22
\q1 \v 1 Dóminus regit me, et nihil mihi déerit: * in loco páscuæ ibi me collocávit.
\q1 \v 2 Super aquam refectiónis educávit me: * ánimam meam convértit.
\q1 \v 3 Dedúxit me super sémitas justítiæ, * propter nomen suum.
\q1 \v 4 Nam, et si ambulávero in médio umbræ mortis, non timébo mala: * quóniam tu mecum es.
\q1 Virga tua, et báculus tuus: * ipsa me consoláta sunt.
\q1 \v 5 Parásti in conspéctu meo mensam, * advérsus eos, qui tríbulant me.
\q1 Impinguásti in óleo caput meum: * et calix meus inébrians quam præclárus est!
\q1 \v 6 Et misericórdia tua subsequétur me * ómnibus diébus vitæ meæ:
\q1 Et ut inhábitem in domo Dómini, * in longitúdinem diérum.
\c 23
\q1 \v 1 Dómini est terra, et plenitúdo ejus: * orbis terrárum, et univérsi qui hábitant in eo.
\q1 \v 2 Quia ipse super mária fundávit eum: * et super flúmina præparávit eum.
\q1 \v 3 Quis ascéndet in montem Dómini? * aut quis stabit in loco sancto ejus?
\q1 \v 4 Ínnocens mánibus et mundo corde, * qui non accépit in vano ánimam suam, nec jurávit in dolo próximo suo.
\q1 \v 5 Hic accípiet benedictiónem a Dómino: * et misericórdiam a Deo, salutári suo.
\q1 \v 6 Hæc est generátio quæréntium eum, * quæréntium fáciem Dei Jacob.
\q1 \v 7 Attóllite portas, príncipes, vestras, et elevámini, portæ æternáles: * et introíbit Rex glóriæ.
\q1 \v 8 Quis est iste Rex glóriæ? * Dóminus fortis et potens: Dóminus potens in prǽlio.
\q1 \v 9 Attóllite portas, príncipes, vestras, et elevámini, portæ æternáles: * et introíbit Rex glóriæ.
\q1 \v 10 Quis est iste Rex glóriæ? * Dóminus virtútum ipse est Rex glóriæ.
\c 24
\q1 \v 1 Ad te, Dómine, levávi ánimam meam: * Deus meus, in te confído, non erubéscam.
\q1 \v 3 Neque irrídeant me inimíci mei: * étenim univérsi, qui sústinent te, non confundéntur.
\q1 \v 4 Confundántur omnes iníqua agéntes * supervácue.
\q1 Vias tuas, Dómine, demónstra mihi: * et sémitas tuas édoce me.
\q1 \v 5 Dírige me in veritáte tua, et doce me: * quia tu es, Deus, salvátor meus, et te sustínui tota die.
\q1 \v 6 Reminíscere miseratiónum tuárum, Dómine, * et misericordiárum tuárum, quæ a sǽculo sunt.
\q1 \v 7 Delícta juventútis meæ, * et ignorántias meas ne memíneris.
\q1 Secúndum misericórdiam tuam meménto mei tu: * propter bonitátem tuam, Dómine.
\q1 \v 8 Dulcis et rectus Dóminus: * propter hoc legem dabit delinquéntibus in via.
\q1 \v 9 Díriget mansuétos in judício: * docébit mites vias suas.
\q1 \v 10 Univérsæ viæ Dómini, misericórdia et véritas, * requiréntibus testaméntum ejus et testimónia ejus.
\q1 \v 11 Propter nomen tuum, Dómine, propitiáberis peccáto meo: * multum est enim.
\q1 \v 12 Quis est homo qui timet Dóminum? * legem státuit ei in via, quam elégit.
\q1 \v 13 Ánima ejus in bonis demorábitur: * et semen ejus hereditábit terram.
\q1 \v 14 Firmaméntum est Dóminus timéntibus eum: * et testaméntum ipsíus ut manifestétur illis.
\q1 \v 15 Óculi mei semper ad Dóminum: * quóniam ipse evéllet de láqueo pedes meos.
\q1 \v 16 Réspice in me, et miserére mei: * quia únicus et pauper sum ego.
\q1 \v 17 Tribulatiónes cordis mei multiplicátæ sunt: * de necessitátibus meis érue me.
\q1 \v 18 Vide humilitátem meam, et labórem meum: * et dimítte univérsa delícta mea.
\q1 \v 19 Réspice inimícos meos quóniam multiplicáti sunt, * et ódio iníquo odérunt me.
\q1 \v 20 Custódi ánimam meam, et érue me: * non erubéscam quóniam sperávi in te.
\q1 \v 21 Innocéntes et recti adhæsérunt mihi: * quia sustínui te.
\q1 \v 22 Líbera, Deus, Israël, * ex ómnibus tribulatiónibus suis.
\c 25
\q1 \v 1 Júdica me, Dómine, quóniam ego in innocéntia mea ingréssus sum: * et in Dómino sperans non infirmábor.
\q1 \v 2 Proba me, Dómine, et tenta me: * ure renes meos et cor meum.
\q1 \v 3 Quóniam misericórdia tua ante óculos meos est: * et complácui in veritáte tua.
\q1 \v 4 Non sedi cum concílio vanitátis: * et cum iníqua geréntibus non introíbo.
\q1 \v 5 Odívi ecclésiam malignántium: * et cum ímpiis non sedébo.
\q1 \v 6 Lavábo inter innocéntes manus meas: * et circúmdabo altáre tuum, Dómine:
\q1 \v 7 Ut áudiam vocem laudis, * et enárrem univérsa mirabília tua.
\q1 \v 8 Dómine, diléxi decórem domus tuæ, * et locum habitatiónis glóriæ tuæ.
\q1 \v 9 Ne perdas cum ímpiis, Deus, ánimam meam, * et cum viris sánguinum vitam meam:
\q1 \v 10 In quorum mánibus iniquitátes sunt: * déxtera eórum repléta est munéribus.
\q1 \v 11 Ego autem in innocéntia mea ingréssus sum: * rédime me, et miserére mei.
\q1 \v 12 Pes meus stetit in dirécto: * in ecclésiis benedícam te, Dómine.
\c 26
\q1 \v 1 Dóminus illuminátio mea, et salus mea, * quem timébo?
\q1 Dóminus protéctor vitæ meæ, * a quo trepidábo?
\q1 \v 2 Dum apprópiant super me nocéntes, * ut edant carnes meas:
\q1 Qui tríbulant me inimíci mei, * ipsi infirmáti sunt, et cecidérunt.
\q1 \v 3 Si consístant advérsum me castra, * non timébit cor meum.
\q1 Si exsúrgat advérsum me prǽlium, * in hoc ego sperábo.
\q1 \v 4 Unam pétii a Dómino, hanc requíram, * ut inhábitem in domo Dómini ómnibus diébus vitæ meæ:
\q1 Ut vídeam voluptátem Dómini, * et vísitem templum ejus.
\q1 \v 5 Quóniam abscóndit me in tabernáculo suo: * in die malórum protéxit me in abscóndito tabernáculi sui.
\q1 \v 6 In petra exaltávit me: * et nunc exaltávit caput meum super inimícos meos.
\q1 Circuívi, et immolávi in tabernáculo ejus hóstiam vociferatiónis: * cantábo, et psalmum dicam Dómino.
\q1 \v 7 Exáudi, Dómine, vocem meam, qua clamávi ad te: * miserére mei, et exáudi me.
\q1 \v 8 Tibi dixit cor meum, exquisívit te fácies mea: * fáciem tuam, Dómine, requíram.
\q1 \v 9 Ne avértas fáciem tuam a me: * ne declínes in ira a servo tuo.
\q1 Adjútor meus esto: * ne derelínquas me, neque despícias me, Deus, salutáris meus.
\q1 \v 10 Quóniam pater meus, et mater mea dereliquérunt me: * Dóminus autem assúmpsit me.
\q1 \v 11 Legem pone mihi, Dómine, in via tua: * et dírige me in sémitam rectam propter inimícos meos.
\q1 \v 12 Ne tradíderis me in ánimas tribulántium me: * quóniam insurrexérunt in me testes iníqui, et mentíta est iníquitas sibi.
\q1 \v 13 Credo vidére bona Dómini * in terra vivéntium.
\q1 \v 14 Exspécta Dóminum, viríliter age: * et confortétur cor tuum, et sústine Dóminum.
\c 27
\q1 \v 1 Ad te, Dómine, clamábo, Deus meus, ne síleas a me: * nequándo táceas a me, et assimilábor descendéntibus in lacum.
\q1 \v 2 Exáudi, Dómine, vocem deprecatiónis meæ dum oro ad te: * dum extóllo manus meas ad templum sanctum tuum.
\q1 \v 3 Ne simul trahas me cum peccatóribus: * et cum operántibus iniquitátem ne perdas me.
\q1 Qui loquúntur pacem cum próximo suo, * mala autem in córdibus eórum.
\q1 \v 4 Da illis secúndum ópera eórum, * et secúndum nequítiam adinventiónum ipsórum.
\q1 Secúndum ópera mánuum eórum tríbue illis: * redde retributiónem eórum ipsis.
\q1 \v 5 Quóniam non intellexérunt ópera Dómini, et in ópera mánuum ejus * déstrues illos, et non ædificábis eos.
\q1 \v 6 Benedíctus Dóminus: * quóniam exaudívit vocem deprecatiónis meæ.
\q1 \v 7 Dóminus adjútor meus, et protéctor meus: * in ipso sperávit cor meum, et adjútus sum.
\q1 Et reflóruit caro mea: * et ex voluntáte mea confitébor ei.
\q1 \v 8 Dóminus fortitúdo plebis suæ: * et protéctor salvatiónum Christi sui est.
\q1 \v 9 Salvum fac pópulum tuum, Dómine, et bénedic hereditáti tuæ: * et rege eos, et extólle illos usque in ætérnum.
\c 28
\q1 \v 1 Afférte Dómino, fílii Dei: * afférte Dómino fílios aríetum.
\q1 \v 2 Afférte Dómino glóriam et honórem, afférte Dómino glóriam nómini ejus: * adoráte Dóminum in átrio sancto ejus.
\q1 \v 3 Vox Dómini super aquas, Deus majestátis intónuit: * Dóminus super aquas multas.
\q1 \v 4 Vox Dómini in virtúte: * vox Dómini in magnificéntia.
\q1 \v 5 Vox Dómini confringéntis cedros: * et confrínget Dóminus cedros Líbani:
\q1 \v 6 Et commínuet eas tamquam vítulum Líbani: * et diléctus quemádmodum fílius unicórnium.
\q1 \v 7 Vox Dómini intercidéntis flammam ignis: * vox Dómini concutiéntis desértum: et commovébit Dóminus desértum Cades.
\q1 \v 9 Vox Dómini præparántis cervos, et revelábit condénsa: * et in templo ejus omnes dicent glóriam.
\q1 \v 10 Dóminus dilúvium inhabitáre facit: * et sedébit Dóminus Rex in ætérnum.
\q1 \v 11 Dóminus virtútem pópulo suo dabit: * Dóminus benedícet pópulo suo in pace.
\c 29
\q1 \v 2 Exaltábo te, Dómine, quóniam suscepísti me: * nec delectásti inimícos meos super me.
\q1 \v 3 Dómine, Deus meus, clamávi ad te, * et sanásti me.
\q1 \v 4 Dómine, eduxísti ab inférno ánimam meam: * salvásti me a descendéntibus in lacum.
\q1 \v 5 Psállite Dómino, sancti ejus: * et confitémini memóriæ sanctitátis ejus.
\q1 \v 6 Quóniam ira in indignatióne ejus: * et vita in voluntáte ejus.
\q1 Ad vésperum demorábitur fletus: * et ad matutínum lætítia.
\q1 \v 7 Ego autem dixi in abundántia mea: * Non movébor in ætérnum.
\q1 \v 8 Dómine, in voluntáte tua, * præstitísti decóri meo virtútem.
\q1 Avertísti fáciem tuam a me, * et factus sum conturbátus.
\q1 \v 9 Ad te, Dómine, clamábo: * et ad Deum meum deprecábor.
\q1 \v 10 Quæ utílitas in sánguine meo, * dum descéndo in corruptiónem?
\q1 Numquid confitébitur tibi pulvis, * aut annuntiábit veritátem tuam?
\q1 \v 11 Audívit Dóminus, et misértus est mei: * Dóminus factus est adjútor meus.
\q1 \v 12 Convertísti planctum meum in gáudium mihi: * conscidísti saccum meum, et circumdedísti me lætítia:
\q1 \v 13 Ut cantet tibi glória mea, et non compúngar: * Dómine, Deus meus, in ætérnum confitébor tibi.
\c 30
\q1 \v 2 In te, Dómine, sperávi, non confúndar in ætérnum: * in justítia tua líbera me.
\q1 \v 3 Inclína ad me aurem tuam, * accélera ut éruas me.
\q1 Esto mihi in Deum protectórem, et in domum refúgii: * ut salvum me fácias.
\q1 \v 4 Quóniam fortitúdo mea, et refúgium meum es tu: * et propter nomen tuum dedúces me, et enútries me.
\q1 \v 5 Edúces me de láqueo hoc, quem abscondérunt mihi: * quóniam tu es protéctor meus.
\q1 \v 6 In manus tuas comméndo spíritum meum: * redemísti me, Dómine, Deus veritátis.
\q1 \v 7 Odísti observántes vanitátes, * supervácue.
\q1 Ego autem in Dómino sperávi: * exsultábo, et lætábor in misericórdia tua.
\q1 \v 8 Quóniam respexísti humilitátem meam, * salvásti de necessitátibus ánimam meam.
\q1 \v 9 Nec conclusísti me in mánibus inimíci: * statuísti in loco spatióso pedes meos.
\q1 \v 10 Miserére mei, Dómine, quóniam tríbulor: * conturbátus est in ira óculus meus, ánima mea, et venter meus:
\q1 \v 11 Quóniam defécit in dolóre vita mea: * et anni mei in gemítibus.
\q1 Infirmáta est in paupertáte virtus mea: * et ossa mea conturbáta sunt.
\q1 \v 12 Super omnes inimícos meos factus sum oppróbrium et vicínis meis valde: * et timor notis meis.
\q1 Qui vidébant me, foras fugérunt a me: * oblivióni datus sum, tamquam mórtuus a corde.
\q1 \v 13 Factus sum tamquam vas pérditum: * quóniam audívi vituperatiónem multórum commorántium in circúitu.
\q1 \v 14 In eo dum convenírent simul advérsum me, * accípere ánimam meam consiliáti sunt.
\q1 \v 15 Ego autem in te sperávi, Dómine: * dixi: Deus meus es tu: in mánibus tuis sortes meæ.
\q1 \v 16 Éripe me de manu inimicórum meórum, * et a persequéntibus me.
\q1 \v 17 Illústra fáciem tuam super servum tuum, salvum me fac in misericórdia tua: * Dómine, non confúndar, quóniam invocávi te.
\q1 \v 18 Erubéscant ímpii, et deducántur in inférnum: * muta fiant lábia dolósa.
\q1 \v 19 Quæ loquúntur advérsus justum iniquitátem: * in supérbia, et in abusióne.
\q1 \v 20 Quam magna multitúdo dulcédinis tuæ, Dómine, * quam abscondísti timéntibus te.
\q1 Perfecísti eis, qui sperant in te, * in conspéctu filiórum hóminum.
\q1 \v 21 Abscóndes eos in abscóndito faciéi tuæ * a conturbatióne hóminum.
\q1 Próteges eos in tabernáculo tuo * a contradictióne linguárum.
\q1 \v 22 Benedíctus Dóminus: * quóniam mirificávit misericórdiam suam mihi in civitáte muníta.
\q1 \v 23 Ego autem dixi in excéssu mentis meæ: * Projéctus sum a fácie oculórum tuórum.
\q1 Ídeo exaudísti vocem oratiónis meæ, * dum clamárem ad te.
\q1 \v 24 Dilígite Dóminum omnes sancti ejus: * quóniam veritátem requíret Dóminus, et retríbuet abundánter faciéntibus supérbiam.
\q1 \v 25 Viríliter ágite, et confortétur cor vestrum, * omnes, qui sperátis in Dómino.
\c 31
\q1 \v 1 Beáti quorum remíssæ sunt iniquitátes: * et quorum tecta sunt peccáta.
\q1 \v 2 Beátus vir, cui non imputávit Dóminus peccátum, * nec est in spíritu ejus dolus.
\q1 \v 3 Quóniam tácui, inveteravérunt ossa mea, * dum clamárem tota die.
\q1 \v 4 Quóniam die ac nocte graváta est super me manus tua: * convérsus sum in ærúmna mea, dum confígitur spina.
\q1 \v 5 Delíctum meum cógnitum tibi feci: * et injustítiam meam non abscóndi.
\q1 Dixi: Confitébor advérsum me injustítiam meam Dómino: * et tu remisísti impietátem peccáti mei.
\q1 \v 6 Pro hac orábit ad te omnis sanctus, * in témpore opportúno.
\q1 Verúmtamen in dilúvio aquárum multárum, * ad eum non approximábunt.
\q1 \v 7 Tu es refúgium meum a tribulatióne, quæ circúmdedit me: * exsultátio mea, érue me a circumdántibus me.
\q1 \v 8 Intelléctum tibi dabo, et ínstruam te in via hac, qua gradiéris: * firmábo super te óculos meos.
\q1 \v 9 Nolíte fíeri sicut equus et mulus, * quibus non est intelléctus.
\q1 In camo et freno maxíllas eórum constrínge, * qui non appróximant ad te.
\q1 \v 10 Multa flagélla peccatóris, * sperántem autem in Dómino misericórdia circúmdabit.
\q1 \v 11 Lætámini in Dómino et exsultáte, justi, * et gloriámini, omnes recti corde.
\c 32
\q1 \v 1 Exsultáte, justi, in Dómino: * rectos decet collaudátio.
\q1 \v 2 Confitémini Dómino in cíthara: * in psaltério decem chordárum psállite illi.
\q1 \v 3 Cantáte ei cánticum novum: * bene psállite ei in vociferatióne.
\q1 \v 4 Quia rectum est verbum Dómini, * et ómnia ópera ejus in fide.
\q1 \v 5 Díligit misericórdiam et judícium: * misericórdia Dómini plena est terra.
\q1 \v 6 Verbo Dómini cæli firmáti sunt: * et spíritu oris ejus omnis virtus eórum.
\q1 \v 7 Cóngregans sicut in utre aquas maris: * ponens in thesáuris abýssos.
\q1 \v 8 Tímeat Dóminum omnis terra: * ab eo autem commoveántur omnes inhabitántes orbem.
\q1 \v 9 Quóniam ipse dixit, et facta sunt: * ipse mandávit, et creáta sunt.
\q1 \v 10 Dóminus díssipat consília géntium: * réprobat autem cogitatiónes populórum, et réprobat consília príncipum.
\q1 \v 11 Consílium autem Dómini in ætérnum manet: * cogitatiónes cordis ejus in generatióne et generatiónem.
\q1 \v 12 Beáta gens, cujus est Dóminus, Deus ejus: * pópulus, quem elégit in hereditátem sibi.
\q1 \v 13 De cælo respéxit Dóminus: * vidit omnes fílios hóminum.
\q1 \v 14 De præparáto habitáculo suo * respéxit super omnes, qui hábitant terram.
\q1 \v 15 Qui finxit sigillátim corda eórum: * qui intéllegit ómnia ópera eórum.
\q1 \v 16 Non salvátur rex per multam virtútem: * et gigas non salvábitur in multitúdine virtútis suæ.
\q1 \v 17 Fallax equus ad salútem: * in abundántia autem virtútis suæ non salvábitur.
\q1 \v 18 Ecce, óculi Dómini super metuéntes eum: * et in eis, qui sperant super misericórdia ejus:
\q1 \v 19 Ut éruat a morte ánimas eórum: * et alat eos in fame.
\q1 \v 20 Ánima nostra sústinet Dóminum: * quóniam adjútor et protéctor noster est.
\q1 \v 21 Quia in eo lætábitur cor nostrum: * et in nómine sancto ejus sperávimus.
\q1 \v 22 Fiat misericórdia tua, Dómine, super nos: * quemádmodum sperávimus in te.
\c 33
\q1 \v 2 Benedícam Dóminum in omni témpore: * semper laus ejus in ore meo.
\q1 \v 3 In Dómino laudábitur ánima mea: * áudiant mansuéti, et læténtur.
\q1 \v 4 Magnificáte Dóminum mecum: * et exaltémus nomen ejus in idípsum.
\q1 \v 5 Exquisívi Dóminum, et exaudívit me: * et ex ómnibus tribulatiónibus meis erípuit me.
\q1 \v 6 Accédite ad eum, et illuminámini: * et fácies vestræ non confundéntur.
\q1 \v 7 Iste pauper clamávit, et Dóminus exaudívit eum: * et de ómnibus tribulatiónibus ejus salvávit eum.
\q1 \v 8 Immíttet Ángelus Dómini in circúitu timéntium eum: * et erípiet eos.
\q1 \v 9 Gustáte, et vidéte quóniam suávis est Dóminus: * beátus vir, qui sperat in eo.
\q1 \v 10 Timéte Dóminum, omnes sancti ejus: * quóniam non est inópia timéntibus eum.
\q1 \v 11 Dívites eguérunt et esuriérunt: * inquiréntes autem Dóminum non minuéntur omni bono.
\q1 \v 12 Veníte, fílii, audíte me: * timórem Dómini docébo vos.
\q1 \v 13 Quis est homo qui vult vitam: * díligit dies vidére bonos?
\q1 \v 14 Próhibe linguam tuam a malo: * et lábia tua ne loquántur dolum.
\q1 \v 15 Divérte a malo, et fac bonum: * inquíre pacem, et perséquere eam.
\q1 \v 16 Óculi Dómini super justos: * et aures ejus in preces eórum.
\q1 \v 17 Vultus autem Dómini super faciéntes mala: * ut perdat de terra memóriam eórum.
\q1 \v 18 Clamavérunt justi, et Dóminus exaudívit eos: * et ex ómnibus tribulatiónibus eórum liberávit eos.
\q1 \v 19 Juxta est Dóminus iis, qui tribuláto sunt corde: * et húmiles spíritu salvábit.
\q1 \v 20 Multæ tribulatiónes justórum: * et de ómnibus his liberábit eos Dóminus.
\q1 \v 21 Custódit Dóminus ómnia ossa eórum: * unum ex his non conterétur.
\q1 \v 22 Mors peccatórum péssima: * et qui odérunt justum, delínquent.
\q1 \v 23 Rédimet Dóminus ánimas servórum suórum: * et non delínquent omnes qui sperant in eo.
\c 34
\q1 \v 1 Júdica, Dómine, nocéntes me, * expúgna impugnántes me.
\q1 \v 2 Apprehénde arma et scutum: * et exsúrge in adjutórium mihi.
\q1 \v 3 Effúnde frámeam, et conclúde advérsus eos, qui persequúntur me: * dic ánimæ meæ: Salus tua ego sum.
\q1 \v 4 Confundántur et revereántur, * quæréntes ánimam meam.
\q1 Avertántur retrórsum, et confundántur * cogitántes mihi mala.
\q1 \v 5 Fiant tamquam pulvis ante fáciem venti: * et Ángelus Dómini coárctans eos.
\q1 \v 6 Fiat via illórum ténebræ et lúbricum: * et Ángelus Dómini pérsequens eos.
\q1 \v 7 Quóniam gratis abscondérunt mihi intéritum láquei sui: * supervácue exprobravérunt ánimam meam.
\q1 \v 8 Véniat illi láqueus, quem ignórat: et cáptio, quam abscóndit, apprehéndat eum: * et in láqueum cadat in ipsum.
\q1 \v 9 Ánima autem mea exsultábit in Dómino: * et delectábitur super salutári suo.
\q1 \v 10 Ómnia ossa mea dicent: * Dómine, quis símilis tibi?
\q1 Erípiens ínopem de manu fortiórum ejus: * egénum et páuperem a diripiéntibus eum.
\q1 \v 11 Surgéntes testes iníqui, * quæ ignorábam interrogábant me.
\q1 \v 12 Retribuébant mihi mala pro bonis: * sterilitátem ánimæ meæ.
\q1 \v 13 Ego autem cum mihi molésti essent, * induébar cilício.
\q1 Humiliábam in jejúnio ánimam meam: * et orátio mea in sinu meo convertétur.
\q1 \v 14 Quasi próximum, et quasi fratrem nostrum, sic complacébam: * quasi lugens et contristátus, sic humiliábar.
\q1 \v 15 Et advérsum me lætáti sunt, et convenérunt: * congregáta sunt super me flagélla, et ignorávi.
\q1 \v 16 Dissipáti sunt, nec compúncti, tentavérunt me, subsannavérunt me subsannatióne: * frenduérunt super me déntibus suis.
\q1 \v 17 Dómine, quando respícies? * restítue ánimam meam a malignitáte eórum, a leónibus únicam meam.
\q1 \v 18 Confitébor tibi in ecclésia magna, * in pópulo gravi laudábo te.
\q1 \v 19 Non supergáudeant mihi qui adversántur mihi iníque: * qui odérunt me gratis et ánnuunt óculis.
\q1 \v 20 Quóniam mihi quidem pacífice loquebántur: * et in iracúndia terræ loquéntes, dolos cogitábant.
\q1 \v 21 Et dilatavérunt super me os suum: * dixérunt: Euge, euge, vidérunt óculi nostri.
\q1 \v 22 Vidísti, Dómine, ne síleas: * Dómine, ne discédas a me.
\q1 \v 23 Exsúrge et inténde judício meo: * Deus meus, et Dóminus meus in causam meam.
\q1 \v 24 Júdica me secúndum justítiam tuam, Dómine, Deus meus, * et non supergáudeant mihi.
\q1 \v 25 Non dicant in córdibus suis: Euge, euge, ánimæ nostræ: * nec dicant: Devorávimus eum.
\q1 \v 26 Erubéscant et revereántur simul, * qui gratulántur malis meis.
\q1 Induántur confusióne et reveréntia * qui magna loquúntur super me.
\q1 \v 27 Exsúltent et læténtur qui volunt justítiam meam: * et dicant semper: Magnificétur Dóminus qui volunt pacem servi ejus.
\q1 \v 28 Et lingua mea meditábitur justítiam tuam, * tota die laudem tuam.
\c 35
\q1 \v 2 Dixit injústus ut delínquat in semetípso: * non est timor Dei ante óculos ejus.
\q1 \v 3 Quóniam dolóse egit in conspéctu ejus: * ut inveniátur iníquitas ejus ad ódium.
\q1 \v 4 Verba oris ejus iníquitas, et dolus: * nóluit intellégere ut bene ágeret.
\q1 \v 5 Iniquitátem meditátus est in cubíli suo: * ástitit omni viæ non bonæ, malítiam autem non odívit.
\q1 \v 6 Dómine, in cælo misericórdia tua: * et véritas tua usque ad nubes.
\q1 \v 7 Justítia tua sicut montes Dei: * judícia tua abýssus multa.
\q1 Hómines, et juménta salvábis, Dómine: * quemádmodum multiplicásti misericórdiam tuam, Deus.
\q1 \v 8 Fílii autem hóminum, * in tégmine alárum tuárum sperábunt.
\q1 \v 9 Inebriabúntur ab ubertáte domus tuæ: * et torrénte voluptátis tuæ potábis eos.
\q1 \v 10 Quóniam apud te est fons vitæ: * et in lúmine tuo vidébimus lumen.
\q1 \v 11 Præténde misericórdiam tuam sciéntibus te, * et justítiam tuam his, qui recto sunt corde.
\q1 \v 12 Non véniat mihi pes supérbiæ: * et manus peccatóris non móveat me.
\q1 \v 13 Ibi cecidérunt qui operántur iniquitátem: * expúlsi sunt, nec potuérunt stare.
\c 36
\q1 \v 1 Noli æmulári in malignántibus: * neque zeláveris faciéntes iniquitátem.
\q1 \v 2 Quóniam tamquam fænum velóciter aréscent: * et quemádmodum ólera herbárum cito décident.
\q1 \v 3 Spera in Dómino, et fac bonitátem: * et inhábita terram, et pascéris in divítiis ejus.
\q1 \v 4 Delectáre in Dómino: * et dabit tibi petitiónes cordis tui.
\q1 \v 5 Revéla Dómino viam tuam, et spera in eo: * et ipse fáciet.
\q1 \v 6 Et edúcet quasi lumen justítiam tuam: et judícium tuum tamquam merídiem: * súbditus esto Dómino, et ora eum.
\q1 \v 7 Noli æmulári in eo, qui prosperátur in via sua: * in hómine faciénte injustítias.
\q1 \v 8 Désine ab ira, et derelínque furórem: * noli æmulári ut malignéris.
\q1 \v 9 Quóniam qui malignántur, exterminabúntur: * sustinéntes autem Dóminum, ipsi hereditábunt terram.
\q1 \v 10 Et adhuc pusíllum, et non erit peccátor: * et quæres locum ejus et non invénies.
\q1 \v 11 Mansuéti autem hereditábunt terram: * et delectabúntur in multitúdine pacis.
\q1 \v 12 Observábit peccátor justum: * et stridébit super eum déntibus suis.
\q1 \v 13 Dóminus autem irridébit eum: * quóniam próspicit quod véniet dies ejus.
\q1 \v 14 Gládium evaginavérunt peccatóres: * intendérunt arcum suum,
\q1 Ut deíciant páuperem et ínopem: * ut trucídent rectos corde.
\q1 \v 15 Gládius eórum intret in corda ipsórum: * et arcus eórum confringátur.
\q1 \v 16 Mélius est módicum justo, * super divítias peccatórum multas.
\q1 \v 17 Quóniam brácchia peccatórum conteréntur: * confírmat autem justos Dóminus.
\q1 \v 18 Novit Dóminus dies immaculatórum: * et heréditas eórum in ætérnum erit.
\q1 \v 19 Non confundéntur in témpore malo, et in diébus famis saturabúntur: * quia peccatóres períbunt.
\q1 \v 20 Inimíci vero Dómini mox ut honorificáti fúerint et exaltáti: * deficiéntes, quemádmodum fumus defícient.
\q1 \v 21 Mutuábitur peccátor, et non solvet: * justus autem miserétur et tríbuet.
\q1 \v 22 Quia benedicéntes ei hereditábunt terram: * maledicéntes autem ei disperíbunt.
\q1 \v 23 Apud Dóminum gressus hóminis dirigéntur: * et viam ejus volet.
\q1 \v 24 Cum cecíderit non collidétur: * quia Dóminus suppónit manum suam.
\q1 \v 25 Júnior fui, étenim sénui: * et non vidi justum derelíctum, nec semen ejus quærens panem.
\q1 \v 26 Tota die miserétur et cómmodat: * et semen illíus in benedictióne erit.
\q1 \v 27 Declína a malo, et fac bonum: * et inhábita in sǽculum sǽculi.
\q1 \v 28 Quia Dóminus amat judícium, et non derelínquet sanctos suos: * in ætérnum conservabúntur.
\q1 Injústi puniéntur: * et semen impiórum períbit.
\q1 \v 29 Justi autem hereditábunt terram: * et inhabitábunt in sǽculum sǽculi super eam.
\q1 \v 30 Os justi meditábitur sapiéntiam, * et lingua ejus loquétur judícium.
\q1 \v 31 Lex Dei ejus in corde ipsíus, * et non supplantabúntur gressus ejus.
\q1 \v 32 Consíderat peccátor justum: * et quærit mortificáre eum.
\q1 \v 33 Dóminus autem non derelínquet eum in mánibus ejus: * nec damnábit eum, cum judicábitur illi.
\q1 \v 34 Exspécta Dóminum, et custódi viam ejus: et exaltábit te ut hereditáte cápias terram: * cum períerint peccatóres vidébis.
\q1 \v 35 Vidi ímpium superexaltátum, * et elevátum sicut cedros Líbani.
\q1 \v 36 Et transívi, et ecce non erat: * et quæsívi eum, et non est invéntus locus ejus.
\q1 \v 37 Custódi innocéntiam, et vide æquitátem: * quóniam sunt relíquiæ hómini pacífico.
\q1 \v 38 Injústi autem disperíbunt simul: * relíquiæ impiórum interíbunt.
\q1 \v 39 Salus autem justórum a Dómino: * et protéctor eórum in témpore tribulatiónis.
\q1 \v 40 Et adjuvábit eos Dóminus et liberábit eos: * et éruet eos a peccatóribus, et salvábit eos: quia speravérunt in eo.
\c 37
\q1 \v 2 Dómine, ne in furóre tuo árguas me, * neque in ira tua corrípias me.
\q1 \v 3 Quóniam sagíttæ tuæ infíxæ sunt mihi: * et confirmásti super me manum tuam.
\q1 \v 4 Non est sánitas in carne mea a fácie iræ tuæ: * non est pax óssibus meis a fácie peccatórum meórum.
\q1 \v 5 Quóniam iniquitátes meæ supergréssæ sunt caput meum: * et sicut onus grave gravátæ sunt super me.
\q1 \v 6 Putruérunt et corrúptæ sunt cicatríces meæ, * a fácie insipiéntiæ meæ.
\q1 \v 7 Miser factus sum, et curvátus sum usque in finem: * tota die contristátus ingrediébar.
\q1 \v 8 Quóniam lumbi mei impléti sunt illusiónibus: * et non est sánitas in carne mea.
\q1 \v 9 Afflíctus sum, et humiliátus sum nimis: * rugiébam a gémitu cordis mei.
\q1 \v 10 Dómine, ante te omne desidérium meum: * et gémitus meus a te non est abscónditus.
\q1 \v 11 Cor meum conturbátum est, derelíquit me virtus mea: * et lumen oculórum meórum, et ipsum non est mecum.
\q1 \v 12 Amíci mei, et próximi mei * advérsum me appropinquavérunt, et stetérunt.
\q1 Et qui juxta me erant, de longe stetérunt: * et vim faciébant qui quærébant ánimam meam.
\q1 \v 13 Et qui inquirébant mala mihi, locúti sunt vanitátes: * et dolos tota die meditabántur.
\q1 \v 14 Ego autem tamquam surdus non audiébam: * et sicut mutus non apériens os suum.
\q1 \v 15 Et factus sum sicut homo non áudiens: * et non habens in ore suo redargutiónes.
\q1 \v 16 Quóniam in te, Dómine, sperávi: * tu exáudies me, Dómine, Deus meus.
\q1 \v 17 Quia dixi: Nequándo supergáudeant mihi inimíci mei: * et dum commovéntur pedes mei, super me magna locúti sunt.
\q1 \v 18 Quóniam ego in flagélla parátus sum: * et dolor meus in conspéctu meo semper.
\q1 \v 19 Quóniam iniquitátem meam annuntiábo: * et cogitábo pro peccáto meo.
\q1 \v 20 Inimíci autem mei vivunt, et confirmáti sunt super me: * et multiplicáti sunt qui odérunt me iníque.
\q1 \v 21 Qui retríbuunt mala pro bonis, detrahébant mihi: * quóniam sequébar bonitátem.
\q1 \v 22 Ne derelínquas me, Dómine, Deus meus: * ne discésseris a me.
\q1 \v 23 Inténde in adjutórium meum, * Dómine, Deus, salútis meæ.
\c 38
\q1 \v 2 Dixi: Custódiam vias meas: * ut non delínquam in lingua mea.
\q1 Pósui ori meo custódiam, * cum consísteret peccátor advérsum me.
\q1 \v 3 Obmútui, et humiliátus sum, et sílui a bonis: * et dolor meus renovátus est.
\q1 \v 4 Concáluit cor meum intra me: * et in meditatióne mea exardéscet ignis.
\q1 \v 5 Locútus sum in lingua mea: * Notum fac mihi, Dómine, finem meum.
\q1 Et númerum diérum meórum quis est: * ut sciam quid desit mihi.
\q1 \v 6 Ecce mensurábiles posuísti dies meos: * et substántia mea tamquam níhilum ante te.
\q1 Verúmtamen univérsa vánitas, * omnis homo vivens.
\q1 \v 7 Verúmtamen in imágine pertránsit homo: * sed et frustra conturbátur.
\q1 Thesaurízat: * et ignórat cui congregábit ea.
\q1 \v 8 Et nunc quæ est exspectátio mea? Nonne Dóminus? * Et substántia mea apud te est.
\q1 \v 9 Ab ómnibus iniquitátibus meis érue me: * oppróbrium insipiénti dedísti me.
\q1 \v 10 Obmútui, et non apérui os meum, quóniam tu fecísti: * ámove a me plagas tuas.
\q1 \v 12 A fortitúdine manus tuæ ego deféci in increpatiónibus: * propter iniquitátem corripuísti hóminem.
\q1 Et tabéscere fecísti sicut aráneam ánimam ejus: * verúmtamen vane conturbátur omnis homo.
\q1 \v 13 Exáudi oratiónem meam, Dómine, et deprecatiónem meam: * áuribus pércipe lácrimas meas.
\q1 Ne síleas: quóniam ádvena ego sum apud te, et peregrínus, * sicut omnes patres mei.
\q1 \v 14 Remítte mihi, ut refrígerer priúsquam ábeam, * et ámplius non ero.
\c 39
\q1 \v 2 Exspéctans exspectávi Dóminum, * et inténdit mihi.
\q1 \v 3 Et exaudívit preces meas: * et edúxit me de lacu misériæ, et de luto fæcis.
\q1 Et státuit super petram pedes meos: * et diréxit gressus meos.
\q1 \v 4 Et immísit in os meum cánticum novum, * carmen Deo nostro.
\q1 Vidébunt multi, et timébunt: * et sperábunt in Dómino.
\q1 \v 5 Beátus vir, cujus est nomen Dómini spes ejus: * et non respéxit in vanitátes et insánias falsas.
\q1 \v 6 Multa fecísti tu, Dómine, Deus meus, mirabília tua: * et cogitatiónibus tuis non est qui símilis sit tibi.
\q1 Annuntiávi et locútus sum: * multiplicáti sunt super númerum.
\q1 \v 7 Sacrifícium et oblatiónem noluísti: * aures autem perfecísti mihi.
\q1 Holocáustum et pro peccáto non postulásti: * tunc dixi: Ecce, vénio.
\q1 \v 8 In cápite libri scriptum est de me ut fácerem voluntátem tuam: * Deus meus, vólui, et legem tuam in médio cordis mei.
\q1 \v 10 Annuntiávi justítiam tuam in ecclésia magna, * ecce, lábia mea non prohibébo: Dómine, tu scisti.
\q1 \v 11 Justítiam tuam non abscóndi in corde meo: * veritátem tuam et salutáre tuum dixi.
\q1 Non abscóndi misericórdiam tuam et veritátem tuam * a concílio multo.
\q1 \v 12 Tu autem, Dómine, ne longe fácias miseratiónes tuas a me: * misericórdia tua et véritas tua semper suscepérunt me.
\q1 \v 13 Quóniam circumdedérunt me mala, quorum non est númerus: * comprehendérunt me iniquitátes meæ, et non pótui ut vidérem.
\q1 Multiplicátæ sunt super capíllos cápitis mei: * et cor meum derelíquit me.
\q1 \v 14 Compláceat tibi, Dómine, ut éruas me: * Dómine, ad adjuvándum me réspice.
\q1 \v 15 Confundántur et revereántur simul, qui quærunt ánimam meam, * ut áuferant eam.
\q1 Convertántur retrórsum, et revereántur, * qui volunt mihi mala.
\q1 \v 16 Ferant conféstim confusiónem suam, * qui dicunt mihi: Euge, euge.
\q1 \v 17 Exsúltent et læténtur super te omnes quæréntes te: * et dicant semper: Magnificétur Dóminus: qui díligunt salutáre tuum.
\q1 \v 18 Ego autem mendícus sum, et pauper: * Dóminus sollícitus est mei.
\q1 Adjútor meus, et protéctor meus tu es: * Deus meus, ne tardáveris.
\c 40
\q1 \v 2 Beátus qui intéllegit super egénum, et páuperem: * in die mala liberábit eum Dóminus.
\q1 \v 3 Dóminus consérvet eum, et vivíficet eum, et beátum fáciat eum in terra: * et non tradat eum in ánimam inimicórum ejus.
\q1 \v 4 Dóminus opem ferat illi super lectum dolóris ejus: * univérsum stratum ejus versásti in infirmitáte ejus.
\q1 \v 5 Ego dixi: Dómine, miserére mei: * sana ánimam meam, quia peccávi tibi.
\q1 \v 6 Inimíci mei dixérunt mala mihi: * Quando moriétur, et períbit nomen ejus?
\q1 \v 7 Et si ingrediebátur ut vidéret, vana loquebátur: * cor ejus congregávit iniquitátem sibi.
\q1 Egrediebátur foras, * et loquebátur in idípsum.
\q1 \v 8 Advérsum me susurrábant omnes inimíci mei: * advérsum me cogitábant mala mihi.
\q1 \v 9 Verbum iníquum constituérunt advérsum me: * Numquid qui dormit non adíciet ut resúrgat?
\q1 \v 10 Étenim homo pacis meæ, in quo sperávi: * qui edébat panes meos, magnificávit super me supplantatiónem.
\q1 \v 11 Tu autem, Dómine, miserére mei, et resúscita me: * et retríbuam eis.
\q1 \v 12 In hoc cognóvi quóniam voluísti me: * quóniam non gaudébit inimícus meus super me.
\q1 \v 13 Me autem propter innocéntiam suscepísti: * et confirmásti me in conspéctu tuo in ætérnum.
\q1 \v 14 Benedíctus Dóminus, Deus Israël, a sǽculo et usque in sǽculum: * fiat, fiat.
\c 41
\q1 \v 2 Quemádmodum desíderat cervus ad fontes aquárum: * ita desíderat ánima mea ad te, Deus.
\q1 \v 3 Sitívit ánima mea ad Deum fortem vivum: * quando véniam, et apparébo ante fáciem Dei?
\q1 \v 4 Fuérunt mihi lácrimæ meæ panes die ac nocte: * dum dícitur mihi cotídie: Ubi est Deus tuus?
\q1 \v 5 Hæc recordátus sum, et effúdi in me ánimam meam: * quóniam transíbo in locum tabernáculi admirábilis, usque ad domum Dei.
\q1 In voce exsultatiónis, et confessiónis: * sonus epulántis.
\q1 \v 6 Quare tristis es, ánima mea? * et quare contúrbas me?
\q1 Spera in Deo, quóniam adhuc confitébor illi: * salutáre vultus mei, et Deus meus.
\q1 \v 7 Ad meípsum ánima mea conturbáta est: * proptérea memor ero tui de terra Jordánis, et Hermóniim a monte módico.
\q1 \v 8 Abýssus abýssum ínvocat, * in voce cataractárum tuárum.
\q1 Ómnia excélsa tua, et fluctus tui * super me transiérunt.
\q1 \v 9 In die mandávit Dóminus misericórdiam suam: * et nocte cánticum ejus.
\q1 Apud me orátio Deo vitæ meæ, * dicam Deo: Suscéptor meus es.
\q1 \v 10 Quare oblítus es mei? * et quare contristátus incédo, dum afflígit me inimícus?
\q1 \v 11 Dum confringúntur ossa mea, * exprobravérunt mihi qui tríbulant me inimíci mei.
\q1 Dum dicunt mihi per síngulos dies: Ubi est Deus tuus? * quare tristis es, ánima mea? et quare contúrbas me?
\q1 \v 12 Spera in Deo, quóniam adhuc confitébor illi: * salutáre vultus mei, et Deus meus.
\c 42
\q1 \v 1 Júdica me, Deus, et discérne causam meam de gente non sancta, * ab hómine iníquo, et dolóso érue me.
\q1 \v 2 Quia tu es, Deus, fortitúdo mea: * quare me repulísti? et quare tristis incédo, dum afflígit me inimícus?
\q1 \v 3 Emítte lucem tuam et veritátem tuam: * ipsa me deduxérunt, et adduxérunt in montem sanctum tuum, et in tabernácula tua.
\q1 \v 4 Et introíbo ad altáre Dei: * ad Deum, qui lætíficat juventútem meam.
\q1 \v 5 Confitébor tibi in cíthara, Deus, Deus meus: * quare tristis es, ánima mea? et quare contúrbas me?
\q1 \v 6 Spera in Deo, quóniam adhuc confitébor illi: * salutáre vultus mei, et Deus meus.
\c 43
\q1 \v 2 Deus áuribus nostris audívimus: * patres nostri annuntiavérunt nobis.
\q1 Opus, quod operátus es in diébus eórum, * et in diébus antíquis.
\q1 \v 3 Manus tua gentes dispérdidit, et plantásti eos: * afflixísti pópulos, et expulísti eos.
\q1 \v 4 Nec enim in gládio suo possedérunt terram, * et brácchium eórum non salvávit eos:
\q1 Sed déxtera tua, et brácchium tuum, et illuminátio vultus tui: * quóniam complacuísti in eis.
\q1 \v 5 Tu es ipse Rex meus et Deus meus: * qui mandas salútes Jacob.
\q1 \v 6 In te inimícos nostros ventilábimus cornu: * et in nómine tuo spernémus insurgéntes in nobis.
\q1 \v 7 Non enim in arcu meo sperábo: * et gládius meus non salvábit me.
\q1 \v 8 Salvásti enim nos de affligéntibus nos: * et odiéntes nos confudísti.
\q1 \v 9 In Deo laudábimur tota die: * et in nómine tuo confitébimur in sǽculum.
\q1 \v 10 Nunc autem repulísti et confudísti nos: * et non egrediéris, Deus, in virtútibus nostris.
\q1 \v 11 Avertísti nos retrórsum post inimícos nostros: * et qui odérunt nos, diripiébant sibi.
\q1 \v 12 Dedísti nos tamquam oves escárum: * et in géntibus dispersísti nos.
\q1 \v 13 Vendidísti pópulum tuum sine prétio: * et non fuit multitúdo in commutatiónibus eórum.
\q1 \v 14 Posuísti nos oppróbrium vicínis nostris, * subsannatiónem et derísum his, qui sunt in circúitu nostro.
\q1 \v 15 Posuísti nos in similitúdinem géntibus: * commotiónem cápitis in pópulis.
\q1 \v 16 Tota die verecúndia mea contra me est, * et confúsio faciéi meæ coopéruit me.
\q1 \v 17 A voce exprobrántis, et obloquéntis: * a fácie inimíci, et persequéntis.
\q1 \v 18 Hæc ómnia venérunt super nos, nec oblíti sumus te: * et iníque non égimus in testaménto tuo.
\q1 \v 19 Et non recéssit retro cor nostrum: * et declinásti sémitas nostras a via tua:
\q1 \v 20 Quóniam humiliásti nos in loco afflictiónis, * et coopéruit nos umbra mortis.
\q1 \v 21 Si oblíti sumus nomen Dei nostri, * et si expándimus manus nostras ad deum aliénum:
\q1 \v 22 Nonne Deus requíret ista? * ipse enim novit abscóndita cordis.
\q1 Quóniam propter te mortificámur tota die: * æstimáti sumus sicut oves occisiónis.
\q1 \v 23 Exsúrge, quare obdórmis, Dómine? * exsúrge, et ne repéllas in finem.
\q1 \v 24 Quare fáciem tuam avértis, * oblivísceris inópiæ nostræ, et tribulatiónis nostræ?
\q1 \v 25 Quóniam humiliáta est in púlvere ánima nostra: * conglutinátus est in terra venter noster.
\q1 \v 26 Exsúrge, Dómine, ádjuva nos: * et rédime nos propter nomen tuum.
\c 44
\q1 \v 2 Eructávit cor meum verbum bonum: * dico ego ópera mea Regi.
\q1 Lingua mea cálamus scribæ: * velóciter scribéntis.
\q1 \v 3 Speciósus forma præ fíliis hóminum, † diffúsa est grátia in lábiis tuis: * proptérea benedíxit te Deus in ætérnum.
\q1 \v 4 Accíngere gládio tuo super femur tuum, * potentíssime.
\q1 \v 5 Spécie tua et pulchritúdine tua: * inténde, próspere procéde, et regna.
\q1 Propter veritátem, et mansuetúdinem, et justítiam: * et dedúcet te mirabíliter déxtera tua.
\q1 \v 6 Sagíttæ tuæ acútæ, pópuli sub te cadent: * in corda inimicórum Regis.
\q1 \v 7 Sedes tua, Deus, in sǽculum sǽculi: * virga directiónis virga regni tui.
\q1 \v 8 Dilexísti justítiam, et odísti iniquitátem: * proptérea unxit te Deus, Deus tuus, óleo lætítiæ præ consórtibus tuis.
\q1 \v 9 Myrrha, et gutta, et cásia a vestiméntis tuis, a dómibus ebúrneis: * ex quibus delectavérunt te (10a) fíliæ regum in honóre tuo.
\q1 \v 10 Ástitit regína a dextris tuis in vestítu deauráto: * circúmdata varietáte.
\q1 \v 11 Audi fília, et vide, et inclína aurem tuam: * et oblivíscere pópulum tuum et domum patris tui.
\q1 \v 12 Et concupíscet Rex decórem tuum: * quóniam ipse est Dóminus Deus tuus, et adorábunt eum.
\q1 \v 13 Et fíliæ Tyri in munéribus * vultum tuum deprecabúntur: omnes dívites plebis.
\q1 \v 14 Omnis glória ejus fíliæ Regis ab intus, * in fímbriis áureis (15a) circumamícta varietátibus.
\q1 \v 15 Adducéntur Regi vírgines post eam: * próximæ ejus afferéntur tibi.
\q1 \v 16 Afferéntur in lætítia et exsultatióne: * adducéntur in templum Regis.
\q1 \v 17 Pro pátribus tuis nati sunt tibi fílii: * constítues eos príncipes super omnem terram.
\q1 \v 18 Mémores erunt nóminis tui: * in omni generatióne et generatiónem.
\q1 Proptérea pópuli confitebúntur tibi in ætérnum: * et in sǽculum sǽculi.
\c 45
\q1 \v 2 Deus noster refúgium, et virtus: * adjútor in tribulatiónibus, quæ invenérunt nos nimis.
\q1 \v 3 Proptérea non timébimus dum turbábitur terra: * et transferéntur montes in cor maris.
\q1 \v 4 Sonuérunt, et turbátæ sunt aquæ eórum: * conturbáti sunt montes in fortitúdine ejus.
\q1 \v 5 Flúminis ímpetus lætíficat civitátem Dei: * sanctificávit tabernáculum suum Altíssimus.
\q1 \v 6 Deus in médio ejus, non commovébitur: * adjuvábit eam Deus mane dilúculo.
\q1 \v 7 Conturbátæ sunt gentes, et inclináta sunt regna: * dedit vocem suam, mota est terra.
\q1 \v 8 Dóminus virtútum nobíscum: * suscéptor noster Deus Jacob.
\q1 \v 9 Veníte, et vidéte ópera Dómini, quæ pósuit prodígia super terram: * áuferens bella usque ad finem terræ.
\q1 \v 10 Arcum cónteret, et confrínget arma: * et scuta combúret igni.
\q1 \v 11 Vacáte, et vidéte quóniam ego sum Deus: * exaltábor in géntibus, et exaltábor in terra.
\q1 \v 12 Dóminus virtútum nobíscum: * suscéptor noster Deus Jacob.
\c 46
\q1 \v 2 Omnes gentes, pláudite mánibus: * jubiláte Deo in voce exsultatiónis.
\q1 \v 3 Quóniam Dóminus excélsus, terríbilis: * Rex magnus super omnem terram.
\q1 \v 4 Subjécit pópulos nobis: * et gentes sub pédibus nostris.
\q1 \v 5 Elégit nobis hereditátem suam: * spéciem Jacob, quam diléxit.
\q1 \v 6 Ascéndit Deus in júbilo: * et Dóminus in voce tubæ.
\q1 \v 7 Psállite Deo nostro, psállite: * psállite Regi nostro, psállite.
\q1 \v 8 Quóniam Rex omnis terræ Deus: * psállite sapiénter.
\q1 \v 9 Regnábit Deus super gentes: * Deus sedet super sedem sanctam suam.
\q1 \v 10 Príncipes populórum congregáti sunt cum Deo Ábraham: * quóniam dii fortes terræ veheménter eleváti sunt.
\c 47
\q1 \v 2 Magnus Dóminus, et laudábilis nimis * in civitáte Dei nostri, in monte sancto ejus.
\q1 \v 3 Fundátur exsultatióne univérsæ terræ mons Sion, * látera Aquilónis, cívitas Regis magni.
\q1 \v 4 Deus in dómibus ejus cognoscétur: * cum suscípiet eam.
\q1 \v 5 Quóniam ecce reges terræ congregáti sunt: * convenérunt in unum.
\q1 \v 6 Ipsi vidéntes sic admiráti sunt, conturbáti sunt, commóti sunt: * tremor apprehéndit eos.
\q1 \v 7 Ibi dolóres ut parturiéntis: * in spíritu veheménti cónteres naves Tharsis.
\q1 \v 9 Sicut audívimus, sic vídimus in civitáte Dómini virtútum, in civitáte Dei nostri: * Deus fundávit eam in ætérnum.
\q1 \v 10 Suscépimus, Deus, misericórdiam tuam, * in médio templi tui.
\q1 \v 11 Secúndum nomen tuum, Deus, sic et laus tua in fines terræ: * justítia plena est déxtera tua.
\q1 \v 12 Lætétur mons Sion, et exsúltent fíliæ Judæ: * propter judícia tua, Dómine.
\q1 \v 13 Circúmdate Sion, et complectímini eam: * narráte in túrribus ejus.
\q1 \v 14 Pónite corda vestra in virtúte ejus: * et distribúite domos ejus, ut enarrétis in progénie áltera.
\q1 \v 15 Quóniam hic est Deus, Deus noster in ætérnum et in sǽculum sǽculi: * ipse reget nos in sǽcula.
\c 48
\q1 \v 2 Audíte hæc, omnes gentes: * áuribus percípite omnes, qui habitátis orbem:
\q1 \v 3 Quique terrígenæ, et fílii hóminum: * simul in unum dives et pauper.
\q1 \v 4 Os meum loquétur sapiéntiam: * et meditátio cordis mei prudéntiam.
\q1 \v 5 Inclinábo in parábolam aurem meam: * apériam in psaltério propositiónem meam.
\q1 \v 6 Cur timébo in die mala? * iníquitas calcánei mei circúmdabit me:
\q1 \v 7 Qui confídunt in virtúte sua: * et in multitúdine divitiárum suárum gloriántur.
\q1 \v 8 Frater non rédimit, rédimet homo: * non dabit Deo placatiónem suam.
\q1 \v 9 Et prétium redemptiónis ánimæ suæ: * et laborábit in ætérnum, et vivet adhuc in finem.
\q1 \v 11 Non vidébit intéritum, cum víderit sapiéntes moriéntes: * simul insípiens, et stultus períbunt.
\q1 Et relínquent aliénis divítias suas: * et sepúlcra eórum domus illórum in ætérnum.
\q1 \v 12 Tabernácula eórum in progénie et progénie: * vocavérunt nómina sua in terris suis.
\q1 \v 13 Et homo, cum in honóre esset, non intelléxit: * comparátus est juméntis insipiéntibus, et símilis factus est illis.
\q1 \v 14 Hæc via illórum scándalum ipsis: * et póstea in ore suo complacébunt.
\q1 \v 15 Sicut oves in inférno pósiti sunt: * mors depáscet eos.
\q1 Et dominabúntur eórum justi in matutíno: * et auxílium eórum veteráscet in inférno a glória eórum.
\q1 \v 16 Verúmtamen Deus rédimet ánimam meam de manu ínferi: * cum accéperit me.
\q1 \v 17 Ne timúeris, cum dives factus fúerit homo: * et cum multiplicáta fúerit glória domus ejus.
\q1 \v 18 Quóniam cum interíerit, non sumet ómnia: * neque descéndet cum eo glória ejus.
\q1 \v 19 Quia ánima ejus in vita ipsíus benedicétur: * confitébitur tibi cum beneféceris ei.
\q1 \v 20 Introíbit usque in progénies patrum suórum: * et usque in ætérnum non vidébit lumen.
\q1 \v 21 Homo, cum in honóre esset, non intelléxit: * comparátus est juméntis insipiéntibus, et símilis factus est illis.
\c 49
\q1 \v 1 Deus deórum, Dóminus locútus est: * et vocávit terram,
\q1 A solis ortu usque ad occásum: * ex Sion spécies decóris ejus.
\q1 \v 3 Deus maniféste véniet: * Deus noster et non silébit.
\q1 Ignis in conspéctu ejus exardéscet: * et in circúitu ejus tempéstas válida.
\q1 \v 4 Advocábit cælum desúrsum: * et terram discérnere pópulum suum.
\q1 \v 5 Congregáte illi sanctos ejus: * qui órdinant testaméntum ejus super sacrifícia.
\q1 \v 6 Et annuntiábunt cæli justítiam ejus: * quóniam Deus judex est.
\q1 \v 7 Audi, pópulus meus, et loquar: Israël, et testificábor tibi: * Deus, Deus tuus ego sum.
\q1 \v 8 Non in sacrifíciis tuis árguam te: * holocáusta autem tua in conspéctu meo sunt semper.
\q1 \v 9 Non accípiam de domo tua vítulos: * neque de grégibus tuis hircos.
\q1 \v 10 Quóniam meæ sunt omnes feræ silvárum: * juménta in móntibus et boves.
\q1 \v 11 Cognóvi ómnia volatília cæli: * et pulchritúdo agri mecum est.
\q1 \v 12 Si esuríero, non dicam tibi: * meus est enim orbis terræ, et plenitúdo ejus.
\q1 \v 13 Numquid manducábo carnes taurórum? * aut sánguinem hircórum potábo?
\q1 \v 14 Ímmola Deo sacrifícium laudis: * et redde Altíssimo vota tua.
\q1 \v 15 Et ínvoca me in die tribulatiónis: * éruam te, et honorificábis me.
\q1 \v 16 Peccatóri autem dixit Deus: * Quare tu enárras justítias meas, et assúmis testaméntum meum per os tuum?
\q1 \v 17 Tu vero odísti disciplínam: * et projecísti sermónes meos retrórsum:
\q1 \v 18 Si vidébas furem, currébas cum eo: * et cum adúlteris portiónem tuam ponébas.
\q1 \v 19 Os tuum abundávit malítia: * et lingua tua concinnábat dolos.
\q1 \v 20 Sedens advérsus fratrem tuum loquebáris, et advérsus fílium matris tuæ ponébas scándalum: * hæc fecísti, et tácui.
\q1 \v 21 Existimásti, iníque, quod ero tui símilis: * árguam te, et státuam contra fáciem tuam.
\q1 \v 22 Intellégite hæc, qui obliviscímini Deum: * nequándo rápiat, et non sit qui erípiat.
\q1 \v 23 Sacrifícium laudis honorificábit me: * et illic iter, quo osténdam illi salutáre Dei.
\c 50
\q1 \v 3 Miserére mei, Deus, * secúndum magnam misericórdiam tuam.
\q1 Et secúndum multitúdinem miseratiónum tuárum, * dele iniquitátem meam.
\q1 \v 4 Ámplius lava me ab iniquitáte mea: * et a peccáto meo munda me.
\q1 \v 5 Quóniam iniquitátem meam ego cognósco: * et peccátum meum contra me est semper.
\q1 \v 6 Tibi soli peccávi, et malum coram te feci: * ut justificéris in sermónibus tuis, et vincas cum judicáris.
\q1 \v 7 Ecce enim, in iniquitátibus concéptus sum: * et in peccátis concépit me mater mea.
\q1 \v 8 Ecce enim, veritátem dilexísti: * incérta et occúlta sapiéntiæ tuæ manifestásti mihi.
\q1 \v 9 Aspérges me hyssópo, et mundábor: * lavábis me, et super nivem dealbábor.
\q1 \v 10 Audítui meo dabis gáudium et lætítiam: * et exsultábunt ossa humiliáta.
\q1 \v 11 Avérte fáciem tuam a peccátis meis: * et omnes iniquitátes meas dele.
\q1 \v 12 Cor mundum crea in me, Deus: * et spíritum rectum ínnova in viscéribus meis.
\q1 \v 13 Ne proícias me a fácie tua: * et spíritum sanctum tuum ne áuferas a me.
\q1 \v 14 Redde mihi lætítiam salutáris tui: * et spíritu principáli confírma me.
\q1 \v 15 Docébo iníquos vias tuas: * et ímpii ad te converténtur.
\q1 \v 16 Líbera me de sanguínibus, Deus, Deus salútis meæ: * et exsultábit lingua mea justítiam tuam.
\q1 \v 17 Dómine, lábia mea apéries: * et os meum annuntiábit laudem tuam.
\q1 \v 18 Quóniam si voluísses sacrifícium, dedíssem útique: * holocáustis non delectáberis.
\q1 \v 19 Sacrifícium Deo spíritus contribulátus: * cor contrítum, et humiliátum, Deus, non despícies.
\q1 \v 20 Benígne fac, Dómine, in bona voluntáte tua Sion: * ut ædificéntur muri Jerúsalem.
\q1 \v 21 Tunc acceptábis sacrifícium justítiæ, oblatiónes, et holocáusta: * tunc impónent super altáre tuum vítulos.
\c 51
\q1 \v 3 Quid gloriáris in malítia, * qui potens es in iniquitáte?
\q1 \v 4 Tota die injustítiam cogitávit lingua tua: * sicut novácula acúta fecísti dolum.
\q1 \v 5 Dilexísti malítiam super benignitátem: * iniquitátem magis quam loqui æquitátem.
\q1 \v 6 Dilexísti ómnia verba præcipitatiónis, * lingua dolósa.
\q1 \v 7 Proptérea Deus déstruet te in finem, * evéllet te, et emigrábit te de tabernáculo tuo: et radícem tuam de terra vivéntium.
\q1 \v 8 Vidébunt justi, et timébunt, et super eum ridébunt, et dicent: * Ecce homo, qui non pósuit Deum adjutórem suum:
\q1 \v 9 Sed sperávit in multitúdine divitiárum suárum: * et præváluit in vanitáte sua.
\q1 \v 10 Ego autem, sicut olíva fructífera in domo Dei, * sperávi in misericórdia Dei in ætérnum: et in sǽculum sǽculi.
\q1 \v 11 Confitébor tibi in sǽculum, quia fecísti: * et exspectábo nomen tuum, quóniam bonum est in conspéctu sanctórum tuórum.
\c 52
\q1 \v 1 Dixit insípiens in corde suo: * Non est Deus.
\q1 \v 2 Corrúpti sunt, et abominábiles facti sunt in iniquitátibus: * non est qui fáciat bonum.
\q1 \v 3 Deus de cælo prospéxit super fílios hóminum: * ut vídeat si est intéllegens, aut requírens Deum.
\q1 \v 4 Omnes declinavérunt, simul inútiles facti sunt: * non est qui fáciat bonum, non est usque ad unum.
\q1 \v 5 Nonne scient omnes qui operántur iniquitátem, * qui dévorant plebem meam ut cibum panis?
\q1 \v 6 Deum non invocavérunt: * illic trepidavérunt timóre, ubi non erat timor.
\q1 Quóniam Deus dissipávit ossa eórum qui homínibus placent: * confúsi sunt, quóniam Deus sprevit eos.
\q1 \v 7 Quis dabit ex Sion salutáre Israël? * cum convérterit Deus captivitátem plebis suæ, exsultábit Jacob, et lætábitur Israël.
\c 53
\q1 \v 3 Deus, in nómine tuo salvum me fac: * et in virtúte tua júdica me.
\q1 \v 4 Deus, exáudi oratiónem meam: * áuribus pércipe verba oris mei.
\q1 \v 5 Quóniam aliéni insurrexérunt advérsum me, et fortes quæsiérunt ánimam meam: * et non proposuérunt Deum ante conspéctum suum.
\q1 \v 6 Ecce enim, Deus ádjuvat me: * et Dóminus suscéptor est ánimæ meæ.
\q1 \v 7 Avérte mala inimícis meis: * et in veritáte tua dispérde illos.
\q1 \v 8 Voluntárie sacrificábo tibi, * et confitébor nómini tuo, Dómine: quóniam bonum est:
\q1 \v 9 Quóniam ex omni tribulatióne eripuísti me: * et super inimícos meos despéxit óculus meus.
\c 54
\q1 \v 2 Exáudi, Deus, oratiónem meam, et ne despéxeris deprecatiónem meam: * inténde mihi, et exáudi me.
\q1 \v 3 Contristátus sum in exercitatióne mea: * et conturbátus sum a voce inimíci, et a tribulatióne peccatóris.
\q1 \v 4 Quóniam declinavérunt in me iniquitátes: * et in ira molésti erant mihi.
\q1 \v 5 Cor meum conturbátum est in me: * et formído mortis cécidit super me.
\q1 \v 6 Timor et tremor venérunt super me: * et contexérunt me ténebræ.
\q1 \v 7 Et dixi: Quis dabit mihi pennas sicut colúmbæ, * et volábo, et requiéscam?
\q1 \v 8 Ecce, elongávi fúgiens: * et mansi in solitúdine.
\q1 \v 9 Exspectábam eum, qui salvum me fecit * a pusillanimitáte spíritus et tempestáte.
\q1 \v 10 Præcípita, Dómine, dívide linguas eórum: * quóniam vidi iniquitátem, et contradictiónem in civitáte.
\q1 \v 11 Die ac nocte circúmdabit eam super muros ejus iníquitas: * et labor in médio ejus, et injustítia.
\q1 \v 12 Et non defécit de platéis ejus * usúra, et dolus.
\q1 \v 13 Quóniam si inimícus meus maledixísset mihi, * sustinuíssem útique.
\q1 Et si is, qui óderat me, super me magna locútus fuísset, * abscondíssem me fórsitan ab eo.
\q1 \v 14 Tu vero, homo unánimis: * dux meus, et notus meus:
\q1 \v 15 Qui simul mecum dulces capiébas cibos: * in domo Dei ambulávimus cum consénsu.
\q1 \v 16 Véniat mors super illos: * et descéndant in inférnum vivéntes:
\q1 Quóniam nequítiæ in habitáculis eórum: * in médio eórum.
\q1 \v 17 Ego autem ad Deum clamávi: * et Dóminus salvábit me.
\q1 \v 18 Véspere, et mane, et merídie narrábo et annuntiábo: * et exáudiet vocem meam.
\q1 \v 19 Rédimet in pace ánimam meam ab his, qui appropínquant mihi: * quóniam inter multos erant mecum.
\q1 \v 20 Exáudiet Deus, et humiliábit illos, * qui est ante sǽcula.
\q1 Non enim est illis commutátio, et non timuérunt Deum: * exténdit manum suam in retribuéndo.
\q1 \v 21 Contaminavérunt testaméntum ejus, divísi sunt ab ira vultus ejus: * et appropinquávit cor illíus.
\q1 \v 22 Mollíti sunt sermónes ejus super óleum: * et ipsi sunt jácula.
\q1 \v 23 Jacta super Dóminum curam tuam, et ipse te enútriet: * non dabit in ætérnum fluctuatiónem justo.
\q1 \v 24 Tu vero, Deus, dedúces eos, * in púteum intéritus.
\q1 Viri sánguinum, et dolósi non dimidiábunt dies suos: * ego autem sperábo in te, Dómine.
\c 55
\q1 \v 2 Miserére mei, Deus, quóniam conculcávit me homo: * tota die impúgnans tribulávit me.
\q1 \v 3 Conculcavérunt me inimíci mei tota die: * quóniam multi bellántes advérsum me.
\q1 \v 4 Ab altitúdine diéi timébo: * ego vero in te sperábo.
\q1 \v 5 In Deo laudábo sermónes meos, in Deo sperávi: * non timébo quid fáciat mihi caro.
\q1 \v 6 Tota die verba mea exsecrabántur: * advérsum me omnes cogitatiónes eórum in malum.
\q1 \v 7 Inhabitábunt et abscóndent: * ipsi calcáneum meum observábunt.
\q1 \v 8 Sicut sustinuérunt ánimam meam, pro níhilo salvos fácies illos: * in ira pópulos confrínges.
\q1 \v 9 Deus, vitam meam annuntiávi tibi: * posuísti lácrimas meas in conspéctu tuo.
\q1 Sicut et in promissióne tua: * tunc converténtur inimíci mei retrórsum:
\q1 \v 10 In quacúmque die invocávero te: * ecce, cognóvi, quóniam Deus meus es.
\q1 \v 11 In Deo laudábo verbum, in Dómino laudábo sermónem: * in Deo sperávi, non timébo quid fáciat mihi homo.
\q1 \v 12 In me sunt, Deus, vota tua, * quæ reddam, laudatiónes tibi.
\q1 \v 13 Quóniam eripuísti ánimam meam de morte, et pedes meos de lapsu: * ut pláceam coram Deo in lúmine vivéntium.
\c 56
\q1 \v 2 Miserére mei, Deus, miserére mei: * quóniam in te confídit ánima mea.
\q1 Et in umbra alárum tuárum sperábo, * donec tránseat iníquitas.
\q1 \v 3 Clamábo ad Deum altíssimum: * Deum qui benefécit mihi.
\q1 \v 4 Misit de cælo, et liberávit me: * dedit in oppróbrium conculcántes me.
\q1 Misit Deus misericórdiam suam, et veritátem suam, * et erípuit ánimam meam de médio catulórum leónum: dormívi conturbátus.
\q1 \v 5 Fílii hóminum dentes eórum arma et sagíttæ: * et lingua eórum gládius acútus.
\q1 \v 6 Exaltáre super cælos, Deus, * et in omnem terram glória tua.
\q1 \v 7 Láqueum paravérunt pédibus meis: * et incurvavérunt ánimam meam.
\q1 Fodérunt ante fáciem meam fóveam: * et incidérunt in eam.
\q1 \v 8 Parátum cor meum, Deus, parátum cor meum: * cantábo, et psalmum dicam.
\q1 \v 9 Exsúrge, glória mea, exsúrge, psaltérium et cíthara: * exsúrgam dilúculo.
\q1 \v 10 Confitébor tibi in pópulis, Dómine: * et psalmum dicam tibi in géntibus:
\q1 \v 11 Quóniam magnificáta est usque ad cælos misericórdia tua, * et usque ad nubes véritas tua.
\q1 \v 12 Exaltáre super cælos, Deus: * et super omnem terram glória tua.
\c 57
\q1 \v 2 Si vere útique justítiam loquímini: * recta judicáte, fílii hóminum.
\q1 \v 3 Étenim in corde iniquitátes operámini: * in terra injustítias manus vestræ concínnant.
\q1 \v 4 Alienáti sunt peccatóres a vulva, erravérunt ab útero: * locúti sunt falsa.
\q1 \v 5 Furor illis secúndum similitúdinem serpéntis: * sicut áspidis surdæ, et obturántis aures suas,
\q1 \v 6 Quæ non exáudiet vocem incantántium: * et venéfici incantántis sapiénter.
\q1 \v 7 Deus cónteret dentes eórum in ore ipsórum: * molas leónum confrínget Dóminus.
\q1 \v 8 Ad níhilum devénient tamquam aqua decúrrens: * inténdit arcum suum donec infirméntur.
\q1 \v 9 Sicut cera, quæ fluit, auferéntur: * supercécidit ignis, et non vidérunt solem.
\q1 \v 10 Priúsquam intellégerent spinæ vestræ rhamnum: * sicut vivéntes, sic in ira absórbet eos.
\q1 \v 11 Lætábitur justus cum víderit vindíctam: * manus suas lavábit in sánguine peccatóris.
\q1 \v 12 Et dicet homo: Si útique est fructus justo: * útique est Deus júdicans eos in terra.
\c 58
\q1 \v 2 Éripe me de inimícis meis, Deus meus: * et ab insurgéntibus in me líbera me.
\q1 \v 3 Éripe me de operántibus iniquitátem: * et de viris sánguinum salva me.
\q1 \v 4 Quia ecce cepérunt ánimam meam: * irruérunt in me fortes.
\q1 \v 5 Neque iníquitas mea, neque peccátum meum, Dómine: * sine iniquitáte cucúrri, et diréxi.
\q1 \v 6 Exsúrge in occúrsum meum, et vide: * et tu, Dómine, Deus virtútum, Deus Israël,
\q1 Inténde ad visitándas omnes gentes: * non misereáris ómnibus, qui operántur iniquitátem.
\q1 \v 7 Converténtur ad vésperam: et famem patiéntur ut canes, * et circuíbunt civitátem.
\q1 \v 8 Ecce, loquéntur in ore suo, et gládius in lábiis eórum: * quóniam quis audívit?
\q1 \v 9 Et tu, Dómine, deridébis eos: * ad níhilum dedúces omnes gentes.
\q1 \v 10 Fortitúdinem meam ad te custódiam, quia, Deus, suscéptor meus es: * Deus meus, misericórdia ejus prævéniet me.
\q1 \v 12 Deus osténdet mihi super inimícos meos, ne occídas eos: * nequándo obliviscántur pópuli mei.
\q1 Dispérge illos in virtúte tua: * et depóne eos, protéctor meus, Dómine:
\q1 \v 13 Delíctum oris eórum, sermónem labiórum ipsórum: * et comprehendántur in supérbia sua.
\q1 Et de exsecratióne et mendácio annuntiabúntur in consummatióne: * in ira consummatiónis, et non erunt.
\q1 \v 14 Et scient quia Deus dominábitur Jacob: * et fínium terræ.
\q1 \v 15 Converténtur ad vésperam: et famem patiéntur ut canes, * et circuíbunt civitátem.
\q1 \v 16 Ipsi dispergéntur ad manducándum: * si vero non fúerint saturáti, et murmurábunt.
\q1 \v 17 Ego autem cantábo fortitúdinem tuam: * et exsultábo mane misericórdiam tuam.
\q1 Quia factus es suscéptor meus, * et refúgium meum, in die tribulatiónis meæ.
\q1 \v 18 Adjútor meus, tibi psallam, quia, Deus, suscéptor meus es: * Deus meus, misericórdia mea.
\c 59
\q1 \v 3 Deus, repulísti nos, et destruxísti nos: * irátus es, et misértus es nobis.
\q1 \v 4 Commovísti terram, et conturbásti eam: * sana contritiónes ejus, quia commóta est.
\q1 \v 5 Ostendísti pópulo tuo dura: * potásti nos vino compunctiónis.
\q1 \v 6 Dedísti metuéntibus te significatiónem: * ut fúgiant a fácie arcus:
\q1 \v 7 Ut liberéntur dilécti tui: * salvum fac déxtera tua, et exáudi me.
\q1 \v 8 Deus locútus est in sancto suo: * lætábor, et partíbor Síchimam: et convállem tabernaculórum metíbor.
\q1 \v 9 Meus est Gálaad, et meus est Manásses: * et Éphraim fortitúdo cápitis mei.
\q1 Juda rex meus: * Moab olla spei meæ.
\q1 \v 10 In Idumǽam exténdam calceaméntum meum: * mihi alienígenæ súbditi sunt.
\q1 \v 11 Quis dedúcet me in civitátem munítam? * quis dedúcet me usque in Idumǽam?
\q1 \v 12 Nonne tu, Deus, qui repulísti nos? * et non egrediéris, Deus, in virtútibus nostris?
\q1 \v 13 Da nobis auxílium de tribulatióne: * quia vana salus hóminis.
\q1 \v 14 In Deo faciémus virtútem: * et ipse ad níhilum dedúcet tribulántes nos.
\c 60
\q1 \v 2 Exáudi, Deus, deprecatiónem meam: * inténde oratióni meæ.
\q1 \v 3 A fínibus terræ ad te clamávi: * dum anxiarétur cor meum, in petra exaltásti me.
\q1 \v 4 Deduxísti me, quia factus es spes mea: * turris fortitúdinis a fácie inimíci.
\q1 \v 5 Inhabitábo in tabernáculo tuo in sǽcula: * prótegar in velaménto alárum tuárum.
\q1 \v 6 Quóniam tu, Deus meus, exaudísti oratiónem meam: * dedísti hereditátem timéntibus nomen tuum.
\q1 \v 7 Dies super dies regis adícies: * annos ejus usque in diem generatiónis et generatiónis.
\q1 \v 8 Pérmanet in ætérnum in conspéctu Dei: * misericórdiam et veritátem ejus quis requíret?
\q1 \v 9 Sic psalmum dicam nómini tuo in sǽculum sǽculi: * ut reddam vota mea de die in diem.
\c 61
\q1 \v 2 Nonne Deo subjécta erit ánima mea? * ab ipso enim salutáre meum.
\q1 \v 3 Nam et ipse Deus meus, et salutáris meus: * suscéptor meus, non movébor ámplius.
\q1 \v 4 Quoúsque irrúitis in hóminem? * interfícitis univérsi vos: tamquam paríeti inclináto et macériæ depúlsæ?
\q1 \v 5 Verúmtamen prétium meum cogitavérunt repéllere, cucúrri in siti: * ore suo benedicébant, et corde suo maledicébant.
\q1 \v 6 Verúmtamen Deo subjécta esto, ánima mea: * quóniam ab ipso patiéntia mea.
\q1 \v 7 Quia ipse Deus meus, et salvátor meus: * adjútor meus, non emigrábo.
\q1 \v 8 In Deo salutáre meum, et glória mea: * Deus auxílii mei, et spes mea in Deo est.
\q1 \v 9 Speráte in eo omnis congregátio pópuli, effúndite coram illo corda vestra: * Deus adjútor noster in ætérnum.
\q1 \v 10 Verúmtamen vani fílii hóminum, mendáces fílii hóminum in statéris: * ut decípiant ipsi de vanitáte in idípsum.
\q1 \v 11 Nolíte speráre in iniquitáte, et rapínas nolíte concupíscere: * divítiæ si áffluant, nolíte cor appónere.
\q1 \v 12 Semel locútus est Deus, duo hæc audívi, quia potéstas Dei est, et tibi, Dómine, misericórdia: * quia tu reddes unicuíque juxta ópera sua.
\c 62
\q1 \v 2 Deus, Deus meus, * ad te de luce vígilo.
\q1 Sitívit in te ánima mea, * quam multiplíciter tibi caro mea.
\q1 \v 3 In terra desérta, et ínvia, et inaquósa: ‡ sic in sancto appárui tibi, * ut vidérem virtútem tuam, et glóriam tuam.
\q1 \v 4 Quóniam mélior est misericórdia tua super vitas: * lábia mea laudábunt te.
\q1 \v 5 Sic benedícam te in vita mea: * et in nómine tuo levábo manus meas.
\q1 \v 6 Sicut ádipe et pinguédine repleátur ánima mea: * et lábiis exsultatiónis laudábit os meum.
\q1 \v 7 Si memor fui tui super stratum meum, † in matutínis meditábor in te: * (8a) quia fuísti adjútor meus.
\q1 \v 8 Et in velaménto alárum tuárum exsultábo, † (9) adhǽsit ánima mea post te: * me suscépit déxtera tua.
\q1 \v 10 Ipsi vero in vanum quæsiérunt ánimam meam, † introíbunt in inferióra terræ: * (11) tradéntur in manus gládii, partes vúlpium erunt.
\q1 \v 12 Rex vero lætábitur in Deo, † laudabúntur omnes qui jurant in eo: * quia obstrúctum est os loquéntium iníqua.
\c 63
\q1 \v 2 Exáudi, Deus, oratiónem meam cum déprecor: * a timóre inimíci éripe ánimam meam.
\q1 \v 3 Protexísti me a convéntu malignántium: * a multitúdine operántium iniquitátem.
\q1 \v 4 Quia exacuérunt ut gládium linguas suas: * intendérunt arcum rem amáram, ut sagíttent in occúltis immaculátum.
\q1 \v 6 Súbito sagittábunt eum, et non timébunt: * firmavérunt sibi sermónem nequam.
\q1 Narravérunt ut abscónderent láqueos: * dixérunt: Quis vidébit eos?
\q1 \v 7 Scrutáti sunt iniquitátes: * defecérunt scrutántes scrutínio.
\q1 Accédet homo ad cor altum: * et exaltábitur Deus.
\q1 \v 8 Sagíttæ parvulórum factæ sunt plagæ eórum: * et infirmátæ sunt contra eos linguæ eórum.
\q1 \v 9 Conturbáti sunt omnes qui vidébant eos: * et tímuit omnis homo.
\q1 \v 10 Et annuntiavérunt ópera Dei, * et facta ejus intellexérunt.
\q1 \v 11 Lætábitur justus in Dómino, et sperábit in eo, * et laudabúntur omnes recti corde.
\c 64
\q1 \v 2 Te decet hymnus, Deus, in Sion: * et tibi reddétur votum in Jerúsalem.
\q1 \v 3 Exáudi oratiónem meam: * ad te omnis caro véniet.
\q1 \v 4 Verba iniquórum prævaluérunt super nos: * et impietátibus nostris tu propitiáberis.
\q1 \v 5 Beátus, quem elegísti, et assumpsísti: * inhabitábit in átriis tuis.
\q1 Replébimur in bonis domus tuæ: * sanctum est templum tuum, mirábile in æquitáte.
\q1 \v 6 Exáudi nos, Deus, salutáris noster, * spes ómnium fínium terræ, et in mari longe.
\q1 \v 7 Prǽparans montes in virtúte tua, accínctus poténtia: * qui contúrbas profúndum maris sonum flúctuum ejus.
\q1 \v 8 Turbabúntur gentes, et timébunt qui hábitant términos a signis tuis: * éxitus matutíni, et véspere delectábis.
\q1 \v 10 Visitásti terram, et inebriásti eam: * multiplicásti locupletáre eam.
\q1 Flumen Dei replétum est aquis, parásti cibum illórum: * quóniam ita est præparátio ejus.
\q1 \v 11 Rivos ejus inébria, multíplica genímina ejus: * in stillicídiis ejus lætábitur gérminans.
\q1 \v 12 Benedíces corónæ anni benignitátis tuæ: * et campi tui replebúntur ubertáte.
\q1 \v 13 Pinguéscent speciósa desérti: * et exsultatióne colles accingéntur.
\q1 \v 14 Indúti sunt aríetes óvium, et valles abundábunt fruménto: * clamábunt, étenim hymnum dicent.
\c 65
\q1 \v 1 Jubiláte Deo, omnis terra, psalmum dícite nómini ejus: * date glóriam laudi ejus.
\q1 \v 3 Dícite Deo: Quam terribília sunt ópera tua, Dómine! * in multitúdine virtútis tuæ mentiéntur tibi inimíci tui.
\q1 \v 4 Omnis terra adóret te, et psallat tibi: * psalmum dicat nómini tuo.
\q1 \v 5 Veníte, et vidéte ópera Dei: * terríbilis in consíliis super fílios hóminum.
\q1 \v 6 Qui convértit mare in áridam, in flúmine pertransíbunt pede: * ibi lætábimur in ipso.
\q1 \v 7 Qui dominátur in virtúte sua in ætérnum, óculi ejus super gentes respíciunt: * qui exásperant non exalténtur in semetípsis.
\q1 \v 8 Benedícite, gentes, Deum nostrum: * et audítam fácite vocem laudis ejus,
\q1 \v 9 Qui pósuit ánimam meam ad vitam: * et non dedit in commotiónem pedes meos.
\q1 \v 10 Quóniam probásti nos, Deus: * igne nos examinásti, sicut examinátur argéntum.
\q1 \v 11 Induxísti nos in láqueum, posuísti tribulatiónes in dorso nostro: * imposuísti hómines super cápita nostra.
\q1 \v 12 Transívimus per ignem et aquam: * et eduxísti nos in refrigérium.
\q1 \v 13 Introíbo in domum tuam in holocáustis: * reddam tibi vota mea, quæ distinxérunt lábia mea.
\q1 \v 14 Et locútum est os meum, * in tribulatióne mea.
\q1 \v 15 Holocáusta medulláta ófferam tibi cum incénso aríetum: * ófferam tibi boves cum hircis.
\q1 \v 16 Veníte, audíte, et narrábo, omnes, qui timétis Deum: * quanta fecit ánimæ meæ.
\q1 \v 17 Ad ipsum ore meo clamávi, * et exaltávi sub lingua mea.
\q1 \v 18 Iniquitátem si aspéxi in corde meo, * non exáudiet Dóminus.
\q1 \v 19 Proptérea exaudívit Deus, * et atténdit voci deprecatiónis meæ.
\q1 \v 20 Benedíctus Deus, * qui non amóvit oratiónem meam, et misericórdiam suam a me.
\c 66
\q1 \v 2 Deus misereátur nostri, et benedícat nobis: * illúminet vultum suum super nos, et misereátur nostri.
\q1 \v 3 Ut cognoscámus in terra viam tuam, * in ómnibus géntibus salutáre tuum.
\q1 \v 4 Confiteántur tibi pópuli, Deus: * confiteántur tibi pópuli omnes.
\q1 \v 5 Læténtur et exsúltent gentes: * quóniam júdicas pópulos in æquitáte, et gentes in terra dírigis.
\q1 \v 6 Confiteántur tibi pópuli, Deus, confiteántur tibi pópuli omnes: * (7a) terra dedit fructum suum.
\q1 \v 7 Benedícat nos Deus, Deus noster, (8) benedícat nos Deus: * et métuant eum omnes fines terræ.
\c 67
\q1 \v 2 Exsúrgat Deus, et dissipéntur inimíci ejus, * et fúgiant qui odérunt eum, a fácie ejus.
\q1 \v 3 Sicut déficit fumus, defíciant: * sicut fluit cera a fácie ignis, sic péreant peccatóres a fácie Dei.
\q1 \v 4 Et justi epuléntur, et exsúltent in conspéctu Dei: * et delecténtur in lætítia.
\q1 \v 5 Cantáte Deo, psalmum dícite nómini ejus: * iter fácite ei, qui ascéndit super occásum: (fit reverentia) Dóminus nomen illi.
\q1 Exsultáte in conspéctu ejus: * turbabúntur a fácie ejus, (6a) patris orphanórum et júdicis viduárum.
\q1 \v 6 Deus in loco sancto suo: * (7a) Deus, qui inhabitáre facit uníus moris in domo:
\q1 \v 7 Qui edúcit vinctos in fortitúdine, * simíliter eos qui exásperant, qui hábitant in sepúlcris.
\q1 \v 8 Deus, cum egrederéris in conspéctu pópuli tui, * cum pertransíres in desérto:
\q1 \v 9 Terra mota est, étenim cæli distillavérunt a fácie Dei Sínai, * a fácie Dei Israël.
\q1 \v 10 Plúviam voluntáriam segregábis, Deus, hereditáti tuæ: * et infirmáta est, tu vero perfecísti eam.
\q1 \v 11 Animália tua habitábunt in ea: * parásti in dulcédine tua páuperi, Deus.
\q1 \v 12 Dóminus dabit verbum evangelizántibus, * virtúte multa.
\q1 \v 13 Rex virtútum dilécti, dilécti: * et speciéi domus divídere spólia.
\q1 \v 14 Si dormiátis inter médios cleros, pennæ colúmbæ deargentátæ, * et posterióra dorsi ejus in pallóre auri.
\q1 \v 15 Dum discérnit cæléstis reges super eam, nive dealbabúntur in Selmon: * (16a) mons Dei, mons pinguis.
\q1 \v 16 Mons coagulátus, mons pinguis: * (17a) ut quid suspicámini montes coagulátos?
\q1 \v 17 Mons, in quo beneplácitum est Deo habitáre in eo: * étenim Dóminus habitábit in finem.
\q1 \v 18 Currus Dei decem míllibus múltiplex, míllia lætántium: * Dóminus in eis in Sina in sancto.
\q1 \v 19 Ascendísti in altum, cepísti captivitátem: * accepísti dona in homínibus.
\q1 Étenim non credéntes, * inhabitáre Dóminum Deum.
\q1 \v 20 Benedíctus Dóminus die cotídie: * prósperum iter fáciet nobis Deus salutárium nostrórum.
\q1 \v 21 Deus noster, Deus salvos faciéndi: * et Dómini Dómini éxitus mortis.
\q1 \v 22 Verúmtamen Deus confrínget cápita inimicórum suórum: * vérticem capílli perambulántium in delíctis suis.
\q1 \v 23 Dixit Dóminus: Ex Basan convértam, * convértam in profúndum maris:
\q1 \v 24 Ut intingátur pes tuus in sánguine: * lingua canum tuórum ex inimícis, ab ipso.
\q1 \v 25 Vidérunt ingréssus tuos, Deus: * ingréssus Dei mei: regis mei qui est in sancto.
\q1 \v 26 Prævenérunt príncipes conjúncti psalléntibus: * in médio juvenculárum tympanistriárum.
\q1 \v 27 In ecclésiis benedícite Deo Dómino, * de fóntibus Israël.
\q1 \v 28 Ibi Bénjamin adolescéntulus: * in mentis excéssu.
\q1 Príncipes Juda, duces eórum: * príncipes Zábulon, príncipes Néphtali.
\q1 \v 29 Manda, Deus, virtúti tuæ: * confírma hoc, Deus, quod operátus es in nobis.
\q1 \v 30 A templo tuo in Jerúsalem, * tibi ófferent reges múnera.
\q1 \v 31 Íncrepa feras arúndinis, congregátio taurórum in vaccis populórum: * ut exclúdant eos, qui probáti sunt argénto.
\q1 Díssipa gentes, quæ bella volunt: (32) vénient legáti ex Ægýpto: * Æthiópia prævéniet manus ejus Deo.
\q1 \v 33 Regna terræ, cantáte Deo: * psállite Dómino.
\q1 Psállite Deo, (34a) qui ascéndit super cælum cæli, * ad Oriéntem.
\q1 \v 34 Ecce dabit voci suæ vocem virtútis, (35) date glóriam Deo super Israël, * magnificéntia ejus, et virtus ejus in núbibus.
\q1 \v 36 Mirábilis Deus in sanctis suis, Deus Israël ipse dabit virtútem, et fortitúdinem plebi suæ, * benedíctus Deus.
\c 68
\q1 \v 2 Salvum me fac, Deus: * quóniam intravérunt aquæ usque ad ánimam meam.
\q1 \v 3 Infíxus sum in limo profúndi: * et non est substántia.
\q1 Veni in altitúdinem maris: * et tempéstas demérsit me.
\q1 \v 4 Laborávi clamans, raucæ factæ sunt fauces meæ: * defecérunt óculi mei, dum spero in Deum meum.
\q1 \v 5 Multiplicáti sunt super capíllos cápitis mei, * qui odérunt me gratis.
\q1 Confortáti sunt qui persecúti sunt me inimíci mei injúste: * quæ non rápui, tunc exsolvébam.
\q1 \v 6 Deus, tu scis insipiéntiam meam: * et delícta mea a te non sunt abscóndita.
\q1 \v 7 Non erubéscant in me qui exspéctant te, Dómine, * Dómine virtútum.
\q1 Non confundántur super me * qui quærunt te, Deus Israël.
\q1 \v 8 Quóniam propter te sustínui oppróbrium: * opéruit confúsio fáciem meam.
\q1 \v 9 Extráneus factus sum frátribus meis, * et peregrínus fíliis matris meæ.
\q1 \v 10 Quóniam zelus domus tuæ comédit me: * et oppróbria exprobrántium tibi cecidérunt super me.
\q1 \v 11 Et opérui in jejúnio ánimam meam: * et factum est in oppróbrium mihi.
\q1 \v 12 Et pósui vestiméntum meum cilícium: * et factus sum illis in parábolam.
\q1 \v 13 Advérsum me loquebántur, qui sedébant in porta: * et in me psallébant qui bibébant vinum.
\q1 Ego vero oratiónem meam ad te, Dómine: * tempus benepláciti, Deus.
\q1 \v 14 In multitúdine misericórdiæ tuæ exáudi me, * in veritáte salútis tuæ:
\q1 \v 15 Éripe me de luto, ut non infígar: * líbera me ab iis, qui odérunt me, et de profúndis aquárum.
\q1 \v 16 Non me demérgat tempéstas aquæ, neque absórbeat me profúndum: * neque úrgeat super me púteus os suum.
\q1 \v 17 Exáudi me, Dómine, quóniam benígna est misericórdia tua: * secúndum multitúdinem miseratiónum tuárum réspice in me.
\q1 \v 18 Et ne avértas fáciem tuam a púero tuo: * quóniam tríbulor, velóciter exáudi me.
\q1 \v 19 Inténde ánimæ meæ, et líbera eam: * propter inimícos meos éripe me.
\q1 \v 20 Tu scis impropérium meum, et confusiónem meam, * et reveréntiam meam.
\q1 \v 21 In conspéctu tuo sunt omnes qui tríbulant me: * impropérium exspectávit cor meum, et misériam.
\q1 Et sustínui qui simul contristarétur, et non fuit: * et qui consolarétur, et non invéni.
\q1 \v 22 Et dedérunt in escam meam fel: * et in siti mea potavérunt me acéto.
\q1 \v 23 Fiat mensa eórum coram ipsis in láqueum, * et in retributiónes, et in scándalum.
\q1 \v 24 Obscuréntur óculi eórum ne vídeant: * et dorsum eórum semper incúrva.
\q1 \v 25 Effúnde super eos iram tuam: * et furor iræ tuæ comprehéndat eos.
\q1 \v 26 Fiat habitátio eórum desérta: * et in tabernáculis eórum non sit qui inhábitet.
\q1 \v 27 Quóniam quem tu percussísti, persecúti sunt: * et super dolórem vúlnerum meórum addidérunt.
\q1 \v 28 Appóne iniquitátem super iniquitátem eórum: * et non intrent in justítiam tuam.
\q1 \v 29 Deleántur de libro vivéntium: * et cum justis non scribántur.
\q1 \v 30 Ego sum pauper et dolens: * salus tua, Deus, suscépit me.
\q1 \v 31 Laudábo nomen Dei cum cántico: * et magnificábo eum in laude:
\q1 \v 32 Et placébit Deo super vítulum novéllum: * córnua producéntem et úngulas.
\q1 \v 33 Vídeant páuperes et læténtur: * quǽrite Deum, et vivet ánima vestra.
\q1 \v 34 Quóniam exaudívit páuperes Dóminus: * et vinctos suos non despéxit.
\q1 \v 35 Laudent illum cæli et terra, * mare et ómnia reptília in eis.
\q1 \v 36 Quóniam Deus salvam fáciet Sion: * et ædificabúntur civitátes Juda.
\q1 Et inhabitábunt ibi, * et hereditáte acquírent eam.
\q1 \v 37 Et semen servórum ejus possidébit eam: * et qui díligunt nomen ejus, habitábunt in ea.
\c 69
\q1 \v 2 Deus, in adjutórium meum inténde: * Dómine, ad adjuvándum me festína.
\q1 \v 3 Confundántur et revereántur, * qui quærunt ánimam meam.
\q1 \v 4 Avertántur retrórsum, et erubéscant, * qui volunt mihi mala.
\q1 Avertántur statim erubescéntes, * qui dicunt mihi: Euge, euge.
\q1 \v 5 Exsúltent et læténtur in te omnes qui quærunt te, * et dicant semper: Magnificétur Dóminus: qui díligunt salutáre tuum.
\q1 \v 6 Ego vero egénus, et pauper sum: * Deus, ádjuva me.
\q1 Adjútor meus, et liberátor meus es tu: * Dómine, ne moréris.
\c 70
\q1 \v 1 In te, Dómine, sperávi, non confúndar in ætérnum: * in justítia tua líbera me, et éripe me.
\q1 \v 2 Inclína ad me aurem tuam, * et salva me.
\q1 \v 3 Esto mihi in Deum protectórem, et in locum munítum: * ut salvum me fácias,
\q1 Quóniam firmaméntum meum, * et refúgium meum es tu.
\q1 \v 4 Deus meus, éripe me de manu peccatóris, * et de manu contra legem agéntis et iníqui:
\q1 \v 5 Quóniam tu es patiéntia mea, Dómine: * Dómine, spes mea a juventúte mea.
\q1 \v 6 In te confirmátus sum ex útero: * de ventre matris meæ tu es protéctor meus.
\q1 \v 7 In te cantátio mea semper: * tamquam prodígium factus sum multis: et tu adjútor fortis.
\q1 \v 8 Repleátur os meum laude, ut cantem glóriam tuam: * tota die magnitúdinem tuam.
\q1 \v 9 Ne proícias me in témpore senectútis: * cum defécerit virtus mea, ne derelínquas me.
\q1 \v 10 Quia dixérunt inimíci mei mihi: * et qui custodiébant ánimam meam, consílium fecérunt in unum.
\q1 \v 11 Dicéntes: Deus derelíquit eum, persequímini, † et comprehéndite eum: * quia non est qui erípiat.
\q1 \v 12 Deus, ne elongéris a me: * Deus meus, in auxílium meum réspice.
\q1 \v 13 Confundántur, et defíciant detrahéntes ánimæ meæ: * operiántur confusióne, et pudóre qui quærunt mala mihi.
\q1 \v 14 Ego autem semper sperábo: * et adíciam super omnem laudem tuam.
\q1 \v 15 Os meum annuntiábit justítiam tuam: * tota die salutáre tuum.
\q1 \v 16 Quóniam non cognóvi litteratúram, † introíbo in poténtias Dómini: * Dómine, memorábor justítiæ tuæ solíus.
\q1 \v 17 Deus, docuísti me a juventúte mea: * et usque nunc pronuntiábo mirabília tua.
\q1 \v 18 Et usque in senéctam et sénium: * Deus, ne derelínquas me,
\q1 Donec annúntiem brácchium tuum * generatióni omni, quæ ventúra est:
\q1 \v 19 Poténtiam tuam, et justítiam tuam, Deus, † usque in altíssima, quæ fecísti magnália: * Deus, quis símilis tibi?
\q1 \v 20 Quantas ostendísti mihi tribulatiónes multas et malas: et convérsus vivificásti me: * et de abýssis terræ íterum reduxísti me:
\q1 \v 21 Multiplicásti magnificéntiam tuam: * et convérsus consolátus es me.
\q1 \v 22 Nam et ego confitébor tibi in vasis psalmi veritátem tuam: * Deus, psallam tibi in cíthara, Sanctus Israël.
\q1 \v 23 Exsultábunt lábia mea cum cantávero tibi: * et ánima mea, quam redemísti.
\q1 \v 24 Sed et lingua mea tota die meditábitur justítiam tuam: * cum confúsi et revériti fúerint, qui quærunt mala mihi.
\c 71
\q1 \v 2 Deus, judícium tuum regi da: * et justítiam tuam fílio regis:
\q1 Judicáre pópulum tuum in justítia, * et páuperes tuos in judício.
\q1 \v 3 Suscípiant montes pacem pópulo: * et colles justítiam.
\q1 \v 4 Judicábit páuperes pópuli, et salvos fáciet fílios páuperum: * et humiliábit calumniatórem.
\q1 \v 5 Et permanébit cum sole, et ante lunam, * in generatióne et generatiónem.
\q1 \v 6 Descéndet sicut plúvia in vellus: * et sicut stillicídia stillántia super terram.
\q1 \v 7 Oriétur in diébus ejus justítia, et abundántia pacis: * donec auferátur luna.
\q1 \v 8 Et dominábitur a mari usque ad mare: * et a flúmine usque ad términos orbis terrárum.
\q1 \v 9 Coram illo prócident Æthíopes: * et inimíci ejus terram lingent.
\q1 \v 10 Reges Tharsis, et ínsulæ múnera ófferent: * reges Árabum et Saba dona addúcent.
\q1 \v 11 Et adorábunt eum omnes reges terræ: * omnes gentes sérvient ei:
\q1 \v 12 Quia liberábit páuperem a poténte: * et páuperem, cui non erat adjútor.
\q1 \v 13 Parcet páuperi et ínopi: * et ánimas páuperum salvas fáciet.
\q1 \v 14 Ex usúris et iniquitáte rédimet ánimas eórum: * et honorábile nomen eórum coram illo.
\q1 \v 15 Et vivet, et dábitur ei de auro Arábiæ, et adorábunt de ipso semper: * tota die benedícent ei.
\q1 \v 16 Et erit firmaméntum in terra in summis móntium, superextollétur super Líbanum fructus ejus: * et florébunt de civitáte sicut fænum terræ.
\q1 \v 17 Sit nomen ejus benedíctum in sǽcula: * ante solem pérmanet nomen ejus.
\q1 Et benedicéntur in ipso omnes tribus terræ: * omnes gentes magnificábunt eum.
\q1 \v 18 Benedíctus Dóminus, Deus Israël, * qui facit mirabília solus:
\q1 \v 19 Et benedíctum nomen majestátis ejus in ætérnum: * et replébitur majestáte ejus omnis terra: fiat, fiat.
\c 72
\q1 \v 1 Quam bonus Israël Deus, * his, qui recto sunt corde!
\q1 \v 2 Mei autem pæne moti sunt pedes: * pæne effúsi sunt gressus mei.
\q1 \v 3 Quia zelávi super iníquos, * pacem peccatórum videns.
\q1 \v 4 Quia non est respéctus morti eórum: * et firmaméntum in plaga eórum.
\q1 \v 5 In labóre hóminum non sunt, * et cum homínibus non flagellabúntur:
\q1 \v 6 Ídeo ténuit eos supérbia, * opérti sunt iniquitáte et impietáte sua.
\q1 \v 7 Pródiit quasi ex ádipe iníquitas eórum: * transiérunt in afféctum cordis.
\q1 \v 8 Cogitavérunt, et locúti sunt nequítiam: * iniquitátem in excélso locúti sunt.
\q1 \v 9 Posuérunt in cælum os suum: * et lingua eórum transívit in terra.
\q1 \v 10 Ídeo convertétur pópulus meus hic: * et dies pleni inveniéntur in eis.
\q1 \v 11 Et dixérunt: Quómodo scit Deus, * et si est sciéntia in excélso?
\q1 \v 12 Ecce, ipsi peccatóres, et abundántes in sǽculo, * obtinuérunt divítias.
\q1 \v 13 Et dixi: Ergo sine causa justificávi cor meum, * et lavi inter innocéntes manus meas:
\q1 \v 14 Et fui flagellátus tota die, * et castigátio mea in matutínis.
\q1 \v 15 Si dicébam: Narrábo sic: * ecce, natiónem filiórum tuórum reprobávi.
\q1 \v 16 Existimábam ut cognóscerem hoc, * labor est ante me:
\q1 \v 17 Donec intrem in Sanctuárium Dei: * et intéllegam in novíssimis eórum.
\q1 \v 18 Verúmtamen propter dolos posuísti eis: * dejecísti eos dum allevaréntur.
\q1 \v 19 Quómodo facti sunt in desolatiónem, súbito defecérunt: * periérunt propter iniquitátem suam.
\q1 \v 20 Velut sómnium surgéntium, Dómine, * in civitáte tua imáginem ipsórum ad níhilum rédiges.
\q1 \v 21 Quia inflammátum est cor meum, et renes mei commutáti sunt: * et ego ad níhilum redáctus sum, et nescívi.
\q1 \v 23 Ut juméntum factus sum apud te: * et ego semper tecum.
\q1 \v 24 Tenuísti manum déxteram meam: et in voluntáte tua deduxísti me, * et cum glória suscepísti me.
\q1 \v 25 Quid enim mihi est in cælo? * et a te quid vólui super terram?
\q1 \v 26 Defécit caro mea, et cor meum: * Deus cordis mei, et pars mea Deus in ætérnum.
\q1 \v 27 Quia ecce, qui elóngant se a te, períbunt: * perdidísti omnes, qui fornicántur abs te.
\q1 \v 28 Mihi autem adhærére Deo bonum est: * pónere in Dómino Deo spem meam:
\q1 Ut annúntiem omnes prædicatiónes tuas, * in portis fíliæ Sion.
\c 73
\q1 \v 1 Ut quid, Deus, repulísti in finem: * irátus est furor tuus super oves páscuæ tuæ?
\q1 \v 2 Memor esto congregatiónis tuæ, * quam possedísti ab inítio.
\q1 Redemísti virgam hereditátis tuæ: * mons Sion, in quo habitásti in eo.
\q1 \v 3 Leva manus tuas in supérbias eórum in finem: * quanta malignátus est inimícus in sancto!
\q1 \v 4 Et gloriáti sunt qui odérunt te: * in médio solemnitátis tuæ.
\q1 \v 5 Posuérunt signa sua, signa: * et non cognovérunt sicut in éxitu super summum.
\q1 \v 6 Quasi in silva lignórum secúribus excidérunt jánuas ejus in idípsum: * in secúri et áscia dejecérunt eam.
\q1 \v 7 Incendérunt igni Sanctuárium tuum: * in terra polluérunt tabernáculum nóminis tui.
\q1 \v 8 Dixérunt in corde suo cognátio eórum simul: * Quiéscere faciámus omnes dies festos Dei a terra.
\q1 \v 9 Signa nostra non vídimus, jam non est prophéta: * et nos non cognóscet ámplius.
\q1 \v 10 Úsquequo, Deus, improperábit inimícus: * irrítat adversárius nomen tuum in finem?
\q1 \v 11 Ut quid avértis manum tuam, et déxteram tuam, * de médio sinu tuo in finem?
\q1 \v 12 Deus autem Rex noster ante sǽcula: * operátus est salútem in médio terræ.
\q1 \v 13 Tu confirmásti in virtúte tua mare: * contribulásti cápita dracónum in aquis.
\q1 \v 14 Tu confregísti cápita dracónis: * dedísti eum escam pópulis Æthíopum.
\q1 \v 15 Tu dirupísti fontes, et torréntes: * tu siccásti flúvios Ethan.
\q1 \v 16 Tuus est dies, et tua est nox: * tu fabricátus es auróram et solem.
\q1 \v 17 Tu fecísti omnes términos terræ: * æstátem et ver tu plasmásti ea.
\q1 \v 18 Memor esto hujus, inimícus improperávit Dómino: * et pópulus insípiens incitávit nomen tuum.
\q1 \v 19 Ne tradas béstiis ánimas confiténtes tibi, * et ánimas páuperum tuórum ne obliviscáris in finem.
\q1 \v 20 Réspice in testaméntum tuum: * quia repléti sunt, qui obscuráti sunt terræ dómibus iniquitátum.
\q1 \v 21 Ne avertátur húmilis factus confúsus: * pauper et inops laudábunt nomen tuum.
\q1 \v 22 Exsúrge, Deus, júdica causam tuam: * memor esto improperiórum tuórum, eórum quæ ab insipiénte sunt tota die.
\q1 \v 23 Ne obliviscáris voces inimicórum tuórum: * supérbia eórum, qui te odérunt, ascéndit semper.
\c 74
\q1 \v 2 Confitébimur tibi, Deus: * confitébimur, et invocábimus nomen tuum.
\q1 \v 3 Narrábimus mirabília tua: * cum accépero tempus, ego justítias judicábo.
\q1 \v 4 Liquefácta est terra, et omnes qui hábitant in ea: * ego confirmávi colúmnas ejus.
\q1 \v 5 Dixi iníquis: Nolíte iníque ágere: * et delinquéntibus: Nolíte exaltáre cornu:
\q1 \v 6 Nolíte extóllere in altum cornu vestrum: * nolíte loqui advérsus Deum iniquitátem.
\q1 \v 7 Quia neque ab Oriénte, neque ab Occidénte, neque a desértis móntibus: * quóniam Deus judex est.
\q1 \v 8 Hunc humíliat, et hunc exáltat: * quia calix in manu Dómini vini meri plenus misto.
\q1 \v 9 Et inclinávit ex hoc in hoc: verúmtamen fæx ejus non est exinaníta: * bibent omnes peccatóres terræ.
\q1 \v 10 Ego autem annuntiábo in sǽculum: * cantábo Deo Jacob.
\q1 \v 11 Et ómnia córnua peccatórum confríngam: * et exaltabúntur córnua justi.
\c 75
\q1 \v 2 Notus in Judǽa Deus: * in Israël magnum nomen ejus.
\q1 \v 3 Et factus est in pace locus ejus: * et habitátio ejus in Sion.
\q1 \v 4 Ibi confrégit poténtias árcuum, * scutum, gládium, et bellum.
\q1 \v 5 Illúminans tu mirabíliter a móntibus ætérnis: * turbáti sunt omnes insipiéntes corde.
\q1 \v 6 Dormiérunt somnum suum: * et nihil invenérunt omnes viri divitiárum in mánibus suis.
\q1 \v 7 Ab increpatióne tua, Deus Jacob, * dormitavérunt qui ascendérunt equos.
\q1 \v 8 Tu terríbilis es, et quis resístet tibi? * ex tunc ira tua.
\q1 \v 9 De cælo audítum fecísti judícium: * terra trémuit et quiévit,
\q1 \v 10 Cum exsúrgeret in judícium Deus, * ut salvos fáceret omnes mansuétos terræ.
\q1 \v 11 Quóniam cogitátio hóminis confitébitur tibi: * et relíquiæ cogitatiónis diem festum agent tibi.
\q1 \v 12 Vovéte, et réddite Dómino, Deo vestro: * omnes, qui in circúitu ejus affértis múnera.
\q1 \v 13 Terríbili et ei qui aufert spíritum príncipum, * terríbili apud reges terræ.
\c 76
\q1 \v 2 Voce mea ad Dóminum clamávi: * voce mea ad Deum, et inténdit mihi.
\q1 \v 3 In die tribulatiónis meæ Deum exquisívi, mánibus meis nocte contra eum: * et non sum decéptus.
\q1 \v 4 Rénuit consolári ánima mea, * memor fui Dei, et delectátus sum, et exercitátus sum: et defécit spíritus meus.
\q1 \v 5 Anticipavérunt vigílias óculi mei: * turbátus sum, et non sum locútus.
\q1 \v 6 Cogitávi dies antíquos: * et annos ætérnos in mente hábui.
\q1 \v 7 Et meditátus sum nocte cum corde meo, * et exercitábar, et scopébam spíritum meum.
\q1 \v 8 Numquid in ætérnum proíciet Deus: * aut non appónet ut complacítior sit adhuc?
\q1 \v 9 Aut in finem misericórdiam suam abscíndet, * a generatióne in generatiónem?
\q1 \v 10 Aut obliviscétur miseréri Deus? * aut continébit in ira sua misericórdias suas?
\q1 \v 11 Et dixi: Nunc cœpi: * hæc mutátio déxteræ Excélsi.
\q1 \v 12 Memor fui óperum Dómini: * quia memor ero ab inítio mirabílium tuórum.
\q1 \v 13 Et meditábor in ómnibus opéribus tuis: * et in adinventiónibus tuis exercébor.
\q1 \v 14 Deus, in sancto via tua: quis Deus magnus sicut Deus noster? * tu es Deus qui facis mirabília.
\q1 \v 15 Notam fecísti in pópulis virtútem tuam: * redemísti in brácchio tuo pópulum tuum, fílios Jacob et Joseph.
\q1 \v 17 Vidérunt te aquæ, Deus, vidérunt te aquæ: * et timuérunt, et turbátæ sunt abýssi.
\q1 \v 18 Multitúdo sónitus aquárum: * vocem dedérunt nubes.
\q1 Étenim sagíttæ tuæ tránseunt: * vox tonítrui tui in rota.
\q1 \v 19 Illuxérunt coruscatiónes tuæ orbi terræ: * commóta est, et contrémuit terra.
\q1 \v 20 In mari via tua, et sémitæ tuæ in aquis multis: * et vestígia tua non cognoscéntur.
\q1 \v 21 Deduxísti sicut oves pópulum tuum, * in manu Móysi et Aaron.
\c 77
\q1 \v 1 Atténdite, pópule meus, legem meam: * inclináte aurem vestram in verba oris mei.
\q1 \v 2 Apériam in parábolis os meum: * loquar propositiónes ab inítio.
\q1 \v 3 Quanta audívimus et cognóvimus ea: * et patres nostri narravérunt nobis.
\q1 \v 4 Non sunt occultáta a fíliis eórum: * in generatióne áltera.
\q1 Narrántes laudes Dómini, et virtútes ejus: * et mirabília ejus, quæ fecit.
\q1 \v 5 Et suscitávit testimónium in Jacob: * et legem pósuit in Israël.
\q1 Quanta mandávit pátribus nostris nota fácere ea fíliis suis: * ut cognóscat generátio áltera.
\q1 \v 6 Fílii qui nascéntur, et exsúrgent, * et narrábunt fíliis suis.
\q1 \v 7 Ut ponant in Deo spem suam, et non obliviscántur óperum Dei: * et mandáta ejus exquírant.
\q1 \v 8 Ne fiant sicut patres eórum: * generátio prava et exásperans.
\q1 Generátio, quæ non diréxit cor suum: * et non est créditus cum Deo spíritus ejus.
\q1 \v 9 Fílii Ephrem intendéntes et mitténtes arcum: * convérsi sunt in die belli.
\q1 \v 10 Non custodiérunt testaméntum Dei: * et in lege ejus noluérunt ambuláre.
\q1 \v 11 Et oblíti sunt benefactórum ejus: * et mirabílium ejus quæ osténdit eis.
\q1 \v 12 Coram pátribus eórum fecit mirabília in terra Ægýpti: * in campo Táneos.
\q1 \v 13 Interrúpit mare, et perdúxit eos: * et státuit aquas quasi in utre.
\q1 \v 14 Et dedúxit eos in nube diéi: * et tota nocte in illuminatióne ignis.
\q1 \v 15 Interrúpit petram in erémo: * et adaquávit eos velut in abýsso multa.
\q1 \v 16 Et edúxit aquam de petra: * et dedúxit tamquam flúmina aquas.
\q1 \v 17 Et apposuérunt adhuc peccáre ei: * in iram excitavérunt Excélsum in inaquóso.
\q1 \v 18 Et tentavérunt Deum in córdibus suis, * ut péterent escas animábus suis.
\q1 \v 19 Et male locúti sunt de Deo: * dixérunt: Numquid póterit Deus paráre mensam in desérto?
\q1 \v 20 Quóniam percússit petram, et fluxérunt aquæ: * et torréntes inundavérunt.
\q1 Numquid et panem póterit dare, * aut paráre mensam pópulo suo?
\q1 \v 21 Ídeo audívit Dóminus, et dístulit: * et ignis accénsus est in Jacob, et ira ascéndit in Israël.
\q1 \v 22 Quia non credidérunt in Deo: * nec speravérunt in salutári ejus:
\q1 \v 23 Et mandávit núbibus désuper: * et jánuas cæli apéruit.
\q1 \v 24 Et pluit illis manna ad manducándum: * et panem cæli dedit eis.
\q1 \v 25 Panem Angelórum manducávit homo, * cibária misit eis in abundántia.
\q1 \v 26 Tránstulit Austrum de cælo: * et indúxit in virtúte sua Áfricum.
\q1 \v 27 Et pluit super eos sicut púlverem carnes: * et sicut arénam maris volatília pennáta.
\q1 \v 28 Et cecidérunt in médio castrórum eórum: * circa tabernácula eórum.
\q1 \v 29 Et manducavérunt, et saturáti sunt nimis, et desidérium eórum áttulit eis: * non sunt fraudáti a desidério suo.
\q1 \v 30 Adhuc escæ eórum erant in ore ipsórum: * et ira Dei ascéndit super eos.
\q1 \v 31 Et occídit pingues eórum, * et eléctos Israël impedívit.
\q1 \v 32 In ómnibus his peccavérunt adhuc: * et non credidérunt in mirabílibus ejus.
\q1 \v 33 Et defecérunt in vanitáte dies eórum: * et anni eórum cum festinatióne.
\q1 \v 34 Cum occíderet eos, quærébant eum: * et revertebántur, et dilúculo veniébant ad eum.
\q1 \v 35 Et rememoráti sunt quia Deus adjútor est eórum: * et Deus excélsus redémptor eórum est.
\q1 \v 36 Et dilexérunt eum in ore suo, * et lingua sua mentíti sunt ei.
\q1 \v 37 Cor autem eórum non erat rectum cum eo: * nec fidéles hábiti sunt in testaménto ejus.
\q1 \v 38 Ipse autem est miséricors, et propítius fiet peccátis eórum: * et non dispérdet eos.
\q1 Et abundávit ut avérteret iram suam: * et non accéndit omnem iram suam:
\q1 \v 39 Et recordátus est quia caro sunt: * spíritus vadens et non rédiens.
\q1 \v 40 Quóties exacerbavérunt eum in desérto, * in iram concitavérunt eum in inaquóso?
\q1 \v 41 Et convérsi sunt, et tentavérunt Deum: * et Sanctum Israël exacerbavérunt.
\q1 \v 42 Non sunt recordáti manus ejus, * die qua redémit eos de manu tribulántis.
\q1 \v 43 Sicut pósuit in Ægýpto signa sua, * et prodígia sua in campo Táneos.
\q1 \v 44 Et convértit in sánguinem flúmina eórum: * et imbres eórum, ne bíberent.
\q1 \v 45 Misit in eos cœnomyíam, et comédit eos: * et ranam, et dispérdidit eos.
\q1 \v 46 Et dedit ærúgini fructus eórum: * et labóres eórum locústæ.
\q1 \v 47 Et occídit in grándine víneas eórum: * et moros eórum in pruína.
\q1 \v 48 Et trádidit grándini juménta eórum: * et possessiónem eórum igni.
\q1 \v 49 Misit in eos iram indignatiónis suæ: * indignatiónem, et iram, et tribulatiónem: immissiónes per ángelos malos.
\q1 \v 50 Viam fecit sémitæ iræ suæ, non pepércit a morte animábus eórum: * et juménta eórum in morte conclúsit.
\q1 \v 51 Et percússit omne primogénitum in terra Ægýpti: * primítias omnis labóris eórum in tabernáculis Cham.
\q1 \v 52 Et ábstulit sicut oves pópulum suum: * et perdúxit eos tamquam gregem in desérto.
\q1 \v 53 Et dedúxit eos in spe, et non timuérunt: * et inimícos eórum opéruit mare.
\q1 \v 54 Et indúxit eos in montem sanctificatiónis suæ: * montem, quem acquisívit déxtera ejus.
\q1 Et ejécit a fácie eórum gentes: * et sorte divísit eis terram in funículo distributiónis.
\q1 \v 55 Et habitáre fecit in tabernáculis eórum: * tribus Israël.
\q1 \v 56 Et tentavérunt, et exacerbavérunt Deum excélsum: * et testimónia ejus non custodiérunt.
\q1 \v 57 Et avertérunt se, et non servavérunt pactum: * quemádmodum patres eórum convérsi sunt in arcum pravum.
\q1 \v 58 In iram concitavérunt eum in cóllibus suis: * et in sculptílibus suis ad æmulatiónem eum provocavérunt.
\q1 \v 59 Audívit Deus, et sprevit: * et ad níhilum redégit valde Israël.
\q1 \v 60 Et répulit tabernáculum Silo: * tabernáculum suum, ubi habitávit in homínibus.
\q1 \v 61 Et trádidit in captivitátem virtútem eórum: * et pulchritúdinem eórum in manus inimíci.
\q1 \v 62 Et conclúsit in gládio pópulum suum: * et hereditátem suam sprevit.
\q1 \v 63 Júvenes eórum comédit ignis: * et vírgines eórum non sunt lamentátæ.
\q1 \v 64 Sacerdótes eórum in gládio cecidérunt: * et víduæ eórum non plorabántur.
\q1 \v 65 Et excitátus est tamquam dórmiens Dóminus: * tamquam potens crapulátus a vino.
\q1 \v 66 Et percússit inimícos suos in posterióra: * oppróbrium sempitérnum dedit illis.
\q1 \v 67 Et répulit tabernáculum Joseph: * et tribum Éphraim non elégit.
\q1 \v 68 Sed elégit tribum Juda, * montem Sion quem diléxit.
\q1 \v 69 Et ædificávit sicut unicórnium sanctifícium suum in terra, * quam fundávit in sǽcula.
\q1 \v 70 Et elégit David, servum suum, et sústulit eum de grégibus óvium: * de post fœtántes accépit eum,
\q1 \v 71 Páscere Jacob, servum suum, * et Israël, hereditátem suam:
\q1 \v 72 Et pavit eos in innocéntia cordis sui: * et in intelléctibus mánuum suárum dedúxit eos.
\c 78
\q1 \v 1 Deus, venérunt gentes in hereditátem tuam, polluérunt templum sanctum tuum: * posuérunt Jerúsalem in pomórum custódiam.
\q1 \v 2 Posuérunt morticína servórum tuórum, escas volatílibus cæli: * carnes sanctórum tuórum béstiis terræ.
\q1 \v 3 Effudérunt sánguinem eórum tamquam aquam in circúitu Jerúsalem: * et non erat qui sepelíret.
\q1 \v 4 Facti sumus oppróbrium vicínis nostris: * subsannátio et illúsio his, qui in circúitu nostro sunt.
\q1 \v 5 Úsquequo, Dómine, irascéris in finem: * accendétur velut ignis zelus tuus?
\q1 \v 6 Effúnde iram tuam in gentes, quæ te non novérunt: * et in regna quæ nomen tuum non invocavérunt:
\q1 \v 7 Quia comedérunt Jacob: * et locum ejus desolavérunt.
\q1 \v 8 Ne memíneris iniquitátum nostrárum antiquárum, cito antícipent nos misericórdiæ tuæ: * quia páuperes facti sumus nimis.
\q1 \v 9 Ádjuva nos, Deus, salutáris noster: et propter glóriam nóminis tui, Dómine, líbera nos: * et propítius esto peccátis nostris, propter nomen tuum:
\q1 \v 10 Ne forte dicant in géntibus: Ubi est Deus eórum? * et innotéscat in natiónibus coram óculis nostris.
\q1 Últio sánguinis servórum tuórum, qui effúsus est: * intróeat in conspéctu tuo gémitus compeditórum.
\q1 \v 11 Secúndum magnitúdinem brácchii tui, * pósside fílios mortificatórum.
\q1 \v 12 Et redde vicínis nostris séptuplum in sinu eórum: * impropérium ipsórum, quod exprobravérunt tibi, Dómine.
\q1 \v 13 Nos autem pópulus tuus, et oves páscuæ tuæ, * confitébimur tibi in sǽculum.
\q1 In generatiónem et generatiónem * annuntiábimus laudem tuam.
\c 79
\q1 \v 2 Qui regis Israël, inténde: * qui dedúcis velut ovem Joseph.
\q1 Qui sedes super Chérubim, * manifestáre coram Éphraim, Bénjamin, et Manásse.
\q1 \v 3 Éxcita poténtiam tuam, et veni, * ut salvos fácias nos.
\q1 \v 4 Deus, convérte nos: * et osténde fáciem tuam, et salvi érimus.
\q1 \v 5 Dómine, Deus virtútum, * quoúsque irascéris super oratiónem servi tui?
\q1 \v 6 Cibábis nos pane lacrimárum: * et potum dabis nobis in lácrimis in mensúra?
\q1 \v 7 Posuísti nos in contradictiónem vicínis nostris: * et inimíci nostri subsannavérunt nos.
\q1 \v 8 Deus virtútum, convérte nos: * et osténde fáciem tuam, et salvi érimus.
\q1 \v 9 Víneam de Ægýpto transtulísti: * ejecísti gentes, et plantásti eam.
\q1 \v 10 Dux itíneris fuísti in conspéctu ejus: * plantásti radíces ejus, et implévit terram.
\q1 \v 11 Opéruit montes umbra ejus: * et arbústa ejus cedros Dei.
\q1 \v 12 Exténdit pálmites suos usque ad mare: * et usque ad flumen propágines ejus.
\q1 \v 13 Ut quid destruxísti macériam ejus: * et vindémiant eam omnes, qui prætergrediúntur viam?
\q1 \v 14 Exterminávit eam aper de silva: * et singuláris ferus depástus est eam.
\q1 \v 15 Deus virtútum, convértere: * réspice de cælo, et vide, et vísita víneam istam.
\q1 \v 16 Et pérfice eam, quam plantávit déxtera tua: * et super fílium hóminis, quem confirmásti tibi.
\q1 \v 17 Incénsa igni, et suffóssa * ab increpatióne vultus tui períbunt.
\q1 \v 18 Fiat manus tua super virum déxteræ tuæ: * et super fílium hóminis, quem confirmásti tibi.
\q1 \v 19 Et non discédimus a te, vivificábis nos: * et nomen tuum invocábimus.
\q1 \v 20 Dómine, Deus virtútum, convérte nos: * et osténde fáciem tuam, et salvi érimus.
\c 80
\q1 \v 2 Exsultáte Deo, adjutóri nostro: * jubiláte Deo Jacob.
\q1 \v 3 Súmite psalmum, et date týmpanum: * psaltérium jucúndum cum cíthara.
\q1 \v 4 Buccináte in Neoménia tuba, * in insígni die solemnitátis vestræ.
\q1 \v 5 Quia præcéptum in Israël est: * et judícium Deo Jacob.
\q1 \v 6 Testimónium in Joseph pósuit illud, cum exíret de terra Ægýpti: * linguam, quam non nóverat, audívit.
\q1 \v 7 Divértit ab onéribus dorsum ejus: * manus ejus in cóphino serviérunt.
\q1 \v 8 In tribulatióne invocásti me, et liberávi te: * exaudívi te in abscóndito tempestátis: probávi te apud aquam contradictiónis.
\q1 \v 9 Audi, pópulus meus, et contestábor te: * Israël, si audíeris me, non erit in te deus recens, neque adorábis deum aliénum.
\q1 \v 11 Ego enim sum Dóminus Deus tuus, qui edúxi te de terra Ægýpti: * diláta os tuum, et implébo illud.
\q1 \v 12 Et non audívit pópulus meus vocem meam: * et Israël non inténdit mihi.
\q1 \v 13 Et dimísi eos secúndum desidéria cordis eórum: * ibunt in adinventiónibus suis.
\q1 \v 14 Si pópulus meus audísset me: * Israël si in viis meis ambulásset:
\q1 \v 15 Pro níhilo fórsitan inimícos eórum humiliássem: * et super tribulántes eos misíssem manum meam.
\q1 \v 16 Inimíci Dómini mentíti sunt ei: * et erit tempus eórum in sǽcula.
\q1 \v 17 Et cibávit eos ex ádipe fruménti: * et de petra, melle saturávit eos.
\c 81
\q1 \v 1 Deus stetit in synagóga deórum: * in médio autem deos dijúdicat.
\q1 \v 2 Úsquequo judicátis iniquitátem: * et fácies peccatórum súmitis?
\q1 \v 3 Judicáte egéno, et pupíllo: * húmilem, et páuperem justificáte.
\q1 \v 4 Erípite páuperem: * et egénum de manu peccatóris liberáte.
\q1 \v 5 Nesciérunt, neque intellexérunt, in ténebris ámbulant: * movebúntur ómnia fundaménta terræ.
\q1 \v 6 Ego dixi: Dii estis, * et fílii Excélsi omnes.
\q1 \v 7 Vos autem sicut hómines moriémini: * et sicut unus de princípibus cadétis.
\q1 \v 8 Surge, Deus, júdica terram: * quóniam tu hereditábis in ómnibus géntibus.
\c 82
\q1 \v 2 Deus, quis símilis erit tibi? * Ne táceas, neque compescáris, Deus.
\q1 \v 3 Quóniam ecce inimíci tui sonuérunt: * et qui odérunt te extulérunt caput.
\q1 \v 4 Super pópulum tuum malignavérunt consílium: * et cogitavérunt advérsus sanctos tuos.
\q1 \v 5 Dixérunt: Veníte, et disperdámus eos de gente: * et non memorétur nomen Israël ultra.
\q1 \v 6 Quóniam cogitavérunt unanímiter: * simul advérsum te testaméntum disposuérunt, tabernácula Idumæórum et Ismahelítæ:
\q1 \v 8 Moab, et Agaréni, Gebal, et Ammon, et Ámalec: * alienígenæ cum habitántibus Tyrum.
\q1 \v 9 Étenim Assur venit cum illis: * facti sunt in adjutórium fíliis Lot.
\q1 \v 10 Fac illis sicut Mádian, et Sísaræ: * sicut Jabin in torrénte Cisson.
\q1 \v 11 Disperiérunt in Endor: * facti sunt ut stercus terræ.
\q1 \v 12 Pone príncipes eórum sicut Oreb, et Zeb, * et Zébee, et Sálmana:
\q1 \v 13 Omnes príncipes eórum: * qui dixérunt: Hereditáte possideámus Sanctuárium Dei.
\q1 \v 14 Deus meus, pone illos ut rotam: * et sicut stípulam ante fáciem venti.
\q1 \v 15 Sicut ignis, qui combúrit silvam: * et sicut flamma combúrens montes:
\q1 \v 16 Ita persequéris illos in tempestáte tua: * et in ira tua turbábis eos.
\q1 \v 17 Imple fácies eórum ignomínia: * et quærent nomen tuum, Dómine.
\q1 \v 18 Erubéscant, et conturbéntur in sǽculum sǽculi: * et confundántur, et péreant.
\q1 \v 19 Et cognóscant quia nomen tibi Dóminus: * tu solus Altíssimus in omni terra.
\c 83
\q1 \v 2 Quam dilécta tabernácula tua, Dómine virtútum: * concupíscit, et déficit ánima mea in átria Dómini.
\q1 \v 3 Cor meum, et caro mea * exsultavérunt in Deum vivum.
\q1 \v 4 Étenim passer invénit sibi domum: * et turtur nidum sibi, ubi ponat pullos suos.
\q1 Altária tua, Dómine virtútum: * Rex meus, et Deus meus.
\q1 \v 5 Beáti, qui hábitant in domo tua, Dómine: * in sǽcula sæculórum laudábunt te.
\q1 \v 6 Beátus vir, cujus est auxílium abs te: * ascensiónes in corde suo dispósuit, in valle lacrimárum in loco, quem pósuit.
\q1 \v 8 Étenim benedictiónem dabit legislátor, ibunt de virtúte in virtútem: * vidébitur Deus deórum in Sion.
\q1 \v 9 Dómine, Deus virtútum, exáudi oratiónem meam: * áuribus pércipe, Deus Jacob.
\q1 \v 10 Protéctor noster, áspice, Deus: * et réspice in fáciem Christi tui:
\q1 \v 11 Quia mélior est dies una in átriis tuis, * super míllia.
\q1 Elégi abjéctus esse in domo Dei mei: * magis quam habitáre in tabernáculis peccatórum.
\q1 \v 12 Quia misericórdiam, et veritátem díligit Deus: * grátiam et glóriam dabit Dóminus.
\q1 \v 13 Non privábit bonis eos, qui ámbulant in innocéntia: * Dómine virtútum, beátus homo, qui sperat in te.
\c 84
\q1 \v 2 Benedixísti, Dómine, terram tuam: * avertísti captivitátem Jacob.
\q1 \v 3 Remisísti iniquitátem plebis tuæ: * operuísti ómnia peccáta eórum.
\q1 \v 4 Mitigásti omnem iram tuam: * avertísti ab ira indignatiónis tuæ.
\q1 \v 5 Convérte nos, Deus, salutáris noster: * et avérte iram tuam a nobis.
\q1 \v 6 Numquid in ætérnum irascéris nobis? * aut exténdes iram tuam a generatióne in generatiónem?
\q1 \v 7 Deus, tu convérsus vivificábis nos: * et plebs tua lætábitur in te.
\q1 \v 8 Osténde nobis, Dómine, misericórdiam tuam: * et salutáre tuum da nobis.
\q1 \v 9 Áudiam quid loquátur in me Dóminus Deus: * quóniam loquétur pacem in plebem suam.
\q1 Et super sanctos suos: * et in eos, qui convertúntur ad cor.
\q1 \v 10 Verúmtamen prope timéntes eum salutáre ipsíus: * ut inhábitet glória in terra nostra.
\q1 \v 11 Misericórdia, et véritas obviavérunt sibi: * justítia, et pax osculátæ sunt.
\q1 \v 12 Véritas de terra orta est: * et justítia de cælo prospéxit.
\q1 \v 13 Étenim Dóminus dabit benignitátem: * et terra nostra dabit fructum suum.
\q1 \v 14 Justítia ante eum ambulábit: * et ponet in via gressus suos.
\c 85
\q1 \v 1 Inclína, Dómine, aurem tuam, et exáudi me: * quóniam inops, et pauper sum ego.
\q1 \v 2 Custódi ánimam meam, quóniam sanctus sum: * salvum fac servum tuum, Deus meus, sperántem in te.
\q1 \v 3 Miserére mei, Dómine, quóniam ad te clamávi tota die: * lætífica ánimam servi tui, quóniam ad te, Dómine, ánimam meam levávi.
\q1 \v 5 Quóniam tu, Dómine, suávis, et mitis: * et multæ misericórdiæ ómnibus invocántibus te.
\q1 \v 6 Áuribus pércipe, Dómine, oratiónem meam: * et inténde voci deprecatiónis meæ.
\q1 \v 7 In die tribulatiónis meæ clamávi ad te: * quia exaudísti me.
\q1 \v 8 Non est símilis tui in diis, Dómine: * et non est secúndum ópera tua.
\q1 \v 9 Omnes gentes quascúmque fecísti, vénient, et adorábunt coram te, Dómine: * et glorificábunt nomen tuum.
\q1 \v 10 Quóniam magnus es tu, et fáciens mirabília: * tu es Deus solus.
\q1 \v 11 Deduc me, Dómine, in via tua, et ingrédiar in veritáte tua: * lætétur cor meum ut tímeat nomen tuum.
\q1 \v 12 Confitébor tibi, Dómine, Deus meus, in toto corde meo, * et glorificábo nomen tuum in ætérnum:
\q1 \v 13 Quia misericórdia tua magna est super me: * et eruísti ánimam meam ex inférno inferióri.
\q1 \v 14 Deus, iníqui insurrexérunt super me, et synagóga poténtium quæsiérunt ánimam meam: * et non proposuérunt te in conspéctu suo.
\q1 \v 15 Et tu, Dómine, Deus miserátor et miséricors, * pátiens, et multæ misericórdiæ, et verax,
\q1 \v 16 Réspice in me, et miserére mei, * da impérium tuum púero tuo: et salvum fac fílium ancíllæ tuæ.
\q1 \v 17 Fac mecum signum in bonum, ut vídeant qui odérunt me, et confundántur: * quóniam tu, Dómine, adjuvísti me, et consolátus es me.
\c 86
\q1 \v 1 Fundaménta ejus in móntibus sanctis: * díligit Dóminus portas Sion super ómnia tabernácula Jacob.
\q1 \v 3 Gloriósa dicta sunt de te, * cívitas Dei.
\q1 \v 4 Memor ero Rahab, et Babylónis * sciéntium me.
\q1 Ecce, alienígenæ, et Tyrus, et pópulus Æthíopum, * hi fuérunt illic.
\q1 \v 5 Numquid Sion dicet: Homo, et homo natus est in ea: * et ipse fundávit eam Altíssimus?
\q1 \v 6 Dóminus narrábit in scriptúris populórum, et príncipum: * horum, qui fuérunt in ea.
\q1 \v 7 Sicut lætántium ómnium * habitátio est in te.
\c 87
\q1 \v 2 Dómine, Deus salútis meæ: * in die clamávi, et nocte coram te.
\q1 \v 3 Intret in conspéctu tuo orátio mea: * inclína aurem tuam ad precem meam:
\q1 \v 4 Quia repléta est malis ánima mea: * et vita mea inférno appropinquávit.
\q1 \v 5 Æstimátus sum cum descendéntibus in lacum: * factus sum sicut homo sine adjutório, inter mórtuos liber.
\q1 \v 6 Sicut vulneráti dormiéntes in sepúlcris, quorum non es memor ámplius: * et ipsi de manu tua repúlsi sunt.
\q1 \v 7 Posuérunt me in lacu inferióri: * in tenebrósis, et in umbra mortis.
\q1 \v 8 Super me confirmátus est furor tuus: * et omnes fluctus tuos induxísti super me.
\q1 \v 9 Longe fecísti notos meos a me: * posuérunt me abominatiónem sibi.
\q1 Tráditus sum, et non egrediébar: * óculi mei languérunt præ inópia.
\q1 \v 10 Clamávi ad te, Dómine, tota die: * expándi ad te manus meas.
\q1 \v 11 Numquid mórtuis fácies mirabília: * aut médici suscitábunt, et confitebúntur tibi?
\q1 \v 12 Numquid narrábit áliquis in sepúlcro misericórdiam tuam, * et veritátem tuam in perditióne?
\q1 \v 13 Numquid cognoscéntur in ténebris mirabília tua, * et justítia tua in terra obliviónis?
\q1 \v 14 Et ego ad te, Dómine, clamávi: * et mane orátio mea prævéniet te.
\q1 \v 15 Ut quid, Dómine, repéllis oratiónem meam: * avértis fáciem tuam a me?
\q1 \v 16 Pauper sum ego, et in labóribus a juventúte mea: * exaltátus autem, humiliátus sum et conturbátus.
\q1 \v 17 In me transiérunt iræ tuæ: * et terróres tui conturbavérunt me.
\q1 \v 18 Circumdedérunt me sicut aqua tota die: * circumdedérunt me simul.
\q1 \v 19 Elongásti a me amícum et próximum: * et notos meos a miséria.
\c 88
\q1 \v 2 Misericórdias Dómini * in ætérnum cantábo.
\q1 In generatiónem et generatiónem * annuntiábo veritátem tuam in ore meo.
\q1 \v 3 Quóniam dixísti: In ætérnum misericórdia ædificábitur in cælis: * præparábitur véritas tua in eis.
\q1 \v 4 Dispósui testaméntum eléctis meis, jurávi David, servo meo: * Usque in ætérnum præparábo semen tuum.
\q1 \v 5 Et ædificábo in generatiónem et generatiónem * sedem tuam.
\q1 \v 6 Confitebúntur cæli mirabília tua, Dómine: * étenim veritátem tuam in ecclésia sanctórum.
\q1 \v 7 Quóniam quis in núbibus æquábitur Dómino: * símilis erit Deo in fíliis Dei?
\q1 \v 8 Deus, qui glorificátur in consílio sanctórum: * magnus et terríbilis super omnes qui in circúitu ejus sunt.
\q1 \v 9 Dómine, Deus virtútum, quis símilis tibi? * potens es, Dómine, et véritas tua in circúitu tuo.
\q1 \v 10 Tu domináris potestáti maris: * motum autem flúctuum ejus tu mítigas.
\q1 \v 11 Tu humiliásti sicut vulnerátum, supérbum: * in brácchio virtútis tuæ dispersísti inimícos tuos.
\q1 \v 12 Tui sunt cæli, et tua est terra, orbem terræ et plenitúdinem ejus tu fundásti: * aquilónem, et mare tu creásti.
\q1 \v 13 Thabor et Hermon in nómine tuo exsultábunt: * tuum brácchium cum poténtia.
\q1 \v 14 Firmétur manus tua, et exaltétur déxtera tua: * justítia et judícium præparátio sedis tuæ.
\q1 \v 15 Misericórdia et véritas præcédent fáciem tuam: * beátus pópulus, qui scit jubilatiónem.
\q1 \v 16 Dómine, in lúmine vultus tui ambulábunt, et in nómine tuo exsultábunt tota die: * et in justítia tua exaltabúntur.
\q1 \v 18 Quóniam glória virtútis eórum tu es: * et in beneplácito tuo exaltábitur cornu nostrum.
\q1 \v 19 Quia Dómini est assúmptio nostra, * et Sancti Israël, regis nostri.
\q1 \v 20 Tunc locútus es in visióne sanctis tuis, et dixísti: * Pósui adjutórium in poténte: et exaltávi eléctum de plebe mea.
\q1 \v 21 Invéni David, servum meum: * óleo sancto meo unxi eum.
\q1 \v 22 Manus enim mea auxiliábitur ei: * et brácchium meum confortábit eum.
\q1 \v 23 Nihil profíciet inimícus in eo, * et fílius iniquitátis non appónet nocére ei.
\q1 \v 24 Et concídam a fácie ipsíus inimícos ejus: * et odiéntes eum in fugam convértam.
\q1 \v 25 Et véritas mea, et misericórdia mea cum ipso: * et in nómine meo exaltábitur cornu ejus.
\q1 \v 26 Et ponam in mari manum ejus: * et in flumínibus déxteram ejus.
\q1 \v 27 Ipse invocábit me: Pater meus es tu: * Deus meus, et suscéptor salútis meæ.
\q1 \v 28 Et ego primogénitum ponam illum * excélsum præ régibus terræ.
\q1 \v 29 In ætérnum servábo illi misericórdiam meam: * et testaméntum meum fidéle ipsi.
\q1 \v 30 Et ponam in sǽculum sǽculi semen ejus: * et thronum ejus sicut dies cæli.
\q1 \v 31 Si autem derelíquerint fílii ejus legem meam: * et in judíciis meis non ambuláverint:
\q1 \v 32 Si justítias meas profanáverint: * et mandáta mea non custodíerint:
\q1 \v 33 Visitábo in virga iniquitátes eórum: * et in verbéribus peccáta eórum.
\q1 \v 34 Misericórdiam autem meam non dispérgam ab eo: * neque nocébo in veritáte mea:
\q1 \v 35 Neque profanábo testaméntum meum: * et quæ procédunt de lábiis meis, non fáciam írrita.
\q1 \v 36 Semel jurávi in sancto meo: Si David méntiar: * semen ejus in ætérnum manébit.
\q1 \v 37 Et thronus ejus sicut sol in conspéctu meo, * et sicut luna perfécta in ætérnum: et testis in cælo fidélis.
\q1 \v 39 Tu vero repulísti et despexísti: * distulísti Christum tuum.
\q1 \v 40 Evertísti testaméntum servi tui: * profanásti in terra Sanctuárium ejus.
\q1 \v 41 Destruxísti omnes sepes ejus: * posuísti firmaméntum ejus formídinem.
\q1 \v 42 Diripuérunt eum omnes transeúntes viam: * factus est oppróbrium vicínis suis.
\q1 \v 43 Exaltásti déxteram depriméntium eum: * lætificásti omnes inimícos ejus.
\q1 \v 44 Avertísti adjutórium gládii ejus: * et non es auxiliátus ei in bello.
\q1 \v 45 Destruxísti eum ab emundatióne: * et sedem ejus in terram collisísti.
\q1 \v 46 Minorásti dies témporis ejus: * perfudísti eum confusióne.
\q1 \v 47 Úsquequo, Dómine, avértis in finem: * exardéscet sicut ignis ira tua?
\q1 \v 48 Memoráre quæ mea substántia: * numquid enim vane constituísti omnes fílios hóminum?
\q1 \v 49 Quis est homo, qui vivet, et non vidébit mortem: * éruet ánimam suam de manu ínferi?
\q1 \v 50 Ubi sunt misericórdiæ tuæ antíquæ, Dómine, * sicut jurásti David in veritáte tua?
\q1 \v 51 Memor esto, Dómine, oppróbrii servórum tuórum * quod contínui in sinu meo multárum géntium.
\q1 \v 52 Quod exprobravérunt inimíci tui, Dómine, * quod exprobravérunt commutatiónem Christi tui.
\q1 \v 53 Benedíctus Dóminus in ætérnum: * fiat, fiat.
\c 89
\q1 \v 1 Dómine, refúgium factus es nobis: * a generatióne in generatiónem.
\q1 \v 2 Priúsquam montes fíerent, aut formarétur terra et orbis: * a sǽculo et usque in sǽculum tu es, Deus.
\q1 \v 3 Ne avértas hóminem in humilitátem: * et dixísti: Convertímini, fílii hóminum.
\q1 \v 4 Quóniam mille anni ante óculos tuos, * tamquam dies hestérna, quæ prætériit,
\q1 \v 5 Et custódia in nocte, * quæ pro níhilo habéntur, eórum anni erunt.
\q1 \v 6 Mane sicut herba tránseat, mane flóreat, et tránseat: * véspere décidat, indúret et aréscat.
\q1 \v 7 Quia defécimus in ira tua, * et in furóre tuo turbáti sumus.
\q1 \v 8 Posuísti iniquitátes nostras in conspéctu tuo: * sǽculum nostrum in illuminatióne vultus tui.
\q1 \v 9 Quóniam omnes dies nostri defecérunt: * et in ira tua defécimus.
\q1 Anni nostri sicut aránea meditabúntur: * dies annórum nostrórum in ipsis, septuagínta anni.
\q1 \v 10 Si autem in potentátibus, octogínta anni: * et ámplius eórum, labor et dolor.
\q1 Quóniam supervénit mansuetúdo: * et corripiémur.
\q1 \v 11 Quis novit potestátem iræ tuæ: * et præ timóre tuo iram tuam dinumeráre?
\q1 \v 12 Déxteram tuam sic notam fac: * et erudítos corde in sapiéntia.
\q1 \v 13 Convértere, Dómine, úsquequo? * et deprecábilis esto super servos tuos.
\q1 \v 14 Repléti sumus mane misericórdia tua: * et exsultávimus, et delectáti sumus ómnibus diébus nostris.
\q1 \v 15 Lætáti sumus pro diébus, quibus nos humiliásti: * annis, quibus vídimus mala.
\q1 \v 16 Réspice in servos tuos, et in ópera tua: * et dírige fílios eórum.
\q1 \v 17 Et sit splendor Dómini, Dei nostri, super nos, et ópera mánuum nostrárum dírige super nos: * et opus mánuum nostrárum dírige.
\c 90
\q1 \v 1 Qui hábitat in adjutório Altíssimi, * in protectióne Dei cæli commorábitur.
\q1 \v 2 Dicet Dómino: Suscéptor meus es tu, et refúgium meum: * Deus meus sperábo in eum.
\q1 \v 3 Quóniam ipse liberávit me de láqueo venántium, * et a verbo áspero.
\q1 \v 4 Scápulis suis obumbrábit tibi: * et sub pennis ejus sperábis.
\q1 \v 5 Scuto circúmdabit te véritas ejus: * non timébis a timóre noctúrno,
\q1 \v 6 A sagítta volánte in die, † a negótio perambulánte in ténebris: * ab incúrsu, et dæmónio meridiáno.
\q1 \v 7 Cadent a látere tuo mille, † et decem míllia a dextris tuis: * ad te autem non appropinquábit.
\q1 \v 8 Verúmtamen óculis tuis considerábis: * et retributiónem peccatórum vidébis.
\q1 \v 9 Quóniam tu es, Dómine, spes mea: * Altíssimum posuísti refúgium tuum.
\q1 \v 10 Non accédet ad te malum: * et flagéllum non appropinquábit tabernáculo tuo.
\q1 \v 11 Quóniam Ángelis suis mandávit de te: * ut custódiant te in ómnibus viis tuis.
\q1 \v 12 In mánibus portábunt te: * ne forte offéndas ad lápidem pedem tuum.
\q1 \v 13 Super áspidem, et basilíscum ambulábis: * et conculcábis leónem et dracónem.
\q1 \v 14 Quóniam in me sperávit, liberábo eum: * prótegam eum, quóniam cognóvit nomen meum.
\q1 \v 15 Clamábit ad me, et ego exáudiam eum: ‡ cum ipso sum in tribulatióne: * erípiam eum et glorificábo eum.
\q1 \v 16 Longitúdine diérum replébo eum: * et osténdam illi salutáre meum.
\c 91
\q1 \v 2 Bonum est confitéri Dómino: * et psállere nómini tuo, Altíssime.
\q1 \v 3 Ad annuntiándum mane misericórdiam tuam: * et veritátem tuam per noctem.
\q1 \v 4 In decachórdo, psaltério: * cum cántico, in cíthara.
\q1 \v 5 Quia delectásti me, Dómine, in factúra tua: * et in opéribus mánuum tuárum exsultábo.
\q1 \v 6 Quam magnificáta sunt ópera tua, Dómine! * nimis profúndæ factæ sunt cogitatiónes tuæ.
\q1 \v 7 Vir insípiens non cognóscet: * et stultus non intélleget hæc.
\q1 \v 8 Cum exórti fúerint peccatóres sicut fænum: * et apparúerint omnes, qui operántur iniquitátem:
\q1 \v 9 Ut intéreant in sǽculum sǽculi: * tu autem Altíssimus in ætérnum, Dómine.
\q1 \v 10 Quóniam ecce inimíci tui, Dómine, quóniam ecce inimíci tui períbunt: * et dispergéntur omnes, qui operántur iniquitátem.
\q1 \v 11 Et exaltábitur sicut unicórnis cornu meum: * et senéctus mea in misericórdia úberi.
\q1 \v 12 Et despéxit óculus meus inimícos meos: * et in insurgéntibus in me malignántibus áudiet auris mea.
\q1 \v 13 Justus, ut palma florébit: * sicut cedrus Líbani multiplicábitur.
\q1 \v 14 Plantáti in domo Dómini, * in átriis domus Dei nostri florébunt.
\q1 \v 15 Adhuc multiplicabúntur in senécta úberi: * et bene patiéntes erunt, ut annúntient:
\q1 \v 16 Quóniam rectus Dóminus, Deus noster: * et non est iníquitas in eo.
\c 92
\q1 \v 1 Dóminus regnávit, decórem indútus est: * indútus est Dóminus fortitúdinem, et præcínxit se.
\q1 Étenim firmávit orbem terræ, * qui non commovébitur.
\q1 \v 2 Paráta sedes tua ex tunc: * a sǽculo tu es.
\q1 \v 3 Elevavérunt flúmina, Dómine: * elevavérunt flúmina vocem suam.
\q1 Elevavérunt flúmina fluctus suos, * (4a) a vócibus aquárum multárum.
\q1 \v 4 Mirábiles elatiónes maris: * mirábilis in altis Dóminus.
\q1 \v 5 Testimónia tua credibília facta sunt nimis: * domum tuam decet sanctitúdo, Dómine, in longitúdinem diérum.
\c 93
\q1 \v 1 Deus ultiónum Dóminus: * Deus ultiónum líbere egit.
\q1 \v 2 Exaltáre, qui júdicas terram: * redde retributiónem supérbis.
\q1 \v 3 Úsquequo peccatóres, Dómine, * úsquequo peccatóres gloriabúntur:
\q1 \v 4 Effabúntur, et loquéntur iniquitátem: * loquéntur omnes, qui operántur injustítiam?
\q1 \v 5 Pópulum tuum, Dómine, humiliavérunt: * et hereditátem tuam vexavérunt.
\q1 \v 6 Víduam, et ádvenam interfecérunt: * et pupíllos occidérunt.
\q1 \v 7 Et dixérunt: Non vidébit Dóminus, * nec intélleget Deus Jacob.
\q1 \v 8 Intellégite, insipiéntes in pópulo: * et stulti, aliquándo sápite.
\q1 \v 9 Qui plantávit aurem, non áudiet? * aut qui finxit óculum, non consíderat?
\q1 \v 10 Qui córripit gentes, non árguet: * qui docet hóminem sciéntiam?
\q1 \v 11 Dóminus scit cogitatiónes hóminum, * quóniam vanæ sunt.
\q1 \v 12 Beátus homo, quem tu erudíeris, Dómine: * et de lege tua docúeris eum,
\q1 \v 13 Ut mítiges ei a diébus malis: * donec fodiátur peccatóri fóvea.
\q1 \v 14 Quia non repéllet Dóminus plebem suam: * et hereditátem suam non derelínquet.
\q1 \v 15 Quoadúsque justítia convertátur in judícium: * et qui juxta illam omnes qui recto sunt corde.
\q1 \v 16 Quis consúrget mihi advérsus malignántes? * aut quis stabit mecum advérsus operántes iniquitátem?
\q1 \v 17 Nisi quia Dóminus adjúvit me: * paulo minus habitásset in inférno ánima mea.
\q1 \v 18 Si dicébam: Motus est pes meus: * misericórdia tua, Dómine, adjuvábat me.
\q1 \v 19 Secúndum multitúdinem dolórum meórum in corde meo: * consolatiónes tuæ lætificavérunt ánimam meam.
\q1 \v 20 Numquid adhǽret tibi sedes iniquitátis: * qui fingis labórem in præcépto?
\q1 \v 21 Captábunt in ánimam justi: * et sánguinem innocéntem condemnábunt.
\q1 \v 22 Et factus est mihi Dóminus in refúgium: * et Deus meus in adjutórium spei meæ.
\q1 \v 23 Et reddet illis iniquitátem ipsórum: et in malítia eórum dispérdet eos: * dispérdet illos Dóminus, Deus noster.
\c 94
\q1 \v 1 Veníte, exsultémus Dómino: * jubilémus Deo salutári nostro:
\q1 \v 2 Præoccupémus fáciem ejus in confessióne: * et in psalmis jubilémus ei.
\q1 \v 3 Quóniam Deus magnus Dóminus: * et Rex magnus super omnes deos.
\q1 \v 4 Quia in manu ejus sunt omnes fines terræ: * et altitúdines móntium ipsíus sunt.
\q1 \v 5 Quóniam ipsíus est mare, et ipse fecit illud: * et siccam manus ejus formavérunt.
\q1 \v 7 Et nos pópulus páscuæ ejus, et oves manus ejus. * Hódie si vocem ejus audiéritis, nolíte obduráre corda vestra:
\q1 \v 8 Sicut in irritatióne secúndum diem tentatiónis in desérto: * ubi tentavérunt me patres vestri, probavérunt me, et vidérunt ópera mea.
\q1 \v 9 Quadragínta annis offénsus fui generatióni illi, * et dixi: Semper hi errant corde.
\q1 \v 10 Et isti non cognovérunt vias meas, ut jurávi in ira mea: * Si introíbunt in réquiem meam.
\c 95
\q1 \v 1 Cantáte Dómino cánticum novum: * cantáte Dómino, omnis terra.
\q1 \v 2 Cantáte Dómino, et benedícite nómini ejus: * annuntiáte de die in diem salutáre ejus.
\q1 \v 3 Annuntiáte inter gentes glóriam ejus, * in ómnibus pópulis mirabília ejus.
\q1 \v 4 Quóniam magnus Dóminus, et laudábilis nimis: * terríbilis est super omnes deos.
\q1 \v 5 Quóniam omnes dii géntium dæmónia: * Dóminus autem cælos fecit.
\q1 \v 6 Conféssio, et pulchritúdo in conspéctu ejus: * sanctimónia et magnificéntia in sanctificatióne ejus.
\q1 \v 7 Afférte Dómino, pátriæ géntium, afférte Dómino glóriam et honórem: * afférte Dómino glóriam nómini ejus.
\q1 \v 8 Tóllite hóstias, et introíte in átria ejus: * adoráte Dóminum in átrio sancto ejus.
\q1 \v 9 Commoveátur a fácie ejus univérsa terra: * dícite in géntibus quia Dóminus regnávit.
\q1 \v 10 Étenim corréxit orbem terræ qui non commovébitur: * judicábit pópulos in æquitáte.
\q1 \v 11 Læténtur cæli, et exsúltet terra: commoveátur mare, et plenitúdo ejus: * gaudébunt campi, et ómnia quæ in eis sunt.
\q1 \v 12 Tunc exsultábunt ómnia ligna silvárum a fácie Dómini, quia venit: * quóniam venit judicáre terram.
\q1 \v 13 Judicábit orbem terræ in æquitáte, * et pópulos in veritáte sua.
\c 96
\q1 \v 1 Dóminus regnávit, exsúltet terra: * læténtur ínsulæ multæ.
\q1 \v 2 Nubes, et calígo in circúitu ejus: * justítia, et judícium corréctio sedis ejus.
\q1 \v 3 Ignis ante ipsum præcédet, * et inflammábit in circúitu inimícos ejus.
\q1 \v 4 Illuxérunt fúlgura ejus orbi terræ: * vidit, et commóta est terra.
\q1 \v 5 Montes, sicut cera fluxérunt a fácie Dómini: * a fácie Dómini omnis terra.
\q1 \v 6 Annuntiavérunt cæli justítiam ejus: * et vidérunt omnes pópuli glóriam ejus.
\q1 \v 7 Confundántur omnes, qui adórant sculptília: * et qui gloriántur in simulácris suis.
\q1 Adoráte eum, omnes Ángeli ejus: * audívit, et lætáta est Sion.
\q1 \v 8 Et exsultavérunt fíliæ Judæ, * propter judícia tua, Dómine:
\q1 \v 9 Quóniam tu Dóminus Altíssimus super omnem terram: * nimis exaltátus es super omnes deos.
\q1 \v 10 Qui dilígitis Dóminum, odíte malum: * custódit Dóminus ánimas sanctórum suórum, de manu peccatóris liberábit eos.
\q1 \v 11 Lux orta est justo, * et rectis corde lætítia.
\q1 \v 12 Lætámini, justi, in Dómino: * et confitémini memóriæ sanctificatiónis ejus.
\c 97
\q1 \v 1 Cantáte Dómino cánticum novum: * quia mirabília fecit.
\q1 Salvávit sibi déxtera ejus: * et brácchium sanctum ejus.
\q1 \v 2 Notum fecit Dóminus salutáre suum: * in conspéctu géntium revelávit justítiam suam.
\q1 \v 3 Recordátus est misericórdiæ suæ, * et veritátis suæ dómui Israël.
\q1 Vidérunt omnes términi terræ * salutáre Dei nostri.
\q1 \v 4 Jubiláte Deo, omnis terra: * cantáte, et exsultáte, et psállite.
\q1 \v 5 Psállite Dómino in cíthara, in cíthara et voce psalmi: * in tubis ductílibus, et voce tubæ córneæ.
\q1 \v 6 Jubiláte in conspéctu regis Dómini: * moveátur mare, et plenitúdo ejus: orbis terrárum, et qui hábitant in eo.
\q1 \v 8 Flúmina plaudent manu, simul montes exsultábunt a conspéctu Dómini: * quóniam venit judicáre terram.
\q1 \v 9 Judicábit orbem terrárum in justítia, * et pópulos in æquitáte.
\c 98
\q1 \v 1 Dóminus regnávit, irascántur pópuli: * qui sedet super Chérubim, moveátur terra.
\q1 \v 2 Dóminus in Sion magnus: * et excélsus super omnes pópulos.
\q1 \v 3 Confiteántur nómini tuo magno: quóniam terríbile, et sanctum est: * et honor regis judícium díligit.
\q1 \v 4 Tu parásti directiónes: * judícium et justítiam in Jacob tu fecísti.
\q1 \v 5 Exaltáte Dóminum, Deum nostrum, et adoráte scabéllum pedum ejus: * quóniam sanctum est.
\q1 \v 6 Móyses et Aaron in sacerdótibus ejus: * et Sámuel inter eos, qui ínvocant nomen ejus:
\q1 Invocábant Dóminum, et ipse exaudiébat eos: * in colúmna nubis loquebátur ad eos.
\q1 \v 7 Custodiébant testimónia ejus, * et præcéptum quod dedit illis.
\q1 \v 8 Dómine, Deus noster, tu exaudiébas eos: * Deus, tu propítius fuísti eis, et ulcíscens in omnes adinventiónes eórum.
\q1 \v 9 Exaltáte Dóminum, Deum nostrum, et adoráte in monte sancto ejus: * quóniam sanctus Dóminus, Deus noster.
\c 99
\q1 \v 2 Jubiláte Deo, omnis terra: * servíte Dómino in lætítia.
\q1 Introíte in conspéctu ejus, * in exsultatióne.
\q1 \v 3 Scitóte quóniam Dóminus ipse est Deus: * ipse fecit nos, et non ipsi nos.
\q1 Pópulus ejus, et oves páscuæ ejus: ‡ (4a) introíte portas ejus in confessióne, * átria ejus in hymnis: confitémini illi.
\q1 \v 4 Laudáte nomen ejus: (5) quóniam suávis est Dóminus, † in ætérnum misericórdia ejus, * et usque in generatiónem et generatiónem véritas ejus.
\c 100
\q1 \v 1 Misericórdiam, et judícium * cantábo tibi, Dómine:
\q1 \v 2 Psallam, et intéllegam in via immaculáta, * quando vénies ad me.
\q1 Perambulábam in innocéntia cordis mei, * in médio domus meæ.
\q1 \v 3 Non proponébam ante óculos meos rem injústam: * faciéntes prævaricatiónes odívi.
\q1 \v 4 Non adhǽsit mihi cor pravum: * declinántem a me malígnum non cognoscébam.
\q1 \v 5 Detrahéntem secréto próximo suo, * hunc persequébar.
\q1 Supérbo óculo, et insatiábili corde, * cum hoc non edébam.
\q1 \v 6 Óculi mei ad fidéles terræ ut sédeant mecum: * ámbulans in via immaculáta, hic mihi ministrábat.
\q1 \v 7 Non habitábit in médio domus meæ qui facit supérbiam: * qui lóquitur iníqua, non diréxit in conspéctu oculórum meórum.
\q1 \v 8 In matutíno interficiébam omnes peccatóres terræ: * ut dispérderem de civitáte Dómini omnes operántes iniquitátem.
\c 101
\q1 \v 2 Dómine, exáudi oratiónem meam: * et clamor meus ad te véniat.
\q1 \v 3 Non avértas fáciem tuam a me: * in quacúmque die tríbulor, inclína ad me aurem tuam.
\q1 In quacúmque die invocávero te, * velóciter exáudi me.
\q1 \v 4 Quia defecérunt sicut fumus dies mei: * et ossa mea sicut crémium aruérunt.
\q1 \v 5 Percússus sum ut fænum, et áruit cor meum: * quia oblítus sum comédere panem meum.
\q1 \v 6 A voce gémitus mei * adhǽsit os meum carni meæ.
\q1 \v 7 Símilis factus sum pellicáno solitúdinis: * factus sum sicut nyctícorax in domicílio.
\q1 \v 8 Vigilávi, * et factus sum sicut passer solitárius in tecto.
\q1 \v 9 Tota die exprobrábant mihi inimíci mei: * et qui laudábant me, advérsum me jurábant.
\q1 \v 10 Quia cínerem tamquam panem manducábam, * et potum meum cum fletu miscébam.
\q1 \v 11 A fácie iræ et indignatiónis tuæ: * quia élevans allisísti me.
\q1 \v 12 Dies mei sicut umbra declinavérunt: * et ego sicut fænum árui.
\q1 \v 13 Tu autem, Dómine, in ætérnum pérmanes: * et memoriále tuum in generatiónem et generatiónem.
\q1 \v 14 Tu exsúrgens miseréberis Sion: * quia tempus miseréndi ejus, quia venit tempus.
\q1 \v 15 Quóniam placuérunt servis tuis lápides ejus: * et terræ ejus miserebúntur.
\q1 \v 16 Et timébunt gentes nomen tuum, Dómine, * et omnes reges terræ glóriam tuam.
\q1 \v 17 Quia ædificávit Dóminus Sion: * et vidébitur in glória sua.
\q1 \v 18 Respéxit in oratiónem humílium: * et non sprevit precem eórum.
\q1 \v 19 Scribántur hæc in generatióne áltera: * et pópulus, qui creábitur, laudábit Dóminum:
\q1 \v 20 Quia prospéxit de excélso sancto suo: * Dóminus de cælo in terram aspéxit:
\q1 \v 21 Ut audíret gémitus compeditórum: * ut sólveret fílios interemptórum:
\q1 \v 22 Ut annúntient in Sion nomen Dómini: * et laudem ejus in Jerúsalem.
\q1 \v 23 In conveniéndo pópulos in unum, * et reges ut sérviant Dómino.
\q1 \v 24 Respóndit ei in via virtútis suæ: * Paucitátem diérum meórum núntia mihi.
\q1 \v 25 Ne révoces me in dimídio diérum meórum: * in generatiónem et generatiónem anni tui.
\q1 \v 26 Inítio tu, Dómine, terram fundásti: * et ópera mánuum tuárum sunt cæli.
\q1 \v 27 Ipsi períbunt, tu autem pérmanes: * et omnes sicut vestiméntum veteráscent.
\q1 \v 28 Et sicut opertórium mutábis eos, et mutabúntur: * tu autem idem ipse es, et anni tui non defícient.
\q1 \v 29 Fílii servórum tuórum habitábunt: * et semen eórum in sǽculum dirigétur.
\c 102
\q1 \v 1 Bénedic, ánima mea, Dómino: * et ómnia, quæ intra me sunt, nómini sancto ejus.
\q1 \v 2 Bénedic, ánima mea, Dómino: * et noli oblivísci omnes retributiónes ejus.
\q1 \v 3 Qui propitiátur ómnibus iniquitátibus tuis: * qui sanat omnes infirmitátes tuas.
\q1 \v 4 Qui rédimit de intéritu vitam tuam: * qui corónat te in misericórdia et miseratiónibus.
\q1 \v 5 Qui replet in bonis desidérium tuum: * renovábitur ut áquilæ juvéntus tua:
\q1 \v 6 Fáciens misericórdias Dóminus: * et judícium ómnibus injúriam patiéntibus.
\q1 \v 7 Notas fecit vias suas Móysi, * fíliis Israël voluntátes suas.
\q1 \v 8 Miserátor, et miséricors Dóminus: * longánimis, et multum miséricors.
\q1 \v 9 Non in perpétuum irascétur: * neque in ætérnum comminábitur.
\q1 \v 10 Non secúndum peccáta nostra fecit nobis: * neque secúndum iniquitátes nostras retríbuit nobis.
\q1 \v 11 Quóniam secúndum altitúdinem cæli a terra: * corroborávit misericórdiam suam super timéntes se.
\q1 \v 12 Quantum distat ortus ab occidénte: * longe fecit a nobis iniquitátes nostras.
\q1 \v 13 Quómodo miserétur pater filiórum, misértus est Dóminus timéntibus se: * quóniam ipse cognóvit figméntum nostrum.
\q1 \v 14 Recordátus est quóniam pulvis sumus: * homo, sicut fænum dies ejus, tamquam flos agri sic efflorébit.
\q1 \v 16 Quóniam spíritus pertransíbit in illo, et non subsístet: * et non cognóscet ámplius locum suum.
\q1 \v 17 Misericórdia autem Dómini ab ætérno, * et usque in ætérnum super timéntes eum.
\q1 Et justítia illíus in fílios filiórum, * his qui servant testaméntum ejus:
\q1 \v 18 Et mémores sunt mandatórum ipsíus, * ad faciéndum ea.
\q1 \v 19 Dóminus in cælo parávit sedem suam: * et regnum ipsíus ómnibus dominábitur.
\q1 \v 20 Benedícite Dómino, omnes Ángeli ejus: * poténtes virtúte, faciéntes verbum illíus, ad audiéndam vocem sermónum ejus.
\q1 \v 21 Benedícite Dómino, omnes virtútes ejus: * minístri ejus, qui fácitis voluntátem ejus.
\q1 \v 22 Benedícite Dómino, ómnia ópera ejus: * in omni loco dominatiónis ejus, bénedic, ánima mea, Dómino.
\c 103
\q1 \v 1 Bénedic, ánima mea, Dómino: * Dómine, Deus meus, magnificátus es veheménter.
\q1 Confessiónem, et decórem induísti: * amíctus lúmine sicut vestiménto:
\q1 \v 2 Exténdens cælum sicut pellem: * qui tegis aquis superióra ejus.
\q1 \v 3 Qui ponis nubem ascénsum tuum: * qui ámbulas super pennas ventórum.
\q1 \v 4 Qui facis ángelos tuos, spíritus: * et minístros tuos ignem uréntem.
\q1 \v 5 Qui fundásti terram super stabilitátem suam: * non inclinábitur in sǽculum sǽculi.
\q1 \v 6 Abýssus, sicut vestiméntum, amíctus ejus: * super montes stabunt aquæ.
\q1 \v 7 Ab increpatióne tua fúgient: * a voce tonítrui tui formidábunt.
\q1 \v 8 Ascéndunt montes: et descéndunt campi * in locum, quem fundásti eis.
\q1 \v 9 Términum posuísti, quem non transgrediéntur: * neque converténtur operíre terram.
\q1 \v 10 Qui emíttis fontes in convállibus: * inter médium móntium pertransíbunt aquæ.
\q1 \v 11 Potábunt omnes béstiæ agri: * exspectábunt ónagri in siti sua.
\q1 \v 12 Super ea vólucres cæli habitábunt: * de médio petrárum dabunt voces.
\q1 \v 13 Rigans montes de superióribus suis: * de fructu óperum tuórum satiábitur terra:
\q1 \v 14 Prodúcens fænum juméntis, * et herbam servitúti hóminum:
\q1 Ut edúcas panem de terra: * et vinum lætíficet cor hóminis:
\q1 \v 15 Ut exhílaret fáciem in óleo: * et panis cor hóminis confírmet.
\q1 \v 16 Saturabúntur ligna campi, et cedri Líbani, quas plantávit: * illic pásseres nidificábunt.
\q1 \v 17 Heródii domus dux est eórum: * montes excélsi cervis: petra refúgium herináciis.
\q1 \v 19 Fecit lunam in témpora: * sol cognóvit occásum suum.
\q1 \v 20 Posuísti ténebras, et facta est nox: * in ipsa pertransíbunt omnes béstiæ silvæ.
\q1 \v 21 Cátuli leónum rugiéntes, ut rápiant, * et quærant a Deo escam sibi.
\q1 \v 22 Ortus est sol, et congregáti sunt: * et in cubílibus suis collocabúntur.
\q1 \v 23 Exíbit homo ad opus suum: * et ad operatiónem suam usque ad vésperum.
\q1 \v 24 Quam magnificáta sunt ópera tua, Dómine! * ómnia in sapiéntia fecísti: impléta est terra possessióne tua.
\q1 \v 25 Hoc mare magnum, et spatiósum mánibus: * illic reptília, quorum non est númerus.
\q1 \v 26 Animália pusílla cum magnis: * illic naves pertransíbunt.
\q1 \v 27 Draco iste, quem formásti ad illudéndum ei: * ómnia a te exspéctant ut des illis escam in témpore.
\q1 \v 28 Dante te illis, cólligent: * aperiénte te manum tuam, ómnia implebúntur bonitáte.
\q1 \v 29 Averténte autem te fáciem, turbabúntur: * áuferes spíritum eórum, et defícient, et in púlverem suum reverténtur.
\q1 \v 30 Emíttes spíritum tuum, et creabúntur: * et renovábis fáciem terræ.
\q1 \v 31 Sit glória Dómini in sǽculum: * lætábitur Dóminus in opéribus suis:
\q1 \v 32 Qui réspicit terram, et facit eam trémere: * qui tangit montes, et fúmigant.
\q1 \v 33 Cantábo Dómino in vita mea: * psallam Deo meo, quámdiu sum.
\q1 \v 34 Jucúndum sit ei elóquium meum: * ego vero delectábor in Dómino.
\q1 \v 35 Defíciant peccatóres a terra, et iníqui ita ut non sint: * bénedic, ánima mea, Dómino.
\c 104
\q1 \v 1 Confitémini Dómino, et invocáte nomen ejus: * annuntiáte inter gentes ópera ejus.
\q1 \v 2 Cantáte ei, et psállite ei: * narráte ómnia mirabília ejus.
\q1 \v 3 Laudámini in nómine sancto ejus: * lætétur cor quæréntium Dóminum.
\q1 \v 4 Quǽrite Dóminum, et confirmámini: * quǽrite fáciem ejus semper.
\q1 \v 5 Mementóte mirabílium ejus, quæ fecit: * prodígia ejus, et judícia oris ejus.
\q1 \v 6 Semen Ábraham, servi ejus: * fílii Jacob, elécti ejus.
\q1 \v 7 Ipse Dóminus Deus noster: * in univérsa terra judícia ejus.
\q1 \v 8 Memor fuit in sǽculum testaménti sui: * verbi, quod mandávit in mille generatiónes:
\q1 \v 9 Quod dispósuit ad Ábraham: * et juraménti sui ad Isaac:
\q1 \v 10 Et státuit illud Jacob in præcéptum: * et Israël in testaméntum ætérnum:
\q1 \v 11 Dicens: Tibi dabo terram Chánaan, * funículum hereditátis vestræ.
\q1 \v 12 Cum essent número brevi, * paucíssimi et íncolæ ejus:
\q1 \v 13 Et pertransiérunt de gente in gentem, * et de regno ad pópulum álterum.
\q1 \v 14 Non relíquit hóminem nocére eis: * et corrípuit pro eis reges.
\q1 \v 15 Nolíte tángere christos meos: * et in prophétis meis nolíte malignári.
\q1 \v 16 Et vocávit famem super terram: * et omne firmaméntum panis contrívit.
\q1 \v 17 Misit ante eos virum: * in servum venúmdatus est Joseph.
\q1 \v 18 Humiliavérunt in compédibus pedes ejus, ferrum pertránsiit ánimam ejus * donec veníret verbum ejus.
\q1 \v 19 Elóquium Dómini inflammávit eum: * misit rex, et solvit eum; princeps populórum, et dimísit eum.
\q1 \v 21 Constítuit eum dóminum domus suæ: * et príncipem omnis possessiónis suæ:
\q1 \v 22 Ut erudíret príncipes ejus sicut semetípsum: * et senes ejus prudéntiam docéret.
\q1 \v 23 Et intrávit Israël in Ægýptum: * et Jacob áccola fuit in terra Cham.
\q1 \v 24 Et auxit pópulum suum veheménter: * et firmávit eum super inimícos ejus.
\q1 \v 25 Convértit cor eórum ut odírent pópulum ejus: * et dolum fácerent in servos ejus.
\q1 \v 26 Misit Móysen, servum suum: * Aaron, quem elégit ipsum.
\q1 \v 27 Pósuit in eis verba signórum suórum: * et prodigiórum in terra Cham.
\q1 \v 28 Misit ténebras, et obscurávit: * et non exacerbávit sermónes suos.
\q1 \v 29 Convértit aquas eórum in sánguinem: * et occídit pisces eórum.
\q1 \v 30 Édidit terra eórum ranas: * in penetrálibus regum ipsórum.
\q1 \v 31 Dixit, et venit cœnomyía: * et cínifes in ómnibus fínibus eórum.
\q1 \v 32 Pósuit plúvias eórum grándinem: * ignem comburéntem in terra ipsórum.
\q1 \v 33 Et percússit víneas eórum, et ficúlneas eórum: * et contrívit lignum fínium eórum.
\q1 \v 34 Dixit, et venit locústa, et bruchus, * cujus non erat númerus:
\q1 \v 35 Et comédit omne fænum in terra eórum: * et comédit omnem fructum terræ eórum.
\q1 \v 36 Et percússit omne primogénitum in terra eórum: * primítias omnis labóris eórum.
\q1 \v 37 Et edúxit eos cum argénto et auro: * et non erat in tríbubus eórum infírmus.
\q1 \v 38 Lætáta est Ægýptus in profectióne eórum: * quia incúbuit timor eórum super eos.
\q1 \v 39 Expándit nubem in protectiónem eórum: * et ignem ut lucéret eis per noctem.
\q1 \v 40 Petiérunt, et venit cotúrnix: * et pane cæli saturávit eos.
\q1 \v 41 Dirúpit petram et fluxérunt aquæ: * abiérunt in sicco flúmina;
\q1 \v 42 Quóniam memor fuit verbi sancti sui: * quod hábuit ad Ábraham, púerum suum.
\q1 \v 43 Et edúxit pópulum suum in exsultatióne, * et eléctos suos in lætítia.
\q1 \v 44 Et dedit illis regiónes géntium: * et labóres populórum possedérunt:
\q1 \v 45 Ut custódiant justificatiónes ejus, * et legem ejus requírant.
\c 105
\q1 \v 1 Confitémini Dómino, quóniam bonus: * quóniam in sǽculum misericórdia ejus.
\q1 \v 2 Quis loquétur poténtias Dómini, * audítas fáciet omnes laudes ejus?
\q1 \v 3 Beáti, qui custódiunt judícium, * et fáciunt justítiam in omni témpore.
\q1 \v 4 Meménto nostri, Dómine, in beneplácito pópuli tui: * vísita nos in salutári tuo:
\q1 \v 5 Ad vidéndum in bonitáte electórum tuórum, ad lætándum in lætítia gentis tuæ: * ut laudéris cum hereditáte tua.
\q1 \v 6 Peccávimus cum pátribus nostris: * injúste égimus, iniquitátem fécimus.
\q1 \v 7 Patres nostri in Ægýpto non intellexérunt mirabília tua: * non fuérunt mémores multitúdinis misericórdiæ tuæ.
\q1 Et irritavérunt ascendéntes in mare, * Mare Rubrum.
\q1 \v 8 Et salvávit eos propter nomen suum: * ut notam fáceret poténtiam suam.
\q1 \v 9 Et incrépuit Mare Rubrum, et exsiccátum est, * et dedúxit eos in abýssis sicut in desérto.
\q1 \v 10 Et salvávit eos de manu odiéntium: * et redémit eos de manu inimíci.
\q1 \v 11 Et opéruit aqua tribulántes eos: * unus ex eis non remánsit.
\q1 \v 12 Et credidérunt verbis ejus: * et laudavérunt laudem ejus.
\q1 \v 13 Cito fecérunt, oblíti sunt óperum ejus: * et non sustinuérunt consílium ejus.
\q1 \v 14 Et concupiérunt concupiscéntiam in desérto: * et tentavérunt Deum in inaquóso.
\q1 \v 15 Et dedit eis petitiónem ipsórum: * et misit saturitátem in ánimas eórum.
\q1 \v 16 Et irritavérunt Móysen in castris: * Aaron, sanctum Dómini.
\q1 \v 17 Apérta est terra, et deglutívit Dathan: * et opéruit super congregatiónem Abíron.
\q1 \v 18 Et exársit ignis in synagóga eórum * flamma combússit peccatóres.
\q1 \v 19 Et fecérunt vítulum in Horeb * et adoravérunt scúlptile.
\q1 \v 20 Et mutavérunt glóriam suam * in similitúdinem vítuli comedéntis fænum.
\q1 \v 21 Oblíti sunt Deum, qui salvávit eos, * qui fecit magnália in Ægýpto, mirabília in terra Cham: terribília in Mari Rubro.
\q1 \v 23 Et dixit ut dispérderet eos: * si non Móyses, eléctus ejus, stetísset in confractióne in conspéctu ejus:
\q1 \v 24 Ut avérteret iram ejus ne dispérderet eos: * et pro níhilo habuérunt terram desiderábilem:
\q1 \v 25 Non credidérunt verbo ejus, et murmuravérunt in tabernáculis suis: * non exaudiérunt vocem Dómini.
\q1 \v 26 Et elevávit manum suam super eos: * ut prostérneret eos in desérto:
\q1 \v 27 Et ut deíceret semen eórum in natiónibus: * et dispérgeret eos in regiónibus.
\q1 \v 28 Et initiáti sunt Beélphegor: * et comedérunt sacrifícia mortuórum.
\q1 \v 29 Et irritavérunt eum in adinventiónibus suis: * et multiplicáta est in eis ruína.
\q1 \v 30 Et stetit Phínees, et placávit: * et cessávit quassátio.
\q1 \v 31 Et reputátum est ei in justítiam: * in generatiónem et generatiónem usque in sempitérnum.
\q1 \v 32 Et irritavérunt eum ad aquas contradictiónis: * et vexátus est Móyses propter eos: quia exacerbavérunt spíritum ejus.
\q1 \v 33 Et distínxit in lábiis suis: * non disperdidérunt gentes, quas dixit Dóminus illis.
\q1 \v 35 Et commísti sunt inter gentes, et didicérunt ópera eórum: et serviérunt sculptílibus eórum: * et factum est illis in scándalum.
\q1 \v 37 Et immolavérunt fílios suos, * et fílias suas dæmóniis.
\q1 \v 38 Et effudérunt sánguinem innocéntem: * sánguinem filiórum suórum et filiárum suárum, quas sacrificavérunt sculptílibus Chánaan.
\q1 \v 39 Et infécta est terra in sanguínibus, et contamináta est in opéribus eórum: * et fornicáti sunt in adinventiónibus suis.
\q1 \v 40 Et irátus est furóre Dóminus in pópulum suum: * et abominátus est hereditátem suam.
\q1 \v 41 Et trádidit eos in manus géntium: * et domináti sunt eórum qui odérunt eos.
\q1 \v 42 Et tribulavérunt eos inimíci eórum, et humiliáti sunt sub mánibus eórum: * sæpe liberávit eos.
\q1 \v 43 Ipsi autem exacerbavérunt eum in consílio suo: * et humiliáti sunt in iniquitátibus suis.
\q1 \v 44 Et vidit, cum tribularéntur: * et audívit oratiónem eórum.
\q1 \v 45 Et memor fuit testaménti sui: * et pœnítuit eum secúndum multitúdinem misericórdiæ suæ.
\q1 \v 46 Et dedit eos in misericórdias * in conspéctu ómnium qui céperant eos.
\q1 \v 47 Salvos nos fac, Dómine, Deus noster: * et cóngrega nos de natiónibus:
\q1 Ut confiteámur nómini sancto tuo: * et gloriémur in laude tua.
\q1 \v 48 Benedíctus Dóminus, Deus Israël, a sǽculo et usque in sǽculum: * et dicet omnis pópulus: Fiat, fiat.
\c 106
\q1 \v 1 Confitémini Dómino quóniam bonus: * quóniam in sǽculum misericórdia ejus.
\q1 \v 2 Dicant qui redémpti sunt a Dómino, quos redémit de manu inimíci: * et de regiónibus congregávit eos:
\q1 \v 3 A solis ortu, et occásu: * ab aquilóne, et mari.
\q1 \v 4 Erravérunt in solitúdine in inaquóso: * viam civitátis habitáculi non invenérunt.
\q1 \v 5 Esuriéntes, et sitiéntes: * ánima eórum in ipsis defécit.
\q1 \v 6 Et clamavérunt ad Dóminum cum tribularéntur: * et de necessitátibus eórum erípuit eos.
\q1 \v 7 Et dedúxit eos in viam rectam: * ut irent in civitátem habitatiónis.
\q1 \v 8 Confiteántur Dómino misericórdiæ ejus: * et mirabília ejus fíliis hóminum.
\q1 \v 9 Quia satiávit ánimam inánem: * et ánimam esuriéntem satiávit bonis.
\q1 \v 10 Sedéntes in ténebris, et umbra mortis: * vinctos in mendicitáte et ferro.
\q1 \v 11 Quia exacerbavérunt elóquia Dei: * et consílium Altíssimi irritavérunt.
\q1 \v 12 Et humiliátum est in labóribus cor eórum: * infirmáti sunt, nec fuit qui adjuváret.
\q1 \v 13 Et clamavérunt ad Dóminum cum tribularéntur: * et de necessitátibus eórum liberávit eos.
\q1 \v 14 Et edúxit eos de ténebris, et umbra mortis: * et víncula eórum disrúpit.
\q1 \v 15 Confiteántur Dómino misericórdiæ ejus: * et mirabília ejus fíliis hóminum.
\q1 \v 16 Quia contrívit portas ǽreas: * et vectes férreos confrégit.
\q1 \v 17 Suscépit eos de via iniquitátis eórum: * propter injustítias enim suas humiliáti sunt.
\q1 \v 18 Omnem escam abomináta est ánima eórum: * et appropinquavérunt usque ad portas mortis.
\q1 \v 19 Et clamavérunt ad Dóminum cum tribularéntur: * et de necessitátibus eórum liberávit eos.
\q1 \v 20 Misit verbum suum, et sanávit eos: * et erípuit eos de interitiónibus eórum.
\q1 \v 21 Confiteántur Dómino misericórdiæ ejus: * et mirabília ejus fíliis hóminum.
\q1 \v 22 Et sacríficent sacrifícium laudis: * et annúntient ópera ejus in exsultatióne.
\q1 \v 23 Qui descéndunt mare in návibus, * faciéntes operatiónem in aquis multis.
\q1 \v 24 Ipsi vidérunt ópera Dómini, * et mirabília ejus in profúndo.
\q1 \v 25 Dixit, et stetit spíritus procéllæ: * et exaltáti sunt fluctus ejus.
\q1 \v 26 Ascéndunt usque ad cælos, et descéndunt usque ad abýssos: * ánima eórum in malis tabescébat.
\q1 \v 27 Turbáti sunt, et moti sunt sicut ébrius: * et omnis sapiéntia eórum devoráta est.
\q1 \v 28 Et clamavérunt ad Dóminum cum tribularéntur: * et de necessitátibus eórum edúxit eos.
\q1 \v 29 Et státuit procéllam ejus in auram: * et siluérunt fluctus ejus.
\q1 \v 30 Et lætáti sunt quia siluérunt: * et dedúxit eos in portum voluntátis eórum.
\q1 \v 31 Confiteántur Dómino misericórdiæ ejus: * et mirabília ejus fíliis hóminum.
\q1 \v 32 Et exáltent eum in ecclésia plebis: * et in cáthedra seniórum laudent eum.
\q1 \v 33 Pósuit flúmina in desértum: * et éxitus aquárum in sitim.
\q1 \v 34 Terram fructíferam in salsúginem: * a malítia inhabitántium in ea.
\q1 \v 35 Pósuit desértum in stagna aquárum: * et terram sine aqua in éxitus aquárum.
\q1 \v 36 Et collocávit illic esuriéntes: * et constituérunt civitátem habitatiónis.
\q1 \v 37 Et seminavérunt agros, et plantavérunt víneas: * et fecérunt fructum nativitátis.
\q1 \v 38 Et benedíxit eis, et multiplicáti sunt nimis: * et juménta eórum non minorávit.
\q1 \v 39 Et pauci facti sunt: * et vexáti sunt a tribulatióne malórum, et dolóre.
\q1 \v 40 Effúsa est contémptio super príncipes: * et erráre fecit eos in ínvio, et non in via.
\q1 \v 41 Et adjúvit páuperem de inópia: * et pósuit sicut oves famílias.
\q1 \v 42 Vidébunt recti, et lætabúntur: * et omnis iníquitas oppilábit os suum.
\q1 \v 43 Quis sápiens et custódiet hæc? * et intélleget misericórdias Dómini.
\c 107
\q1 \v 2 Parátum cor meum, Deus, parátum cor meum: * cantábo, et psallam in glória mea.
\q1 \v 3 Exsúrge, glória mea, exsúrge, psaltérium et cíthara: * exsúrgam dilúculo.
\q1 \v 4 Confitébor tibi in pópulis, Dómine: * et psallam tibi in natiónibus.
\q1 \v 5 Quia magna est super cælos misericórdia tua: * et usque ad nubes véritas tua:
\q1 \v 6 Exaltáre super cælos, Deus, et super omnem terram glória tua: * ut liberéntur dilécti tui.
\q1 \v 7 Salvum fac déxtera tua, et exáudi me: * Deus locútus est in sancto suo:
\q1 \v 8 Exsultábo, et dívidam Síchimam, * et convállem tabernaculórum dimétiar.
\q1 \v 9 Meus est Gálaad, et meus est Manásses: * et Éphraim suscéptio cápitis mei.
\q1 \v 10 Juda rex meus: * Moab lebes spei meæ.
\q1 In Idumǽam exténdam calceaméntum meum: * mihi alienígenæ amíci facti sunt.
\q1 \v 11 Quis dedúcet me in civitátem munítam? * quis dedúcet me usque in Idumǽam?
\q1 \v 12 Nonne tu, Deus, qui repulísti nos, * et non exíbis, Deus, in virtútibus nostris?
\q1 \v 13 Da nobis auxílium de tribulatióne: * quia vana salus hóminis.
\q1 \v 14 In Deo faciémus virtútem: * et ipse ad níhilum dedúcet inimícos nostros.
\c 108
\q1 \v 2 Deus, laudem meam ne tacúeris: * quia os peccatóris, et os dolósi super me apértum est.
\q1 \v 3 Locúti sunt advérsum me lingua dolósa, et sermónibus ódii circumdedérunt me: * et expugnavérunt me gratis.
\q1 \v 4 Pro eo ut me dilígerent, detrahébant mihi: * ego autem orábam.
\q1 \v 5 Et posuérunt advérsum me mala pro bonis: * et ódium pro dilectióne mea.
\q1 \v 6 Constítue super eum peccatórem: * et diábolus stet a dextris ejus.
\q1 \v 7 Cum judicátur, éxeat condemnátus: * et orátio ejus fiat in peccátum.
\q1 \v 8 Fiant dies ejus pauci: * et episcopátum ejus accípiat alter.
\q1 \v 9 Fiant fílii ejus órphani: * et uxor ejus vídua.
\q1 \v 10 Nutántes transferántur fílii ejus, et mendícent: * et eiciántur de habitatiónibus suis.
\q1 \v 11 Scrutétur fænerátor omnem substántiam ejus: * et dirípiant aliéni labóres ejus.
\q1 \v 12 Non sit illi adjútor: * nec sit qui misereátur pupíllis ejus.
\q1 \v 13 Fiant nati ejus in intéritum: * in generatióne una deleátur nomen ejus.
\q1 \v 14 In memóriam rédeat iníquitas patrum ejus in conspéctu Dómini: * et peccátum matris ejus non deleátur.
\q1 \v 15 Fiant contra Dóminum semper, et dispéreat de terra memória eórum: * pro eo quod non est recordátus fácere misericórdiam.
\q1 \v 17 Et persecútus est hóminem ínopem, et mendícum, * et compúnctum corde mortificáre.
\q1 \v 18 Et diléxit maledictiónem, et véniet ei: * et nóluit benedictiónem, et elongábitur ab eo.
\q1 Et índuit maledictiónem sicut vestiméntum, * et intrávit sicut aqua in interióra ejus, et sicut óleum in óssibus ejus.
\q1 \v 19 Fiat ei sicut vestiméntum, quo operítur: * et sicut zona, qua semper præcíngitur.
\q1 \v 20 Hoc opus eórum, qui détrahunt mihi apud Dóminum: * et qui loquúntur mala advérsus ánimam meam.
\q1 \v 21 Et tu, Dómine, Dómine, fac mecum propter nomen tuum: * quia suávis est misericórdia tua.
\q1 \v 22 Líbera me quia egénus, et pauper ego sum: * et cor meum conturbátum est intra me.
\q1 \v 23 Sicut umbra cum declínat, ablátus sum: * et excússus sum sicut locústæ.
\q1 \v 24 Génua mea infirmáta sunt a jejúnio: * et caro mea immutáta est propter óleum.
\q1 \v 25 Et ego factus sum oppróbrium illis: * vidérunt me, et movérunt cápita sua.
\q1 \v 26 Ádjuva me, Dómine, Deus meus: * salvum me fac secúndum misericórdiam tuam.
\q1 \v 27 Et sciant quia manus tua hæc: * et tu, Dómine, fecísti eam.
\q1 \v 28 Maledícent illi, et tu benedíces: * qui insúrgunt in me, confundántur: servus autem tuus lætábitur.
\q1 \v 29 Induántur qui détrahunt mihi, pudóre: * et operiántur sicut diplóide confusióne sua.
\q1 \v 30 Confitébor Dómino nimis in ore meo: * et in médio multórum laudábo eum.
\q1 \v 31 Quia ástitit a dextris páuperis, * ut salvam fáceret a persequéntibus ánimam meam.
\c 109
\q1 \v 1 Dixit Dóminus Dómino meo: * Sede a dextris meis:
\q1 Donec ponam inimícos tuos, * scabéllum pedum tuórum.
\q1 \v 2 Virgam virtútis tuæ emíttet Dóminus ex Sion: * domináre in médio inimicórum tuórum.
\q1 \v 3 Tecum princípium in die virtútis tuæ in splendóribus sanctórum: * ex útero ante lucíferum génui te.
\q1 \v 4 Jurávit Dóminus, et non pœnitébit eum: * Tu es sacérdos in ætérnum secúndum órdinem Melchísedech.
\q1 \v 5 Dóminus a dextris tuis, * confrégit in die iræ suæ reges.
\q1 \v 6 Judicábit in natiónibus, implébit ruínas: * conquassábit cápita in terra multórum.
\q1 \v 7 De torrénte in via bibet: * proptérea exaltábit caput.
\c 110
\q1 \v 1 Confitébor tibi, Dómine, in toto corde meo: * in consílio justórum, et congregatióne.
\q1 \v 2 Magna ópera Dómini: * exquisíta in omnes voluntátes ejus.
\q1 \v 3 Conféssio et magnificéntia opus ejus: * et justítia ejus manet in sǽculum sǽculi.
\q1 \v 4 Memóriam fecit mirabílium suórum, † miséricors et miserátor Dóminus: * (5a) escam dedit timéntibus se.
\q1 \v 5 Memor erit in sǽculum testaménti sui: * (6) virtútem óperum suórum annuntiábit pópulo suo:
\q1 \v 7 Ut det illis hereditátem géntium: * ópera mánuum ejus véritas, et judícium.
\q1 \v 8 Fidélia ómnia mandáta ejus: † confirmáta in sǽculum sǽculi, * facta in veritáte et æquitáte.
\q1 \v 9 Redemptiónem misit pópulo suo: * mandávit in ætérnum testaméntum suum.
\q1 (fit reverentia) Sanctum, et terríbile nomen ejus: * (10a) inítium sapiéntiæ timor Dómini.
\q1 \v 10 Intelléctus bonus ómnibus faciéntibus eum: * laudátio ejus manet in sǽculum sǽculi.
\c 111
\q1 \v 1 Beátus vir, qui timet Dóminum: * in mandátis ejus volet nimis.
\q1 \v 2 Potens in terra erit semen ejus: * generátio rectórum benedicétur.
\q1 \v 3 Glória, et divítiæ in domo ejus: * et justítia ejus manet in sǽculum sǽculi.
\q1 \v 4 Exórtum est in ténebris lumen rectis: * miséricors, et miserátor, et justus.
\q1 \v 5 Jucúndus homo qui miserétur et cómmodat, † dispónet sermónes suos in judício: * (6) quia in ætérnum non commovébitur.
\q1 \v 7 In memória ætérna erit justus: * ab auditióne mala non timébit.
\q1 Parátum cor ejus speráre in Dómino, † (8) confirmátum est cor ejus: * non commovébitur donec despíciat inimícos suos.
\q1 \v 9 Dispérsit, dedit paupéribus: † justítia ejus manet in sǽculum sǽculi, * cornu ejus exaltábitur in glória.
\q1 \v 10 Peccátor vidébit, et irascétur, † déntibus suis fremet et tabéscet: * desidérium peccatórum períbit.
\c 112
\q1 \v 1 Laudáte, púeri, Dóminum: * laudáte nomen Dómini.
\q1 \v 2 (fit reverentia) Sit nomen Dómini benedíctum, * ex hoc nunc, et usque in sǽculum.
\q1 \v 3 A solis ortu usque ad occásum, * laudábile nomen Dómini.
\q1 \v 4 Excélsus super omnes gentes Dóminus, * et super cælos glória ejus.
\q1 \v 5 Quis sicut Dóminus, Deus noster, qui in altis hábitat, * (6) et humília réspicit in cælo et in terra?
\q1 \v 7 Súscitans a terra ínopem, * et de stércore érigens páuperem:
\q1 \v 8 Ut cóllocet eum cum princípibus, * cum princípibus pópuli sui.
\q1 \v 9 Qui habitáre facit stérilem in domo, * matrem filiórum lætántem.
\c 113
\q1 \v 1 In éxitu Israël de Ægýpto, * domus Jacob de pópulo bárbaro:
\q1 \v 2 Facta est Judǽa sanctificátio ejus, * Israël potéstas ejus.
\q1 \v 3 Mare vidit, et fugit: * Jordánis convérsus est retrórsum.
\q1 \v 4 Montes exsultavérunt ut aríetes, * et colles sicut agni óvium.
\q1 \v 5 Quid est tibi, mare, quod fugísti: * et tu, Jordánis, quia convérsus es retrórsum?
\q1 \v 6 Montes, exsultástis sicut aríetes, * et colles, sicut agni óvium.
\q1 \v 7 A fácie Dómini mota est terra, * a fácie Dei Jacob.
\q1 \v 8 Qui convértit petram in stagna aquárum, * et rupem in fontes aquárum.
\q1 \v 9 Non nobis, Dómine, non nobis: * sed nómini tuo da glóriam.
\q1 \v 10 Super misericórdia tua, et veritáte tua: * nequándo dicant gentes: Ubi est Deus eórum?
\q1 \v 11 Deus autem noster in cælo: * ómnia quæcúmque vóluit, fecit.
\q1 \v 12 Simulácra géntium argéntum, et aurum, * ópera mánuum hóminum.
\q1 \v 13 Os habent, et non loquéntur: * óculos habent, et non vidébunt.
\q1 \v 14 Aures habent, et non áudient: * nares habent, et non odorábunt.
\q1 \v 15 Manus habent, et non palpábunt: † pedes habent, et non ambulábunt: * non clamábunt in gútture suo.
\q1 \v 16 Símiles illis fiant qui fáciunt ea: * et omnes qui confídunt in eis.
\q1 \v 17 Domus Israël sperávit in Dómino: * adjútor eórum et protéctor eórum est,
\q1 \v 18 Domus Aaron sperávit in Dómino: * adjútor eórum et protéctor eórum est,
\q1 \v 19 Qui timent Dóminum, speravérunt in Dómino: * adjútor eórum et protéctor eórum est.
\q1 \v 20 Dóminus memor fuit nostri: * et benedíxit nobis:
\q1 Benedíxit dómui Israël: * benedíxit dómui Aaron.
\q1 \v 21 Benedíxit ómnibus, qui timent Dóminum, * pusíllis cum majóribus.
\q1 \v 22 Adíciat Dóminus super vos: * super vos, et super fílios vestros.
\q1 \v 23 Benedícti vos a Dómino, * qui fecit cælum, et terram.
\q1 \v 24 Cælum cæli Dómino: * terram autem dedit fíliis hóminum.
\q1 \v 25 Non mórtui laudábunt te, Dómine: * neque omnes, qui descéndunt in inférnum.
\q1 \v 26 Sed nos qui vívimus, benedícimus Dómino, * ex hoc nunc et usque in sǽculum.
\c 114
\q1 \v 1 Diléxi, quóniam exáudiet Dóminus * vocem oratiónis meæ.
\q1 \v 2 Quia inclinávit aurem suam mihi: * et in diébus meis invocábo.
\q1 \v 3 Circumdedérunt me dolóres mortis: * et perícula inférni invenérunt me.
\q1 Tribulatiónem et dolórem invéni: * (4a) et nomen Dómini invocávi.
\q1 \v 4 O Dómine, líbera ánimam meam: ‡ (5) miséricors Dóminus, et justus, * et Deus noster miserétur.
\q1 \v 6 Custódiens párvulos Dóminus: * humiliátus sum, et liberávit me.
\q1 \v 7 Convértere, ánima mea, in réquiem tuam: * quia Dóminus benefécit tibi.
\q1 \v 8 Quia erípuit ánimam meam de morte: ‡ óculos meos a lácrimis, * pedes meos a lapsu.
\q1 \v 9 Placébo Dómino * in regióne vivórum.
\c 115
\q1 \v 1 Crédidi, propter quod locútus sum: * ego autem humiliátus sum nimis.
\q1 \v 2 Ego dixi in excéssu meo: * Omnis homo mendax.
\q1 \v 3 Quid retríbuam Dómino, * pro ómnibus, quæ retríbuit mihi?
\q1 \v 4 Cálicem salutáris accípiam: * et nomen Dómini invocábo.
\q1 \v 5 Vota mea Dómino reddam coram omni pópulo ejus: * (6) pretiósa in conspéctu Dómini mors sanctórum ejus:
\q1 \v 7 O Dómine, quia ego servus tuus: * ego servus tuus, et fílius ancíllæ tuæ.
\q1 Dirupísti víncula mea: ‡ (8) tibi sacrificábo hóstiam laudis, * et nomen Dómini invocábo.
\q1 \v 9 Vota mea Dómino reddam in conspéctu omnis pópuli ejus: * (10) in átriis domus Dómini, in médio tui, Jerúsalem.
\c 116
\q1 \v 1 Laudáte Dóminum, omnes gentes: * laudáte eum, omnes pópuli:
\q1 \v 2 Quóniam confirmáta est super nos misericórdia ejus: * et véritas Dómini manet in ætérnum.
\c 117
\q1 \v 1 Confitémini Dómino quóniam bonus: * quóniam in sǽculum misericórdia ejus.
\q1 \v 2 Dicat nunc Israël quóniam bonus: * quóniam in sǽculum misericórdia ejus.
\q1 \v 3 Dicat nunc domus Aaron: * quóniam in sǽculum misericórdia ejus.
\q1 \v 4 Dicant nunc qui timent Dóminum: * quóniam in sǽculum misericórdia ejus.
\q1 \v 5 De tribulatióne invocávi Dóminum: * et exaudívit me in latitúdine Dóminus.
\q1 \v 6 Dóminus mihi adjútor: * non timébo quid fáciat mihi homo.
\q1 \v 7 Dóminus mihi adjútor: * et ego despíciam inimícos meos.
\q1 \v 8 Bonum est confídere in Dómino, * quam confídere in hómine:
\q1 \v 9 Bonum est speráre in Dómino, * quam speráre in princípibus.
\q1 \v 10 Omnes gentes circuiérunt me: * et in nómine Dómini quia ultus sum in eos.
\q1 \v 11 Circumdántes circumdedérunt me: * et in nómine Dómini quia ultus sum in eos.
\q1 \v 12 Circumdedérunt me sicut apes, † et exarsérunt sicut ignis in spinis: * et in nómine Dómini quia ultus sum in eos.
\q1 \v 13 Impúlsus evérsus sum ut cáderem: * et Dóminus suscépit me.
\q1 \v 14 Fortitúdo mea, et laus mea Dóminus: * et factus est mihi in salútem.
\q1 \v 15 Vox exsultatiónis, et salútis * in tabernáculis justórum.
\q1 \v 16 Déxtera Dómini fecit virtútem: † déxtera Dómini exaltávit me, * déxtera Dómini fecit virtútem.
\q1 \v 17 Non móriar, sed vivam: * et narrábo ópera Dómini.
\q1 \v 18 Castígans castigávit me Dóminus: * et morti non trádidit me.
\q1 \v 19 Aperíte mihi portas justítiæ, † ingréssus in eas confitébor Dómino: * (20) hæc porta Dómini, justi intrábunt in eam.
\q1 \v 21 Confitébor tibi quóniam exaudísti me: * et factus es mihi in salútem.
\q1 \v 22 Lápidem, quem reprobavérunt ædificántes: * hic factus est in caput ánguli.
\q1 \v 23 A Dómino factum est istud: * et est mirábile in óculis nostris.
\q1 \v 24 Hæc est dies, quam fecit Dóminus: * exsultémus, et lætémur in ea.
\q1 \v 25 O Dómine, salvum me fac, † o Dómine, bene prosperáre: * (26a) benedíctus qui venit in nómine Dómini.
\q1 \v 26 Benedíximus vobis de domo Dómini: * (27a) Deus Dóminus, et illúxit nobis.
\q1 \v 27 Constitúite diem solémnem in condénsis, * usque ad cornu altáris.
\q1 \v 28 Deus meus es tu, et confitébor tibi: * Deus meus es tu, et exaltábo te.
\q1 Confitébor tibi quóniam exaudísti me * et factus es mihi in salútem.
\q1 \v 29 Confitémini Dómino quóniam bonus: * quóniam in sǽculum misericórdia ejus.
\c 118
\q1 \v 1 (Aleph) Beáti immaculáti in via: * qui ámbulant in lege Dómini.
\q1 \v 2 Beáti, qui scrutántur testimónia ejus: * in toto corde exquírunt eum.
\q1 \v 3 Non enim qui operántur iniquitátem, * in viis ejus ambulavérunt.
\q1 \v 4 Tu mandásti * mandáta tua custodíri nimis.
\q1 \v 5 Útinam dirigántur viæ meæ, * ad custodiéndas justificatiónes tuas!
\q1 \v 6 Tunc non confúndar, * cum perspéxero in ómnibus mandátis tuis.
\q1 \v 7 Confitébor tibi in directióne cordis: * in eo quod dídici judícia justítiæ tuæ.
\q1 \v 8 Justificatiónes tuas custódiam: * non me derelínquas usquequáque.
\q1 \v 9 (Beth) In quo córrigit adolescéntior viam suam? * In custodiéndo sermónes tuos.
\q1 \v 10 In toto corde meo exquisívi te: * ne repéllas me a mandátis tuis.
\q1 \v 11 In corde meo abscóndi elóquia tua: * ut non peccem tibi.
\q1 \v 12 Benedíctus es, Dómine: * doce me justificatiónes tuas.
\q1 \v 13 In lábiis meis, * pronuntiávi ómnia judícia oris tui.
\q1 \v 14 In via testimoniórum tuórum delectátus sum, * sicut in ómnibus divítiis.
\q1 \v 15 In mandátis tuis exercébor: * et considerábo vias tuas.
\q1 \v 16 In justificatiónibus tuis meditábor: * non oblivíscar sermónes tuos.
\q1 \v 17 (Ghimel) Retríbue servo tuo, vivífica me: * et custódiam sermónes tuos:
\q1 \v 18 Revéla óculos meos: * et considerábo mirabília de lege tua.
\q1 \v 19 Íncola ego sum in terra: * non abscóndas a me mandáta tua.
\q1 \v 20 Concupívit ánima mea desideráre justificatiónes tuas, * in omni témpore.
\q1 \v 21 Increpásti supérbos: * maledícti qui declínant a mandátis tuis.
\q1 \v 22 Aufer a me oppróbrium, et contémptum: * quia testimónia tua exquisívi.
\q1 \v 23 Étenim sedérunt príncipes, et advérsum me loquebántur: * servus autem tuus exercebátur in justificatiónibus tuis.
\q1 \v 24 Nam et testimónia tua meditátio mea est: * et consílium meum justificatiónes tuæ.
\q1 \v 25 (Daleth) Adhǽsit paviménto ánima mea: * vivífica me secúndum verbum tuum.
\q1 \v 26 Vias meas enuntiávi, et exaudísti me: * doce me justificatiónes tuas.
\q1 \v 27 Viam justificatiónum tuárum ínstrue me: * et exercébor in mirabílibus tuis.
\q1 \v 28 Dormitávit ánima mea præ tǽdio: * confírma me in verbis tuis.
\q1 \v 29 Viam iniquitátis ámove a me: * et de lege tua miserére mei.
\q1 \v 30 Viam veritátis elégi: * judícia tua non sum oblítus.
\q1 \v 31 Adhǽsi testimóniis tuis, Dómine: * noli me confúndere.
\q1 \v 32 Viam mandatórum tuórum cucúrri, * cum dilatásti cor meum.
\q1 \v 33 (He) Legem pone mihi, Dómine, viam justificatiónum tuárum: * et exquíram eam semper.
\q1 \v 34 Da mihi intelléctum, et scrutábor legem tuam: * et custódiam illam in toto corde meo.
\q1 \v 35 Deduc me in sémitam mandatórum tuórum: * quia ipsam vólui.
\q1 \v 36 Inclína cor meum in testimónia tua: * et non in avarítiam.
\q1 \v 37 Avérte óculos meos ne vídeant vanitátem: * in via tua vivífica me.
\q1 \v 38 Státue servo tuo elóquium tuum, * in timóre tuo.
\q1 \v 39 Ámputa oppróbrium meum quod suspicátus sum: * quia judícia tua jucúnda.
\q1 \v 40 Ecce, concupívi mandáta tua: * in æquitáte tua vivífica me.
\q1 \v 41 (Vav) Et véniat super me misericórdia tua, Dómine: * salutáre tuum secúndum elóquium tuum.
\q1 \v 42 Et respondébo exprobrántibus mihi verbum: * quia sperávi in sermónibus tuis.
\q1 \v 43 Et ne áuferas de ore meo verbum veritátis usquequáque: * quia in judíciis tuis supersperávi.
\q1 \v 44 Et custódiam legem tuam semper: * in sǽculum et in sǽculum sǽculi.
\q1 \v 45 Et ambulábam in latitúdine: * quia mandáta tua exquisívi.
\q1 \v 46 Et loquébar in testimóniis tuis in conspéctu regum: * et non confundébar.
\q1 \v 47 Et meditábar in mandátis tuis, * quæ diléxi.
\q1 \v 48 Et levávi manus meas ad mandáta tua, quæ diléxi: * et exercébar in justificatiónibus tuis.
\q1 \v 49 (Zai) Memor esto verbi tui servo tuo, * in quo mihi spem dedísti.
\q1 \v 50 Hæc me consoláta est in humilitáte mea: * quia elóquium tuum vivificávit me.
\q1 \v 51 Supérbi iníque agébant usquequáque: * a lege autem tua non declinávi.
\q1 \v 52 Memor fui judiciórum tuórum a sǽculo, Dómine: * et consolátus sum.
\q1 \v 53 Deféctio ténuit me, * pro peccatóribus derelinquéntibus legem tuam.
\q1 \v 54 Cantábiles mihi erant justificatiónes tuæ, * in loco peregrinatiónis meæ.
\q1 \v 55 Memor fui nocte nóminis tui, Dómine: * et custodívi legem tuam.
\q1 \v 56 Hæc facta est mihi: * quia justificatiónes tuas exquisívi.
\q1 \v 57 (Heth) Pórtio mea, Dómine, * dixi custodíre legem tuam.
\q1 \v 58 Deprecátus sum fáciem tuam in toto corde meo: * miserére mei secúndum elóquium tuum.
\q1 \v 59 Cogitávi vias meas: * et convérti pedes meos in testimónia tua.
\q1 \v 60 Parátus sum, et non sum turbátus: * ut custódiam mandáta tua.
\q1 \v 61 Funes peccatórum circumpléxi sunt me: * et legem tuam non sum oblítus.
\q1 \v 62 Média nocte surgébam ad confiténdum tibi, * super judícia justificatiónis tuæ.
\q1 \v 63 Párticeps ego sum ómnium timéntium te: * et custodiéntium mandáta tua.
\q1 \v 64 Misericórdia tua, Dómine, plena est terra: * justificatiónes tuas doce me.
\q1 \v 65 (Teth) Bonitátem fecísti cum servo tuo, Dómine, * secúndum verbum tuum.
\q1 \v 66 Bonitátem, et disciplínam, et sciéntiam doce me: * quia mandátis tuis crédidi.
\q1 \v 67 Priúsquam humiliárer ego delíqui: * proptérea elóquium tuum custodívi.
\q1 \v 68 Bonus es tu: * et in bonitáte tua doce me justificatiónes tuas.
\q1 \v 69 Multiplicáta est super me iníquitas superbórum: * ego autem in toto corde meo scrutábor mandáta tua.
\q1 \v 70 Coagulátum est sicut lac cor eórum: * ego vero legem tuam meditátus sum.
\q1 \v 71 Bonum mihi quia humiliásti me: * ut discam justificatiónes tuas.
\q1 \v 72 Bonum mihi lex oris tui, * super míllia auri et argénti.
\q1 \v 73 (Joth) Manus tuæ fecérunt me, et plasmavérunt me: * da mihi intelléctum, et discam mandáta tua.
\q1 \v 74 Qui timent te vidébunt me, et lætabúntur: * quia in verba tua supersperávi.
\q1 \v 75 Cognóvi, Dómine, quia ǽquitas judícia tua: * et in veritáte tua humiliásti me.
\q1 \v 76 Fiat misericórdia tua ut consolétur me, * secúndum elóquium tuum servo tuo.
\q1 \v 77 Véniant mihi miseratiónes tuæ, et vivam: * quia lex tua meditátio mea est.
\q1 \v 78 Confundántur supérbi, quia injúste iniquitátem fecérunt in me: * ego autem exercébor in mandátis tuis.
\q1 \v 79 Convertántur mihi timéntes te: * et qui novérunt testimónia tua.
\q1 \v 80 Fiat cor meum immaculátum in justificatiónibus tuis, * ut non confúndar.
\q1 \v 81 (Caph) Defécit in salutáre tuum ánima mea: * et in verbum tuum supersperávi.
\q1 \v 82 Defecérunt óculi mei in elóquium tuum, * dicéntes: Quando consoláberis me?
\q1 \v 83 Quia factus sum sicut uter in pruína: * justificatiónes tuas non sum oblítus.
\q1 \v 84 Quot sunt dies servi tui? * quando fácies de persequéntibus me judícium?
\q1 \v 85 Narravérunt mihi iníqui fabulatiónes: * sed non ut lex tua.
\q1 \v 86 Ómnia mandáta tua véritas: * iníque persecúti sunt me, ádjuva me.
\q1 \v 87 Paulo minus consummavérunt me in terra: * ego autem non derelíqui mandáta tua.
\q1 \v 88 Secúndum misericórdiam tuam vivífica me: * et custódiam testimónia oris tui.
\q1 \v 89 (Lamed) In ætérnum, Dómine, * verbum tuum pérmanet in cælo.
\q1 \v 90 In generatiónem et generatiónem véritas tua: * fundásti terram, et pérmanet.
\q1 \v 91 Ordinatióne tua persevérat dies: * quóniam ómnia sérviunt tibi.
\q1 \v 92 Nisi quod lex tua meditátio mea est: * tunc forte periíssem in humilitáte mea.
\q1 \v 93 In ætérnum non oblivíscar justificatiónes tuas: * quia in ipsis vivificásti me.
\q1 \v 94 Tuus sum ego, salvum me fac: * quóniam justificatiónes tuas exquisívi.
\q1 \v 95 Me exspectavérunt peccatóres ut pérderent me: * testimónia tua intelléxi.
\q1 \v 96 Omnis consummatiónis vidi finem: * latum mandátum tuum nimis.
\q1 \v 97 (Mem) Quómodo diléxi legem tuam, Dómine? * tota die meditátio mea est.
\q1 \v 98 Super inimícos meos prudéntem me fecísti mandáto tuo: * quia in ætérnum mihi est.
\q1 \v 99 Super omnes docéntes me intelléxi: * quia testimónia tua meditátio mea est.
\q1 \v 100 Super senes intelléxi: * quia mandáta tua quæsívi.
\q1 \v 101 Ab omni via mala prohíbui pedes meos: * ut custódiam verba tua.
\q1 \v 102 A judíciis tuis non declinávi: * quia tu legem posuísti mihi.
\q1 \v 103 Quam dúlcia fáucibus meis elóquia tua, * super mel ori meo!
\q1 \v 104 A mandátis tuis intelléxi: * proptérea odívi omnem viam iniquitátis.
\q1 \v 105 (Nun) Lucérna pédibus meis verbum tuum, * et lumen sémitis meis.
\q1 \v 106 Jurávi, et státui * custodíre judícia justítiæ tuæ.
\q1 \v 107 Humiliátus sum usquequáque, Dómine: * vivífica me secúndum verbum tuum.
\q1 \v 108 Voluntária oris mei beneplácita fac, Dómine: * et judícia tua doce me.
\q1 \v 109 Ánima mea in mánibus meis semper: * et legem tuam non sum oblítus.
\q1 \v 110 Posuérunt peccatóres láqueum mihi: * et de mandátis tuis non errávi.
\q1 \v 111 Hereditáte acquisívi testimónia tua in ætérnum: * quia exsultátio cordis mei sunt.
\q1 \v 112 Inclinávi cor meum ad faciéndas justificatiónes tuas in ætérnum, * propter retributiónem.
\q1 \v 113 (Samech) Iníquos ódio hábui: * et legem tuam diléxi.
\q1 \v 114 Adjútor et suscéptor meus es tu: * et in verbum tuum supersperávi.
\q1 \v 115 Declináte a me, malígni: * et scrutábor mandáta Dei mei.
\q1 \v 116 Súscipe me secúndum elóquium tuum, et vivam: * et non confúndas me ab exspectatióne mea.
\q1 \v 117 Ádjuva me, et salvus ero: * et meditábor in justificatiónibus tuis semper.
\q1 \v 118 Sprevísti omnes discedéntes a judíciis tuis: * quia injústa cogitátio eórum.
\q1 \v 119 Prævaricántes reputávi omnes peccatóres terræ: * ídeo diléxi testimónia tua.
\q1 \v 120 Confíge timóre tuo carnes meas: * a judíciis enim tuis tímui.
\q1 \v 121 (Ain) Feci judícium et justítiam: * non tradas me calumniántibus me.
\q1 \v 122 Súscipe servum tuum in bonum: * non calumniéntur me supérbi.
\q1 \v 123 Óculi mei defecérunt in salutáre tuum: * et in elóquium justítiæ tuæ.
\q1 \v 124 Fac cum servo tuo secúndum misericórdiam tuam: * et justificatiónes tuas doce me.
\q1 \v 125 Servus tuus sum ego: * da mihi intelléctum, ut sciam testimónia tua.
\q1 \v 126 Tempus faciéndi, Dómine: * dissipavérunt legem tuam.
\q1 \v 127 Ídeo diléxi mandáta tua, * super aurum et topázion.
\q1 \v 128 Proptérea ad ómnia mandáta tua dirigébar: * omnem viam iníquam ódio hábui.
\q1 \v 129 (Phe) Mirabília testimónia tua: * ídeo scrutáta est ea ánima mea.
\q1 \v 130 Declarátio sermónum tuórum illúminat: * et intelléctum dat párvulis.
\q1 \v 131 Os meum apérui, et attráxi spíritum: * quia mandáta tua desiderábam.
\q1 \v 132 Áspice in me, et miserére mei, * secúndum judícium diligéntium nomen tuum.
\q1 \v 133 Gressus meos dírige secúndum elóquium tuum: * et non dominétur mei omnis injustítia.
\q1 \v 134 Rédime me a calúmniis hóminum: * ut custódiam mandáta tua.
\q1 \v 135 Fáciem tuam illúmina super servum tuum: * et doce me justificatiónes tuas.
\q1 \v 136 Éxitus aquárum deduxérunt óculi mei: * quia non custodiérunt legem tuam.
\q1 \v 137 (Sade) Justus es, Dómine: * et rectum judícium tuum.
\q1 \v 138 Mandásti justítiam testimónia tua: * et veritátem tuam nimis.
\q1 \v 139 Tabéscere me fecit zelus meus: * quia oblíti sunt verba tua inimíci mei.
\q1 \v 140 Ignítum elóquium tuum veheménter: * et servus tuus diléxit illud.
\q1 \v 141 Adolescéntulus sum ego et contémptus: * justificatiónes tuas non sum oblítus.
\q1 \v 142 Justítia tua, justítia in ætérnum: * et lex tua véritas.
\q1 \v 143 Tribulátio, et angústia invenérunt me: * mandáta tua meditátio mea est.
\q1 \v 144 Ǽquitas testimónia tua in ætérnum: * intelléctum da mihi, et vivam.
\q1 \v 145 (Coph) Clamávi in toto corde meo, exáudi me, Dómine: * justificatiónes tuas requíram.
\q1 \v 146 Clamávi ad te, salvum me fac: * ut custódiam mandáta tua.
\q1 \v 147 Prævéni in maturitáte, et clamávi: * quia in verba tua supersperávi.
\q1 \v 148 Prævenérunt óculi mei ad te dilúculo: * ut meditárer elóquia tua.
\q1 \v 149 Vocem meam audi secúndum misericórdiam tuam, Dómine: * et secúndum judícium tuum vivífica me.
\q1 \v 150 Appropinquavérunt persequéntes me iniquitáti: * a lege autem tua longe facti sunt.
\q1 \v 151 Prope es tu, Dómine: * et omnes viæ tuæ véritas.
\q1 \v 152 Inítio cognóvi de testimóniis tuis: * quia in ætérnum fundásti ea.
\q1 \v 153 (Res) Vide humilitátem meam, et éripe me: * quia legem tuam non sum oblítus.
\q1 \v 154 Júdica judícium meum, et rédime me: * propter elóquium tuum vivífica me.
\q1 \v 155 Longe a peccatóribus salus: * quia justificatiónes tuas non exquisiérunt.
\q1 \v 156 Misericórdiæ tuæ multæ, Dómine: * secúndum judícium tuum vivífica me.
\q1 \v 157 Multi qui persequúntur me, et tríbulant me: * a testimóniis tuis non declinávi.
\q1 \v 158 Vidi prævaricántes, et tabescébam: * quia elóquia tua non custodiérunt.
\q1 \v 159 Vide quóniam mandáta tua diléxi, Dómine: * in misericórdia tua vivífica me.
\q1 \v 160 Princípium verbórum tuórum, véritas: * in ætérnum ómnia judícia justítiæ tuæ.
\q1 \v 161 (Sin) Príncipes persecúti sunt me gratis: * et a verbis tuis formidávit cor meum.
\q1 \v 162 Lætábor ego super elóquia tua: * sicut qui invénit spólia multa.
\q1 \v 163 Iniquitátem ódio hábui, et abominátus sum: * legem autem tuam diléxi.
\q1 \v 164 Sépties in die laudem dixi tibi, * super judícia justítiæ tuæ.
\q1 \v 165 Pax multa diligéntibus legem tuam: * et non est illis scándalum.
\q1 \v 166 Exspectábam salutáre tuum, Dómine: * et mandáta tua diléxi.
\q1 \v 167 Custodívit ánima mea testimónia tua: * et diléxit ea veheménter.
\q1 \v 168 Servávi mandáta tua, et testimónia tua: * quia omnes viæ meæ in conspéctu tuo.
\q1 \v 169 (Thau) Appropínquet deprecátio mea in conspéctu tuo, Dómine: * juxta elóquium tuum da mihi intelléctum.
\q1 \v 170 Intret postulátio mea in conspéctu tuo: * secúndum elóquium tuum éripe me.
\q1 \v 171 Eructábunt lábia mea hymnum, * cum docúeris me justificatiónes tuas.
\q1 \v 172 Pronuntiábit lingua mea elóquium tuum: * quia ómnia mandáta tua ǽquitas.
\q1 \v 173 Fiat manus tua ut salvet me: * quóniam mandáta tua elégi.
\q1 \v 174 Concupívi salutáre tuum, Dómine: * et lex tua meditátio mea est.
\q1 \v 175 Vivet ánima mea, et laudábit te: * et judícia tua adjuvábunt me.
\q1 \v 176 Errávi, sicut ovis, quæ périit: * quære servum tuum, quia mandáta tua non sum oblítus.
\c 119
\q1 \v 1 Ad Dóminum cum tribulárer clamávi: * et exaudívit me.
\q1 \v 2 Dómine, líbera ánimam meam a lábiis iníquis, * et a lingua dolósa.
\q1 \v 3 Quid detur tibi, aut quid apponátur tibi * ad linguam dolósam?
\q1 \v 4 Sagíttæ poténtis acútæ, * cum carbónibus desolatóriis.
\q1 \v 5 Heu mihi, quia incolátus meus prolongátus est: † habitávi cum habitántibus Cedar: * (6) multum íncola fuit ánima mea.
\q1 \v 7 Cum his, qui odérunt pacem, eram pacíficus: * cum loquébar illis, impugnábant me gratis.
\c 120
\q1 \v 1 Levávi óculos meos in montes, * unde véniet auxílium mihi.
\q1 \v 2 Auxílium meum a Dómino, * qui fecit cælum et terram.
\q1 \v 3 Non det in commotiónem pedem tuum: * neque dormítet qui custódit te.
\q1 \v 4 Ecce, non dormitábit neque dórmiet, * qui custódit Israël.
\q1 \v 5 Dóminus custódit te, Dóminus protéctio tua, * super manum déxteram tuam.
\q1 \v 6 Per diem sol non uret te: * neque luna per noctem.
\q1 \v 7 Dóminus custódit te ab omni malo: * custódiat ánimam tuam Dóminus.
\q1 \v 8 Dóminus custódiat intróitum tuum, et éxitum tuum: * ex hoc nunc, et usque in sǽculum.
\c 121
\q1 \v 1 Lætátus sum in his, quæ dicta sunt mihi: * In domum Dómini íbimus.
\q1 \v 2 Stantes erant pedes nostri, * in átriis tuis, Jerúsalem.
\q1 \v 3 Jerúsalem, quæ ædificátur ut cívitas: * cujus participátio ejus in idípsum.
\q1 \v 4 Illuc enim ascendérunt tribus, tribus Dómini: * testimónium Israël ad confiténdum nómini Dómini.
\q1 \v 5 Quia illic sedérunt sedes in judício, * sedes super domum David.
\q1 \v 6 Rogáte quæ ad pacem sunt Jerúsalem: * et abundántia diligéntibus te:
\q1 \v 7 Fiat pax in virtúte tua: * et abundántia in túrribus tuis.
\q1 \v 8 Propter fratres meos, et próximos meos, * loquébar pacem de te:
\q1 \v 9 Propter domum Dómini, Dei nostri, * quæsívi bona tibi.
\c 122
\q1 \v 1 Ad te levávi óculos meos, * qui hábitas in cælis.
\q1 \v 2 Ecce, sicut óculi servórum * in mánibus dominórum suórum,
\q1 Sicut óculi ancíllæ in mánibus dóminæ suæ: * ita óculi nostri ad Dóminum, Deum nostrum, donec misereátur nostri.
\q1 \v 3 Miserére nostri, Dómine, miserére nostri: * quia multum repléti sumus despectióne:
\q1 \v 4 Quia multum repléta est ánima nostra: * oppróbrium abundántibus, et despéctio supérbis.
\c 123
\q1 \v 1 Nisi quia Dóminus erat in nobis, dicat nunc Israël: * (2a) nisi quia Dóminus erat in nobis,
\q1 \v 2 Cum exsúrgerent hómines in nos, * (3a) forte vivos deglutíssent nos:
\q1 \v 3 Cum irascerétur furor eórum in nos, * (4) fórsitan aqua absorbuísset nos.
\q1 \v 5 Torréntem pertransívit ánima nostra: * fórsitan pertransísset ánima nostra aquam intolerábilem.
\q1 \v 6 Benedíctus Dóminus * qui non dedit nos in captiónem déntibus eórum.
\q1 \v 7 Ánima nostra sicut passer erépta est * de láqueo venántium:
\q1 Láqueus contrítus est, * et nos liberáti sumus.
\q1 \v 8 Adjutórium nostrum in nómine Dómini, * qui fecit cælum et terram.
\c 124
\q1 \v 1 Qui confídunt in Dómino, sicut mons Sion: * non commovébitur in ætérnum, qui hábitat (2a) in Jerúsalem.
\q1 \v 2 Montes in circúitu ejus: ‡ et Dóminus in circúitu pópuli sui, * ex hoc nunc et usque in sǽculum.
\q1 \v 3 Quia non relínquet Dóminus virgam peccatórum super sortem justórum: * ut non exténdant justi ad iniquitátem manus suas.
\q1 \v 4 Bénefac, Dómine, bonis, * et rectis corde.
\q1 \v 5 Declinántes autem in obligatiónes addúcet Dóminus cum operántibus iniquitátem: * pax super Israël.
\c 125
\q1 \v 1 In converténdo Dóminus captivitátem Sion: * facti sumus sicut consoláti:
\q1 \v 2 Tunc replétum est gáudio os nostrum: * et lingua nostra exsultatióne.
\q1 Tunc dicent inter gentes: * Magnificávit Dóminus fácere cum eis.
\q1 \v 3 Magnificávit Dóminus fácere nobíscum: * facti sumus lætántes.
\q1 \v 4 Convérte, Dómine, captivitátem nostram, * sicut torrens in Austro.
\q1 \v 5 Qui séminant in lácrimis, * in exsultatióne metent.
\q1 \v 6 Eúntes ibant et flebant, * mitténtes sémina sua.
\q1 Veniéntes autem vénient cum exsultatióne, * portántes manípulos suos.
\c 126
\q1 \v 1 Nisi Dóminus ædificáverit domum, * in vanum laboravérunt qui ædíficant eam.
\q1 Nisi Dóminus custodíerit civitátem, * frustra vígilat qui custódit eam.
\q1 \v 2 Vanum est vobis ante lucem súrgere: * súrgite postquam sedéritis, qui manducátis panem dolóris.
\q1 Cum déderit diléctis suis somnum: * (3) ecce heréditas Dómini fílii: merces, fructus ventris.
\q1 \v 4 Sicut sagíttæ in manu poténtis: * ita fílii excussórum.
\q1 \v 5 Beátus vir, qui implévit desidérium suum ex ipsis: * non confundétur cum loquétur inimícis suis in porta.
\c 127
\q1 \v 1 Beáti, omnes, qui timent Dóminum, * qui ámbulant in viis ejus.
\q1 \v 2 Labóres mánuum tuárum quia manducábis: * beátus es, et bene tibi erit.
\q1 \v 3 Uxor tua sicut vitis abúndans, * in latéribus domus tuæ.
\q1 Fílii tui sicut novéllæ olivárum, * in circúitu mensæ tuæ.
\q1 \v 4 Ecce, sic benedicétur homo, * qui timet Dóminum.
\q1 \v 5 Benedícat tibi Dóminus ex Sion: * et vídeas bona Jerúsalem ómnibus diébus vitæ tuæ.
\q1 \v 6 Et vídeas fílios filiórum tuórum, * pacem super Israël.
\c 128
\q1 \v 1 Sæpe expugnavérunt me a juventúte mea, * dicat nunc Israël.
\q1 \v 2 Sæpe expugnavérunt me a juventúte mea: * étenim non potuérunt mihi.
\q1 \v 3 Supra dorsum meum fabricavérunt peccatóres: * prolongavérunt iniquitátem suam.
\q1 \v 4 Dóminus justus concídit cervíces peccatórum: * (5) confundántur et convertántur retrórsum omnes, qui odérunt Sion.
\q1 \v 6 Fiant sicut fænum tectórum: * quod priúsquam evellátur, exáruit:
\q1 \v 7 De quo non implévit manum suam qui metit, * et sinum suum qui manípulos cólligit.
\q1 \v 8 Et non dixérunt qui præteríbant: Benedíctio Dómini super vos: * benedíximus vobis in nómine Dómini.
\c 129
\q1 \v 1 De profúndis clamávi ad te, Dómine: * (2a) Dómine, exáudi vocem meam:
\q1 \v 2 Fiant aures tuæ intendéntes, * in vocem deprecatiónis meæ.
\q1 \v 3 Si iniquitátes observáveris, Dómine: * Dómine, quis sustinébit?
\q1 \v 4 Quia apud te propitiátio est: * et propter legem tuam sustínui te, Dómine.
\q1 Sustínuit ánima mea in verbo ejus: * (5) sperávit ánima mea in Dómino.
\q1 \v 6 A custódia matutína usque ad noctem: * speret Israël in Dómino.
\q1 \v 7 Quia apud Dóminum misericórdia: * et copiósa apud eum redémptio.
\q1 \v 8 Et ipse rédimet Israël, * ex ómnibus iniquitátibus ejus.
\c 130
\q1 \v 1 Dómine, non est exaltátum cor meum: * neque eláti sunt óculi mei.
\q1 Neque ambulávi in magnis: * neque in mirabílibus super me.
\q1 \v 2 Si non humíliter sentiébam: * sed exaltávi ánimam meam:
\q1 Sicut ablactátus est super matre sua, * ita retribútio in ánima mea.
\q1 \v 3 Speret Israël in Dómino, * ex hoc nunc et usque in sǽculum.
\c 131
\q1 \v 1 Meménto, Dómine, David, * et omnis mansuetúdinis ejus:
\q1 \v 2 Sicut jurávit Dómino, * votum vovit Deo Jacob:
\q1 \v 3 Si introíero in tabernáculum domus meæ, * si ascéndero in lectum strati mei:
\q1 \v 4 Si dédero somnum óculis meis, * et pálpebris meis dormitatiónem:
\q1 \v 5 Et réquiem tempóribus meis: donec invéniam locum Dómino, * tabernáculum Deo Jacob.
\q1 \v 6 Ecce, audívimus eam in Éphrata: * invénimus eam in campis silvæ.
\q1 \v 7 Introíbimus in tabernáculum ejus: * adorábimus in loco, ubi stetérunt pedes ejus.
\q1 \v 8 Surge, Dómine, in réquiem tuam, * tu et arca sanctificatiónis tuæ.
\q1 \v 9 Sacerdótes tui induántur justítiam: * et sancti tui exsúltent.
\q1 \v 10 Propter David, servum tuum, * non avértas fáciem Christi tui.
\q1 \v 11 Jurávit Dóminus David veritátem, et non frustrábitur eam: * De fructu ventris tui ponam super sedem tuam.
\q1 \v 12 Si custodíerint fílii tui testaméntum meum, * et testimónia mea hæc, quæ docébo eos:
\q1 Et fílii eórum usque in sǽculum, * sedébunt super sedem tuam.
\q1 \v 13 Quóniam elégit Dóminus Sion: * elégit eam in habitatiónem sibi.
\q1 \v 14 Hæc réquies mea in sǽculum sǽculi: * hic habitábo quóniam elégi eam.
\q1 \v 15 Víduam ejus benedícens benedícam: * páuperes ejus saturábo pánibus.
\q1 \v 16 Sacerdótes ejus índuam salutári: * et sancti ejus exsultatióne exsultábunt.
\q1 \v 17 Illuc prodúcam cornu David, * parávi lucérnam Christo meo.
\q1 \v 18 Inimícos ejus índuam confusióne: * super ipsum autem efflorébit sanctificátio mea.
\c 132
\q1 \v 1 Ecce quam bonum et quam jucúndum, * habitáre fratres in unum:
\q1 \v 2 Sicut unguéntum in cápite, * quod descéndit in barbam, barbam Aaron,
\q1 Quod descéndit in oram vestiménti ejus: * (3a) sicut ros Hermon, qui descéndit in montem Sion.
\q1 \v 3 Quóniam illic mandávit Dóminus benedictiónem, * et vitam usque in sǽculum.
\c 133
\q1 \v 1 Ecce nunc benedícite Dóminum, * omnes servi Dómini:
\q1 Qui statis in domo Dómini, * in átriis domus Dei nostri.
\q1 \v 2 In nóctibus extóllite manus vestras in sancta, * et benedícite Dóminum.
\q1 \v 3 Benedícat te Dóminus ex Sion, * qui fecit cælum et terram.
\c 134
\q1 \v 1 Laudáte nomen Dómini, * laudáte, servi, Dóminum.
\q1 \v 2 Qui statis in domo Dómini, * in átriis domus Dei nostri.
\q1 \v 3 Laudáte Dóminum, quia bonus Dóminus: * psállite nómini ejus, quóniam suáve.
\q1 \v 4 Quóniam Jacob elégit sibi Dóminus, * Israël in possessiónem sibi.
\q1 \v 5 Quia ego cognóvi quod magnus est Dóminus, * et Deus noster præ ómnibus diis.
\q1 \v 6 Ómnia quæcúmque vóluit, Dóminus fecit in cælo, et in terra, * in mari, et in ómnibus abýssis.
\q1 \v 7 Edúcens nubes ab extrémo terræ: * fúlgura in plúviam fecit.
\q1 Qui prodúcit ventos de thesáuris suis: * (8) qui percússit primogénita Ægýpti ab hómine usque ad pecus.
\q1 \v 9 Et misit signa, et prodígia in médio tui, Ægýpte: * in Pharaónem, et in omnes servos ejus.
\q1 \v 10 Qui percússit gentes multas: * et occídit reges fortes:
\q1 \v 11 Sehon, regem Amorrhæórum, et Og, regem Basan, * et ómnia regna Chánaan.
\q1 \v 12 Et dedit terram eórum hereditátem, * hereditátem Israël, pópulo suo.
\q1 \v 13 Dómine, nomen tuum in ætérnum: * Dómine, memoriále tuum in generatiónem et generatiónem.
\q1 \v 14 Quia judicábit Dóminus pópulum suum: * et in servis suis deprecábitur.
\q1 \v 15 Simulácra géntium argéntum, et aurum, * ópera mánuum hóminum.
\q1 \v 16 Os habent, et non loquéntur: * óculos habent, et non vidébunt.
\q1 \v 17 Aures habent, et non áudient: * neque enim est spíritus in ore ipsórum.
\q1 \v 18 Símiles illis fiant qui fáciunt ea: * et omnes qui confídunt in eis.
\q1 \v 19 Domus Israël, benedícite Dómino: * domus Aaron, benedícite Dómino.
\q1 \v 20 Domus Levi, benedícite Dómino: * qui timétis Dóminum, benedícite Dómino.
\q1 \v 21 Benedíctus Dóminus ex Sion, * qui hábitat in Jerúsalem.
\c 135
\q1 \v 1 Confitémini Dómino quóniam bonus: * quóniam in ætérnum misericórdia ejus.
\q1 \v 2 Confitémini Deo deórum: * quóniam in ætérnum misericórdia ejus.
\q1 \v 3 Confitémini Dómino dominórum: * quóniam in ætérnum misericórdia ejus.
\q1 \v 4 Qui facit mirabília magna solus: * quóniam in ætérnum misericórdia ejus.
\q1 \v 5 Qui fecit cælos in intelléctu: * quóniam in ætérnum misericórdia ejus.
\q1 \v 6 Qui firmávit terram super aquas: * quóniam in ætérnum misericórdia ejus.
\q1 \v 7 Qui fecit luminária magna: * quóniam in ætérnum misericórdia ejus.
\q1 \v 8 Solem in potestátem diéi: * quóniam in ætérnum misericórdia ejus.
\q1 \v 9 Lunam, et stellas in potestátem noctis: * quóniam in ætérnum misericórdia ejus.
\q1 \v 10 Qui percússit Ægýptum cum primogénitis eórum: * quóniam in ætérnum misericórdia ejus.
\q1 \v 11 Qui edúxit Israël de médio eórum: * quóniam in ætérnum misericórdia ejus.
\q1 \v 12 In manu poténti, et brácchio excélso: * quóniam in ætérnum misericórdia ejus.
\q1 \v 13 Qui divísit Mare Rubrum in divisiónes: * quóniam in ætérnum misericórdia ejus.
\q1 \v 14 Et edúxit Israël per médium ejus: * quóniam in ætérnum misericórdia ejus.
\q1 \v 15 Et excússit Pharaónem, et virtútem ejus in Mari Rubro: * quóniam in ætérnum misericórdia ejus.
\q1 \v 16 Qui tradúxit pópulum suum per desértum: * quóniam in ætérnum misericórdia ejus.
\q1 \v 17 Qui percússit reges magnos: * quóniam in ætérnum misericórdia ejus.
\q1 \v 18 Et occídit reges fortes: * quóniam in ætérnum misericórdia ejus.
\q1 \v 19 Sehon, regem Amorrhæórum: * quóniam in ætérnum misericórdia ejus.
\q1 \v 20 Et Og, regem Basan: * quóniam in ætérnum misericórdia ejus.
\q1 \v 21 Et dedit terram eórum hereditátem: * quóniam in ætérnum misericórdia ejus.
\q1 \v 22 Hereditátem Israël, servo suo: * quóniam in ætérnum misericórdia ejus.
\q1 \v 23 Quia in humilitáte nostra memor fuit nostri: * quóniam in ætérnum misericórdia ejus.
\q1 \v 24 Et redémit nos ab inimícis nostris: * quóniam in ætérnum misericórdia ejus.
\q1 \v 25 Qui dat escam omni carni: * quóniam in ætérnum misericórdia ejus.
\q1 \v 26 Confitémini Deo cæli: * quóniam in ætérnum misericórdia ejus.
\q1 Confitémini Dómino dominórum: * quóniam in ætérnum misericórdia ejus.
\c 136
\q1 \v 1 Super flúmina Babylónis, illic sédimus et flévimus: * cum recordarémur Sion:
\q1 \v 2 In salícibus in médio ejus, * suspéndimus órgana nostra.
\q1 \v 3 Quia illic interrogavérunt nos, qui captívos duxérunt nos, * verba cantiónum:
\q1 Et qui abduxérunt nos: * Hymnum cantáte nobis de cánticis Sion.
\q1 \v 4 Quómodo cantábimus cánticum Dómini * in terra aliéna?
\q1 \v 5 Si oblítus fúero tui, Jerúsalem, * oblivióni detur déxtera mea.
\q1 \v 6 Adhǽreat lingua mea fáucibus meis, * si non memínero tui:
\q1 Si non proposúero Jerúsalem, * in princípio lætítiæ meæ.
\q1 \v 7 Memor esto, Dómine, filiórum Edom, * in die Jerúsalem:
\q1 Qui dicunt: Exinaníte, exinaníte * usque ad fundaméntum in ea.
\q1 \v 8 Fília Babylónis mísera: * beátus, qui retríbuet tibi retributiónem tuam, quam retribuísti nobis.
\q1 \v 9 Beátus, qui tenébit, * et allídet párvulos tuos ad petram.
\c 137
\q1 \v 1 Confitébor tibi, Dómine, in toto corde meo: * quóniam audísti verba oris mei.
\q1 In conspéctu Angelórum psallam tibi: * (2a) adorábo ad templum sanctum tuum, et confitébor nómini tuo.
\q1 \v 2 Super misericórdia tua, et veritáte tua: * quóniam magnificásti super omne, nomen sanctum tuum.
\q1 \v 3 In quacúmque die invocávero te, exáudi me: * multiplicábis in ánima mea virtútem.
\q1 \v 4 Confiteántur tibi, Dómine, omnes reges terræ: * quia audiérunt ómnia verba oris tui:
\q1 \v 5 Et cantent in viis Dómini: * quóniam magna est glória Dómini.
\q1 \v 6 Quóniam excélsus Dóminus, et humília réspicit: * et alta a longe cognóscit.
\q1 \v 7 Si ambulávero in médio tribulatiónis, vivificábis me: ‡ et super iram inimicórum meórum extendísti manum tuam, * et salvum me fecit déxtera tua.
\q1 \v 8 Dóminus retríbuet pro me: ‡ Dómine, misericórdia tua in sǽculum: * ópera mánuum tuárum ne despícias.
\c 138
\q1 \v 1 Dómine, probásti me, et cognovísti me: * (2) tu cognovísti sessiónem meam, et resurrectiónem meam.
\q1 \v 3 Intellexísti cogitatiónes meas de longe: * sémitam meam, et funículum meum investigásti.
\q1 \v 4 Et omnes vias meas prævidísti: * quia non est sermo in lingua mea.
\q1 \v 5 Ecce, Dómine, tu cognovísti ómnia novíssima, et antíqua: * tu formásti me, et posuísti super me manum tuam.
\q1 \v 6 Mirábilis facta est sciéntia tua ex me: * confortáta est, et non pótero ad eam.
\q1 \v 7 Quo ibo a spíritu tuo? * et quo a fácie tua fúgiam?
\q1 \v 8 Si ascéndero in cælum, tu illic es: * si descéndero in inférnum, ades.
\q1 \v 9 Si súmpsero pennas meas dilúculo, * et habitávero in extrémis maris:
\q1 \v 10 Étenim illuc manus tua dedúcet me: * et tenébit me déxtera tua.
\q1 \v 11 Et dixi: Fórsitan ténebræ conculcábunt me: * et nox illuminátio mea in delíciis meis.
\q1 \v 12 Quia ténebræ non obscurabúntur a te, † et nox sicut dies illuminábitur: * sicut ténebræ ejus, ita et lumen ejus.
\q1 \v 13 Quia tu possedísti renes meos: * suscepísti me de útero matris meæ.
\q1 \v 14 Confitébor tibi quia terribíliter magnificátus es: ‡ mirabília ópera tua, * et ánima mea cognóscit nimis.
\q1 \v 15 Non est occultátum os meum a te, quod fecísti in occúlto: * et substántia mea in inferióribus terræ.
\q1 \v 16 Imperféctum meum vidérunt óculi tui, † et in libro tuo omnes scribéntur: * dies formabúntur, et nemo in eis.
\q1 \v 17 Mihi autem nimis honorificáti sunt amíci tui, Deus: * nimis confortátus est principátus eórum.
\q1 \v 18 Dinumerábo eos, et super arénam multiplicabúntur: * exsurréxi, et adhuc sum tecum.
\q1 \v 19 Si occíderis, Deus, peccatóres: * viri sánguinum, declináte a me:
\q1 \v 20 Quia dícitis in cogitatióne: * Accípient in vanitáte civitátes tuas.
\q1 \v 21 Nonne qui odérunt te, Dómine, óderam? * et super inimícos tuos tabescébam?
\q1 \v 22 Perfécto ódio óderam illos: * et inimíci facti sunt mihi.
\q1 \v 23 Proba me, Deus, et scito cor meum: * intérroga me, et cognósce sémitas meas.
\q1 \v 24 Et vide, si via iniquitátis in me est: * et deduc me in via ætérna.
\c 139
\q1 \v 2 Éripe me, Dómine, ab hómine malo: * a viro iníquo éripe me.
\q1 \v 3 Qui cogitavérunt iniquitátes in corde: * tota die constituébant prǽlia.
\q1 \v 4 Acuérunt linguas suas sicut serpéntis: * venénum áspidum sub lábiis eórum.
\q1 \v 5 Custódi me, Dómine, de manu peccatóris: * et ab homínibus iníquis éripe me.
\q1 Qui cogitavérunt supplantáre gressus meos: * abscondérunt supérbi láqueum mihi:
\q1 \v 6 Et funes extendérunt in láqueum: * juxta iter scándalum posuérunt mihi.
\q1 \v 7 Dixi Dómino: Deus meus es tu: * exáudi, Dómine, vocem deprecatiónis meæ.
\q1 \v 8 Dómine, Dómine, virtus salútis meæ: * obumbrásti super caput meum in die belli.
\q1 \v 9 Ne tradas me, Dómine, a desidério meo peccatóri: * cogitavérunt contra me, ne derelínquas me, ne forte exalténtur.
\q1 \v 10 Caput circúitus eórum: * labor labiórum ipsórum opériet eos.
\q1 \v 11 Cadent super eos carbónes, in ignem deícies eos: * in misériis non subsístent.
\q1 \v 12 Vir linguósus non dirigétur in terra: * virum injústum mala cápient in intéritu.
\q1 \v 13 Cognóvi quia fáciet Dóminus judícium ínopis: * et vindíctam páuperum.
\q1 \v 14 Verúmtamen justi confitebúntur nómini tuo: * et habitábunt recti cum vultu tuo.
\c 140
\q1 \v 1 Dómine, clamávi ad te, exáudi me: * inténde voci meæ, cum clamávero ad te.
\q1 \v 2 Dirigátur orátio mea sicut incénsum in conspéctu tuo: * elevátio mánuum meárum sacrifícium vespertínum.
\q1 \v 3 Pone, Dómine, custódiam ori meo: * et óstium circumstántiæ lábiis meis.
\q1 \v 4 Non declínes cor meum in verba malítiæ, * ad excusándas excusatiónes in peccátis.
\q1 Cum homínibus operántibus iniquitátem: * et non communicábo cum eléctis eórum.
\q1 \v 5 Corrípiet me justus in misericórdia, et increpábit me: * óleum autem peccatóris non impínguet caput meum.
\q1 \v 6 Quóniam adhuc et orátio mea in beneplácitis eórum: * absórpti sunt juncti petræ júdices eórum.
\q1 \v 7 Áudient verba mea quóniam potuérunt: * sicut crassitúdo terræ erúpta est super terram.
\q1 \v 8 Dissipáta sunt ossa nostra secus inférnum: * quia ad te, Dómine, Dómine, óculi mei: in te sperávi, non áuferas ánimam meam.
\q1 \v 9 Custódi me a láqueo, quem statuérunt mihi: * et a scándalis operántium iniquitátem.
\q1 \v 10 Cadent in retiáculo ejus peccatóres: * singuláriter sum ego donec tránseam.
\c 141
\q1 \v 2 Voce mea ad Dóminum clamávi: * voce mea ad Dóminum deprecátus sum:
\q1 \v 3 Effúndo in conspéctu ejus oratiónem meam, * et tribulatiónem meam ante ipsum pronúntio.
\q1 \v 4 In deficiéndo ex me spíritum meum, * et tu cognovísti sémitas meas.
\q1 In via hac, qua ambulábam, * abscondérunt láqueum mihi.
\q1 \v 5 Considerábam ad déxteram, et vidébam: * et non erat qui cognósceret me.
\q1 Périit fuga a me, * et non est qui requírat ánimam meam.
\q1 \v 6 Clamávi ad te, Dómine, * dixi: Tu es spes mea, pórtio mea in terra vivéntium.
\q1 \v 7 Inténde ad deprecatiónem meam: * quia humiliátus sum nimis.
\q1 Líbera me a persequéntibus me: * quia confortáti sunt super me.
\q1 \v 8 Educ de custódia ánimam meam ad confiténdum nómini tuo: * me exspéctant justi, donec retríbuas mihi.
\c 142
\q1 \v 1 Dómine, exáudi oratiónem meam: áuribus pércipe obsecratiónem meam in veritáte tua: * exáudi me in tua justítia.
\q1 \v 2 Et non intres in judícium cum servo tuo: * quia non justificábitur in conspéctu tuo omnis vivens.
\q1 \v 3 Quia persecútus est inimícus ánimam meam: * humiliávit in terra vitam meam.
\q1 Collocávit me in obscúris sicut mórtuos sǽculi: * (4) et anxiátus est super me spíritus meus, in me turbátum est cor meum.
\q1 \v 5 Memor fui diérum antiquórum, meditátus sum in ómnibus opéribus tuis: * in factis mánuum tuárum meditábar.
\q1 \v 6 Expándi manus meas ad te: * ánima mea sicut terra sine aqua tibi.
\q1 \v 7 Velóciter exáudi me, Dómine: * defécit spíritus meus.
\q1 Non avértas fáciem tuam a me: * et símilis ero descendéntibus in lacum.
\q1 \v 8 Audítam fac mihi mane misericórdiam tuam: * quia in te sperávi.
\q1 Notam fac mihi viam, in qua ámbulem: * quia ad te levávi ánimam meam.
\q1 \v 9 Éripe me de inimícis meis, Dómine, ad te confúgi: * (10a) doce me fácere voluntátem tuam, quia Deus meus es tu.
\q1 \v 10 Spíritus tuus bonus dedúcet me in terram rectam: * (11a) propter nomen tuum, Dómine, vivificábis me, in æquitáte tua.
\q1 \v 11 Edúces de tribulatióne ánimam meam: * (12a) et in misericórdia tua dispérdes inimícos meos.
\q1 \v 12 Et perdes omnes, qui tríbulant ánimam meam: * quóniam ego servus tuus sum.
\c 143
\q1 \v 1 Benedíctus Dóminus, Deus meus, qui docet manus meas ad prǽlium, * et dígitos meos ad bellum.
\q1 \v 2 Misericórdia mea, et refúgium meum: * suscéptor meus, et liberátor meus:
\q1 Protéctor meus, et in ipso sperávi: * qui subdit pópulum meum sub me.
\q1 \v 3 Dómine, quid est homo, quia innotuísti ei? * aut fílius hóminis, quia réputas eum?
\q1 \v 4 Homo vanitáti símilis factus est: * dies ejus sicut umbra prætéreunt.
\q1 \v 5 Dómine, inclína cælos tuos, et descénde: * tange montes, et fumigábunt.
\q1 \v 6 Fúlgura coruscatiónem, et dissipábis eos: * emítte sagíttas tuas, et conturbábis eos.
\q1 \v 7 Emítte manum tuam de alto, éripe me, et líbera me de aquis multis: * de manu filiórum alienórum.
\q1 \v 8 Quorum os locútum est vanitátem: * et déxtera eórum, déxtera iniquitátis.
\q1 \v 9 Deus, cánticum novum cantábo tibi: * in psaltério decachórdo psallam tibi.
\q1 \v 10 Qui das salútem régibus: * qui redemísti David, servum tuum, de gládio malígno: éripe me.
\q1 \v 11 Et érue me de manu filiórum alienórum, quorum os locútum est vanitátem: * et déxtera eórum, déxtera iniquitátis:
\q1 \v 12 Quorum fílii, sicut novéllæ plantatiónes * in juventúte sua.
\q1 Fíliæ eórum compósitæ: * circumornátæ ut similitúdo templi.
\q1 \v 13 Promptuária eórum plena, * eructántia ex hoc in illud.
\q1 Oves eórum fœtósæ, abundántes in egréssibus suis: * boves eórum crassæ.
\q1 \v 14 Non est ruína macériæ, neque tránsitus: * neque clamor in platéis eórum.
\q1 \v 15 Beátum dixérunt pópulum, cui hæc sunt: * beátus pópulus, cujus Dóminus Deus ejus.
\c 144
\q1 \v 1 Exaltábo te, Deus meus, rex: * et benedícam nómini tuo in sǽculum, et in sǽculum sǽculi.
\q1 \v 2 Per síngulos dies benedícam tibi: * et laudábo nomen tuum in sǽculum, et in sǽculum sǽculi.
\q1 \v 3 Magnus Dóminus, et laudábilis nimis: * et magnitúdinis ejus non est finis.
\q1 \v 4 Generátio et generátio laudábit ópera tua: * et poténtiam tuam pronuntiábunt.
\q1 \v 5 Magnificéntiam glóriæ sanctitátis tuæ loquéntur: * et mirabília tua narrábunt.
\q1 \v 6 Et virtútem terribílium tuórum dicent: * et magnitúdinem tuam narrábunt.
\q1 \v 7 Memóriam abundántiæ suavitátis tuæ eructábunt: * et justítia tua exsultábunt.
\q1 \v 8 Miserátor, et miséricors Dóminus: * pátiens, et multum miséricors.
\q1 \v 9 Suávis Dóminus univérsis: * et miseratiónes ejus super ómnia ópera ejus.
\q1 \v 10 Confiteántur tibi, Dómine, ómnia ópera tua: * et sancti tui benedícant tibi.
\q1 \v 11 Glóriam regni tui dicent: * et poténtiam tuam loquéntur:
\q1 \v 12 Ut notam fáciant fíliis hóminum poténtiam tuam: * et glóriam magnificéntiæ regni tui.
\q1 \v 13 Regnum tuum regnum ómnium sæculórum: * et dominátio tua in omni generatióne et generatiónem.
\q1 Fidélis Dóminus in ómnibus verbis suis: * et sanctus in ómnibus opéribus suis.
\q1 \v 14 Állevat Dóminus omnes qui córruunt: * et érigit omnes elísos.
\q1 \v 15 Óculi ómnium in te sperant, Dómine: * et tu das escam illórum in témpore opportúno.
\q1 \v 16 Áperis tu manum tuam: * et imples omne ánimal benedictióne.
\q1 \v 17 Justus Dóminus in ómnibus viis suis: * et sanctus in ómnibus opéribus suis.
\q1 \v 18 Prope est Dóminus ómnibus invocántibus eum: * ómnibus invocántibus eum in veritáte.
\q1 \v 19 Voluntátem timéntium se fáciet: ‡ et deprecatiónem eórum exáudiet: * et salvos fáciet eos.
\q1 \v 20 Custódit Dóminus omnes diligéntes se: * et omnes peccatóres dispérdet.
\q1 \v 21 Laudatiónem Dómini loquétur os meum: * et benedícat omnis caro nómini sancto ejus in sǽculum, et in sǽculum sǽculi.
\c 145
\q1 \v 2 Lauda, ánima mea, Dóminum, † laudábo Dóminum in vita mea: * psallam Deo meo quámdiu fúero.
\q1 Nolíte confídere in princípibus: * (3) in fíliis hóminum, in quibus non est salus.
\q1 \v 4 Exíbit spíritus ejus, et revertétur in terram suam: * in illa die períbunt omnes cogitatiónes eórum.
\q1 \v 5 Beátus, cujus Deus Jacob adjútor ejus, † spes ejus in Dómino, Deo ipsíus: * (6) qui fecit cælum et terram, mare, et ómnia, quæ in eis sunt.
\q1 \v 7 Qui custódit veritátem in sǽculum, † facit judícium injúriam patiéntibus: * dat escam esuriéntibus.
\q1 Dóminus solvit compedítos: * (8a) Dóminus illúminat cæcos.
\q1 \v 8 Dóminus érigit elísos, * Dóminus díligit justos.
\q1 \v 9 Dóminus custódit ádvenas, † pupíllum et víduam suscípiet: * et vias peccatórum dispérdet.
\q1 \v 10 Regnábit Dóminus in sǽcula, Deus tuus, Sion, * in generatiónem et generatiónem.
\c 146
\q1 \v 1 Laudáte Dóminum quóniam bonus est psalmus: * Deo nostro sit jucúnda, decóraque laudátio.
\q1 \v 2 Ædíficans Jerúsalem Dóminus: * dispersiónes Israélis congregábit.
\q1 \v 3 Qui sanat contrítos corde: * et álligat contritiónes eórum.
\q1 \v 4 Qui númerat multitúdinem stellárum: * et ómnibus eis nómina vocat.
\q1 \v 5 Magnus Dóminus noster, et magna virtus ejus: * et sapiéntiæ ejus non est númerus.
\q1 \v 6 Suscípiens mansuétos Dóminus: * humílians autem peccatóres usque ad terram.
\q1 \v 7 Præcínite Dómino in confessióne: * psállite Deo nostro in cíthara.
\q1 \v 8 Qui óperit cælum núbibus: * et parat terræ plúviam.
\q1 Qui prodúcit in móntibus fænum: * et herbam servitúti hóminum.
\q1 \v 9 Qui dat juméntis escam ipsórum: * et pullis corvórum invocántibus eum.
\q1 \v 10 Non in fortitúdine equi voluntátem habébit: * nec in tíbiis viri beneplácitum erit ei.
\q1 \v 11 Beneplácitum est Dómino super timéntes eum: * et in eis, qui sperant super misericórdia ejus.
\c 147
\q1 \v 1 Lauda, Jerúsalem, Dóminum: * lauda Deum tuum, Sion.
\q1 \v 2 Quóniam confortávit seras portárum tuárum: * benedíxit fíliis tuis in te.
\q1 \v 3 Qui pósuit fines tuos pacem: * et ádipe fruménti sátiat te.
\q1 \v 4 Qui emíttit elóquium suum terræ: * velóciter currit sermo ejus.
\q1 \v 5 Qui dat nivem sicut lanam: * nébulam sicut cínerem spargit.
\q1 \v 6 Mittit crystállum suam sicut buccéllas: * ante fáciem frígoris ejus quis sustinébit?
\q1 \v 7 Emíttet verbum suum, et liquefáciet ea: * flabit spíritus ejus, et fluent aquæ.
\q1 \v 8 Qui annúntiat verbum suum Jacob: * justítias, et judícia sua Israël.
\q1 \v 9 Non fecit táliter omni natióni: * et judícia sua non manifestávit eis.
\c 148
\q1 \v 1 Laudáte Dóminum de cælis: * laudáte eum in excélsis.
\q1 \v 2 Laudáte eum, omnes Ángeli ejus: * laudáte eum, omnes virtútes ejus.
\q1 \v 3 Laudáte eum, sol et luna: * laudáte eum, omnes stellæ et lumen.
\q1 \v 4 Laudáte eum, cæli cælórum: * et aquæ omnes, quæ super cælos sunt, laudent nomen Dómini.
\q1 \v 5 Quia ipse dixit, et facta sunt: * ipse mandávit, et creáta sunt.
\q1 \v 6 Státuit ea in ætérnum, et in sǽculum sǽculi: * præcéptum pósuit, et non præteríbit.
\q1 \v 7 Laudáte Dóminum de terra, * dracónes, et omnes abýssi.
\q1 \v 8 Ignis, grando, nix, glácies, spíritus procellárum: * quæ fáciunt verbum ejus:
\q1 \v 9 Montes, et omnes colles: * ligna fructífera, et omnes cedri.
\q1 \v 10 Béstiæ, et univérsa pécora: * serpéntes, et vólucres pennátæ:
\q1 \v 11 Reges terræ, et omnes pópuli: * príncipes, et omnes júdices terræ.
\q1 \v 12 Júvenes, et vírgines: † senes cum junióribus laudent nomen Dómini: * (13) quia exaltátum est nomen ejus solíus.
\q1 \v 14 Conféssio ejus super cælum et terram: * et exaltávit cornu pópuli sui.
\q1 Hymnus ómnibus sanctis ejus: * fíliis Israël, pópulo appropinquánti sibi.
\c 149
\q1 \v 1 Cantáte Dómino cánticum novum: * laus ejus in ecclésia sanctórum.
\q1 \v 2 Lætétur Israël in eo, qui fecit eum: * et fílii Sion exsúltent in rege suo.
\q1 \v 3 Laudent nomen ejus in choro: * in týmpano, et psaltério psallant ei:
\q1 \v 4 Quia beneplácitum est Dómino in pópulo suo: * et exaltábit mansuétos in salútem.
\q1 \v 5 Exsultábunt sancti in glória: * lætabúntur in cubílibus suis.
\q1 \v 6 Exaltatiónes Dei in gútture eórum: * et gládii ancípites in mánibus eórum.
\q1 \v 7 Ad faciéndam vindíctam in natiónibus: * increpatiónes in pópulis.
\q1 \v 8 Ad alligándos reges eórum in compédibus: * et nóbiles eórum in mánicis férreis.
\q1 \v 9 Ut fáciant in eis judícium conscríptum: * glória hæc est ómnibus sanctis ejus.
\c 150
\q1 \v 1 Laudáte Dóminum in sanctis ejus: * laudáte eum in firmaménto virtútis ejus.
\q1 \v 2 Laudáte eum in virtútibus ejus: * laudáte eum secúndum multitúdinem magnitúdinis ejus.
\q1 \v 3 Laudáte eum in sono tubæ: * laudáte eum in psaltério, et cíthara.
\q1 \v 4 Laudáte eum in týmpano, et choro: * laudáte eum in chordis, et órgano.
\q1 \v 5 Laudáte eum in cýmbalis benesonántibus: † laudáte eum in cýmbalis jubilatiónis: * (6) omnis spíritus laudet Dóminum.
